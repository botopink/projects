---
// Front 53 — onze example app · examples/app/error.bpp
//
// The root error boundary of `boundaries-example.bp`, as a `.bpp` file. It
// unfolds to the module's anonymous `pub default fn` returning `View` (288, 289);
// the route table `rakun-app` generates makes it the root error boundary (285).
// `info: ErrorInfo` is in scope.
//
// `info` carries the DIGEST and not the message: the full error is logged on
// the server under that digest, and the browser is told only the reference. A
// user-facing error message is a leak.
//
// `data-jh-on-click` names a handler the client runtime binds after hydration;
// there is no JavaScript in this file.
//
// Upstream: https://nextjs.org/docs/app/api-reference/file-conventions/error

import {button, h2, p, section} from "jhonstart";
import {emilia, Token} from "emilia";

fn panelTokens() -> Token[] {
    return [.Pad.All.8, .Bg.Gray.100, .Border.Rounded.Md];
}
---
<section class={emilia(panelTokens())}>
  <h2>Something went wrong</h2>
  <p class="digest">Reference {info.digest}</p>
  <button data-jh-on-click="error:reset">Try again</button>
</section>
