---
// Front 116 — bpp file format · examples/page.bpp
// App file: src/app/blog/[slug]/page.bpp
//
// Demonstrates: a page. The toolchain unfolds the file onto jhonstart's `html`
// (decisions 198, 200): the header's declarations stay at module level — so
// `staticPaths` is what onze's scan and rakun's static generation read
// (front 117); the page declares no stage — `#[page]` prerenders it because it
// reaches no `#[serverOnly]` hook (decision 202) — and its statements become the body of the
// function the file unfolds to, ahead of `return html """…""";` (decision 199).
//
// What a `.bp` page writes by hand: `#[page("blog/[slug]")]` comes from the
// file's name through the route table built from its file name, or from a decorator on the header's
// last line (decision 285). Its `route: PageContext` parameter and the `params`
// bound from the bracket segment are open question `bpp-g` (README § Notes,
// point 1); `params.slug` below is written against that answer.
//
// Upstream: astro-docs/07-astro-pages.md · astro-docs/08-routing.md (Rotas
//           dinâmicas) — https://docs.astro.build/en/guides/routing/

import {h1, article, p} from "jhonstart";
import {notFound} from "jhonstart";
import {StaticPath, staticPath} from "onze";
import {layouts.BaseLayout};
import {components.PostCard};
import {lib.db.findPost, lib.db.listPosts, lib.db.missingPost};

pub fn staticPaths() -> @Task<Array<StaticPath>> {
    return listPosts().map({ post -> staticPath([#("slug", post.slug)]) });
}

val slug = params.slug;
val found = findPost(slug);
if (found.isEmpty()) { notFound(); }
val post = found.first().unwrapOr(missingPost(slug));
---
<BaseLayout title={post.title}>
  <article>
    <h1>{post.title}</h1>
    <p>{post.body}</p>
  </article>
  <PostCard post={post} featured>Back to the list</PostCard>
</BaseLayout>
