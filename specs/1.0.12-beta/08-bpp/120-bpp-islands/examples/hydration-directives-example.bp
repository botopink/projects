// Front 120 — bpp islands · examples/hydration-directives-example.bp
// App file: src/app/page.bp (+ components/like_button.bp, carousel.bp, mobile_nav.bp)
//
// Demonstrates: steps 1–3 — the five client directives. A component marked
// `#[client]` renders on the server like any other; a `client:` directive on
// its tag is what sends its code to the browser, and says when.
//
//   <InteractiveButton client:load />
//   <HeavyChart client:idle />
//   <InteractiveCounter client:visible />
//   <MobileNav client:media="(max-width: 50em)" />
//   <InteractiveModal client:only="svelte" />
//
// Upstream: astro-docs/12-framework-components.md (Hidratando componentes
//           interativos, Diretivas de hidratação disponíveis)
//           astro-docs/02-islands-architecture.md (Client Islands)
//           https://docs.astro.build/en/reference/directives-reference/#client-directives
//
// Target: both — the page is erlang, the components are both: their first
// render is on the server, and that is what is asserted here.

import html, {Element, ElementBase, Children, renderToString} from "jhonstart";
import {button, div, h1, nav, p, section, span} from "jhonstart";
import {client, clientProps, mountIslandWhen, Hydrate, islandRows} from "jhonstart";
import {state} from "jhonstart";

// ── three islands ───────────────────────────────────────────────────────────

#[clientProps]
pub type LikeButtonProps(postSlug: string, likes: i32)

#[client]
pub fn LikeButton(props: LikeButtonProps) -> @Component<ElementBase, Element> {
    val count = use state(props.likes);
    return html """
      <button data-jh-on-click="LikeButton:like" data-post={props.postSlug}>
        {count.value.toString()} likes
      </button>
    """;
}

#[clientProps]
pub type CarouselProps(images: i32)

#[client]
pub fn Carousel(props: CarouselProps) -> @Component<ElementBase, Element> {
    return html """<section class="carousel">{props.images.toString()} images</section>""";
}

#[clientProps]
pub type MobileNavProps(open: bool)

#[client]
pub fn MobileNav(props: MobileNavProps) -> @Component<ElementBase, Element> {
    return html """<nav class="mobile">menu</nav>""";
}

// ── the page ────────────────────────────────────────────────────────────────

pub fn Home(slug: string) -> @Component<ElementBase, Element> {
    return html """
      <h1>Post</h1>

      <!-- interactive as soon as the page loads -->
      <LikeButton postSlug={slug} likes={3} client:load />

      <!-- started when the browser is idle; after 500 ms where it never is -->
      <LikeButton postSlug={slug} likes={0} client:idle="500" />

      <!-- its code is not requested until it is about to scroll into view -->
      <Carousel images={12} client:visible="200px" />

      <!-- only on a narrow screen -->
      <MobileNav open={false} client:media="(max-width: 50em)" />

      <!-- never rendered on the server: the fallback is, and the browser renders the rest -->
      <Carousel images={3} client:only>
        <p slot="fallback">Loading the gallery…</p>
      </Carousel>

      <!-- no directive: server-rendered markup, no JavaScript sent for it -->
      <LikeButton postSlug={slug} likes={9} />
    """;
}

test "each directive becomes the island's strategy in the payload row" {
    val _markup = renderToString(await Home("hello"));
    val whens = islandRows().map({ row -> row[3] }).join(" | ");
    assert whens == "load | idle:500 | visible:200px | media:(max-width: 50em) | only";
}

test "a component with no client directive is not an island" {
    val markup = renderToString(await Home("hello"));
    assert islandRows().length == 5;
    assert markup.contains("9 likes");
}

test "every island but client:only is rendered on the server" {
    val markup = renderToString(await Home("hello"));
    assert markup.contains("3 likes");
    assert markup.contains("<section class=\"carousel\">12 images</section>");
    assert markup.contains("<nav class=\"mobile\">menu</nav>");
}

test "client:only renders its fallback and nothing of the component" {
    val markup = renderToString(await Home("hello"));
    assert markup.contains("<p>Loading the gallery…</p>");
    assert markup.contains("3 images") == false;
}

test "the directive form and the function form are the same mount" {
    val byHand = mountIslandWhen(
        "Carousel",
        encodeCarouselProps(CarouselProps(images: 12)),
        [],
        Hydrate.Visible(rootMargin: "200px"),
    );
    val byTag = html """<Carousel images={12} client:visible="200px" />""";
    assert renderToString(byHand) == renderToString(byTag);
}

// What does not build:
//
//   <div client:visible />
//     error: `client:visible` hydrates a component; `div` is an element
//
//   <Footer client:load />        Footer has no #[client]
//     error: `Footer` is not a #[client] component — it renders on the server only
//
//   <Carousel images={1} client:load client:idle />
//     error: one `client:` directive per component                 at `client:idle`
//
// The browser half — "not started before its trigger, started after it" — is
// `jhonstart-dom-test/test/strategy_dom_test.bp`, against a fake
// IntersectionObserver, matchMedia and requestIdleCallback.
