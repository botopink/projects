// Front 126 — bpp view transitions · examples/view-transitions-example.bp
// App files: src/layouts/base.bp · src/app/blog/page.bp · src/app/blog/[slug]/page.bp
//
// Demonstrates: the transition annotations (decision 278). `<ViewTransitions />` in
// the head turns the animation on; a `#[transition…]` annotation on a tag lowers to a
// data attribute the navigation runtime reads when it swaps the document.
//
//   <head><ClientRouter /></head>
//   <aside transition:name="hero">
//   <main transition:animate="slide">
//   <header transition:animate={fade({ duration: "0.4s" })}>
//   <video controls transition:persist>
//   <Counter client:load transition:persist initialCount={5} />
//   <a href="/articles/emperor-penguins" data-astro-reload>
//
//   — here: #[transitionName("hero")], #[transitionAnimate(.Slide)],
//     #[transitionAnimate(fade(duration: "0.4s"))], #[transitionPersist], <Counter #[clientLoad, transitionPersist] />
//
// Upstream: astro-docs/20-view-transitions.md
//           https://docs.astro.build/en/guides/view-transitions/
//
// Target: both — the markup is rendered on the server; the animation is the
// browser's, asserted against a `startViewTransition` double in
// `jhonstart-dom-test`.

import html, {Element, Node, renderToString} from "jhonstart";
import {a, article, body, h1, head, header, htmlTag, img, main, title, video} from "jhonstart";
import {ViewTransitions, fade, slide, TransitionAnimation} from "jhonstart-link";
import {transitionName, transitionAnimate, transitionPersist, reload, history} from "jhonstart-link";

// ── src/layouts/base.bp ─────────────────────────────────────────────────────

pub fn BaseLayout(pageTitle: string, children: Node = []) -> Element {
    return html """
      <htmlTag lang="en" #[transitionAnimate(.None)]>
        <head>
          <title>{pageTitle}</title>
          <ViewTransitions />
        </head>
        <body>
          <header #[transitionAnimate(fade(duration: "0.4s"))]>
            <a href="/blog">Blog</a>
            <!-- a full document load, on purpose -->
            <a href="/legacy" #[reload]>Legacy</a>
            <!-- replaces the history entry instead of adding one -->
            <a href="/blog?sort=new" #[history(.Replace)]>Newest</a>
          </header>

          <!-- keeps playing across navigations: the node is moved, not replaced -->
          <video controls muted #[transitionPersist("player")] src="/intro.mp4"></video>

          <main #[transitionAnimate(.Slide)]><slot /></main>
        </body>
      </htmlTag>
    """;
}

// ── src/app/blog/page.bp and src/app/blog/[slug]/page.bp ────────────────────

// The same `#[transitionName]` on both pages pairs the two elements: the browser
// morphs the list's thumbnail into the post's hero image.
pub fn ListItem(slug: string, heading: string) -> Element {
    return html """
      <article>
        <img src={"/covers/" + slug + ".png"} alt="" #[transitionName("cover-" + slug)] />
        <a href={"/blog/" + slug}>{heading}</a>
      </article>
    """;
}

pub fn PostHero(slug: string, heading: string) -> Element {
    return html """
      <img class="hero" src={"/covers/" + slug + ".png"} alt="" #[transitionName("cover-" + slug)] />
      <h1>{heading}</h1>
    """;
}

test "ViewTransitions writes the stylesheet and the flag" {
    val markup = renderToString(BaseLayout("Blog"));
    assert markup.contains("@keyframes jh-fade-in");
    assert markup.contains("@media (prefers-reduced-motion: reduce)");
}

test "a named transition is the same name on both pages" {
    val list = renderToString(ListItem("hello", "Hello"));
    val post = renderToString(PostHero("hello", "Hello"));
    assert list.contains("data-jh-vt-name=\"cover-hello\"");
    assert post.contains("data-jh-vt-name=\"cover-hello\"");
}

test "a built-in animation is an attribute; a customised one carries its values" {
    val markup = renderToString(BaseLayout("Blog"));
    assert markup.contains("<html lang=\"en\" data-jh-vt-animate=\"none\">");
    assert markup.contains("<main data-jh-vt-animate=\"slide\">");
    assert markup.contains("<header data-jh-vt-animate=\"fade\" style=\"--jh-vt-duration: 0.4s\">");
}

test "a persisted element is marked with its name" {
    val markup = renderToString(BaseLayout("Blog"));
    assert markup.contains("data-jh-vt-persist=\"player\"");
}

test "the per-link annotations lower to the runtime's attributes (292)" {
    val markup = renderToString(BaseLayout("Blog"));
    assert markup.contains("<a href=\"/legacy\" data-jh-reload>");
    assert markup.contains("data-jh-history=\"replace\"");
}

// What does not compile:
//
//   <main #[transitionAnimate(.Spin)]>
//     error: `Animate` has no variant `Spin` — Fade, Slide, None, Initial, or a
//            TransitionAnimation value                          at `.Spin`
//
// In the browser (`jhonstart-dom-test/test/transitions_dom_test.bp`):
//
//   click <a href="/blog/hello">    → startViewTransition called once; the events
//                                     onBeforePreparation, onAfterPreparation,
//                                     onBeforeSwap, onAfterSwap, onPageLoad
//                                     fire in that order
//   the <video> after the swap      → the same node as before it
//   a browser with no View Transition API → the swap happens, nothing is animated
