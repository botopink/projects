// Front 118 — bpp components · examples/directives-example.bp
//
// Demonstrates: step 5 — tag annotations, `raw` and `classList` (decision 278).
// Astro's `prefix:name` directives are not in the grammar. What Astro writes as
// a directive is either a VALUE — and then it is an ordinary attribute or hole —
// or an INSTRUCTION — and then it is an annotation inside the tag, a function
// resolved in the caller's scope that `html` calls at comptime and acts on by
// its return type.
//
//   Astro                                     here
//   <Fragment set:html={htmlString} />        {raw(htmlString)}
//   <article set:html={content} />            <article>{raw(content)}</article>
//   <p set:text={value} />                    <p>{value}</p>
//   <p class:list={["a", { b: on }]} />       <p class={classList(["a", classIf(on, "b")])} />
//   <code is:raw>…</code>                     <code #[isRaw]>…</code>
//
// Upstream: astro-docs/13-astro-syntax.md (Fragments, `set:html`)
//           astro-docs/11-styling.md (Combinando classes com `class:list`)
//           astro-docs/14-markdown-content.md (`<Fragment set:html={compiled} />`)
//           https://docs.astro.build/en/reference/directives-reference/
//
// Target: both.
//
// The annotations at the end of this track — who adds which return-type arm:
//
//   isRaw -> RawBody                                       118 (this front)
//   isGlobal, isInline, defineVars -> the style types      119
//   clientLoad|Idle|Visible|Media|Only -> Hydrate          120
//   serverDefer -> Defer                                   120
//   transitionName|Animate|Persist|PersistProps            126

import html, {classIf, classList, raw, View, renderToString} from "jhonstart";
import {article, div, p, pre, code, span} from "jhonstart";

// ── raw: Astro's set:html ───────────────────────────────────────────────────

// `raw(value)` trusts its value: the escape hatch the core already has
// (`render.bp:204`). It is a hole like any other — no directive needed.
pub fn Rendered(content: string) -> View {
    return html """<article>{raw(content)}</article>""";
}

// No wrapper element at all: the hole alone.
pub fn Inline(content: string) -> View {
    return html """{raw(content)}""";
}

// Astro's `set:text` is a `{value}` child: holes already escape.
pub fn Quoted(value: string) -> View {
    return html """<p>{value}</p>""";
}

// ── classList: Astro's class:list ───────────────────────────────────────────

// Astro takes strings, arrays and `{ name: bool }` objects. There is no object
// literal here: the list is an `Array<string>`, an empty string is dropped, and
// `classIf(cond, name)` answers the name or "".
pub fn Box(isRed: bool, extra: string) -> View {
    return html """
      <div class={classList(["box", classIf(isRed, "red"), extra])}>
        <slot />
      </div>
    """;
}

// ── #[isRaw]: Astro's is:raw ────────────────────────────────────────────────

// The body is text: no tag, no hole, no annotation is read inside it.
pub fn Snippet() -> View {
    return html """
      <pre><code #[isRaw]>{items.map({ x -> <li>{x}</li> })}</code></pre>
    """;
}

// ── an annotation that only checks ──────────────────────────────────────────

// Records nothing: `html` calls it and changes nothing. Any library may declare one.
// The same shape as a declaration's decorator (302): the tag is a `@Decl`.
pub fn mustBeBox(comptime decl: @Decl) {
    if (decl.name != "div") decl.fail("#[mustBeBox] goes on a <div>");
}

pub fn Checked() -> View {
    return html """<div #[mustBeBox] class="box"></div>""";
}

test "raw writes the value unescaped" {
    assert renderToString(Rendered("<p>raw</p>")) == "<article><p>raw</p></article>";
    assert renderToString(Inline("<p>raw</p>")) == "<p>raw</p>";
}

test "a hole escapes" {
    assert renderToString(Quoted("<b>")) == "<p>&lt;b&gt;</p>";
}

test "classList drops what is empty" {
    assert renderToString(Box(true, "")) == "<div class=\"box red\"></div>";
    assert renderToString(Box(false, "wide")) == "<div class=\"box wide\"></div>";
    assert renderToString(Box(false, "")) == "<div class=\"box\"></div>";
}

test "#[isRaw] keeps braces and angle brackets as text" {
    val markup = renderToString(Snippet());
    assert markup.contains("{items.map({ x -&gt; &lt;li&gt;{x}&lt;/li&gt; })}");
}

test "a void annotation renders nothing of its own" {
    assert renderToString(Checked()) == "<div class=\"box\"></div>";
}

// What does not compile:
//
//   <div #[fooBar] />
//     error: unbound name `fooBar`                                 at `fooBar`
//
//   <div set:html={s} />
//     error: no `prefix:name` directives — write {raw(s)} as the child
//                                                                  at `set:html`
//
//   <code #[isRaw, isRaw]>…</code>
//     error: two `RawBody` annotations on one tag                  at the second
//
//   <div #[clientVisible] />
//     error: `clientVisible` annotates a component; `div` is an element
//            (its first parameter is `@Decl` — front 120)          at the annotation
