---
// Front 118 — bpp components · examples/src/components/Wrapper.bpp
//
// Demonstrates: step 4 in a `.bpp` component — slots. A slot is a field of
// `Props` of type `Node`: `children` is the default slot, any other
// `Node` field is the named slot of its name, and what a `<slot>` tag wraps
// is its fallback.
//
//   <div id="content-wrapper">
//     <Header />
//     <slot name="after-header" />
//     <slot />
//     <slot name="after-footer"><p>fallback</p></slot>
//   </div>
//
// `hasContent(afterHeader)` is `Astro.slots.has("after-header")`: a slot is a
// value, so asking whether it was filled is asking a value.
//
// The `.bp` form, with its tests: `Wrapper` in `components-and-slots-example.bp`.
//
// Upstream: astro-docs/09-astro-components.md (Slots, Slots Nomeados, Conteúdo
//           de Fallback para Slots) — https://docs.astro.build/en/basics/astro-components/#slots

import {aside, div, footer, h1, header, small} from "jhonstart";
import {hasContent} from "jhonstart";

type Props(
    heading: string,
    children: Node = [],
    afterHeader: Node = [],
    afterFooter: Node = [],
)
---
<div id="content-wrapper">
  <header><h1>{heading}</h1></header>
  <slot name="afterHeader" />
  <slot />
  <footer>
    <slot name="afterFooter"><small>no footer given</small></slot>
  </footer>
  {if (hasContent(afterHeader)) { <aside>this page has a sub-header</aside> }}
</div>
