// Front 125 — validation: Zod's feature set · examples/nested-and-arrays-example.bp
//
// Demonstrates: step 2 — nested records, arrays, and a type that names itself.
// A field whose type is another `#[validated]` type is decoded by calling
// `ThatType.parseAt` BY NAME, so the decorator never needs to see a second
// declaration; a violation inside it carries the whole path.
//
//   const Address = z.object({ street: z.string(), zip: z.string() });
//   const Order   = z.object({ id: z.string(), ship: Address, lines: z.array(Line) });
//   const Category = z.object({ name: z.string(), get subcategories() { return z.array(Category) } });
//
// Upstream: ZOD_DOCUMENTATION.md §§ 4.17 (Objects), 4.18 (Recursive Objects),
//           4.19 (Arrays) — https://zod.dev/api#objects
//
// Target: both.

import {decorators.validated} from "validation";
import {derived} from "validation";
import {report.ValidationReport, report.Violation} from "validation";
import {json.Json} from "std";
import {table.constraintTableJson} from "validation";

#[validated]
pub type Address(
    street: string,
    zip: string,
)

#[validated]
pub type Line(
    sku: string,
    quantity: i32,
)

#[validated]
pub type Order(
    id: string,
    ship: Address,
    lines: Array<Line>,
    note: ?string,
)

// Zod needs a getter to let a schema mention itself. Here the field's type is
// the record's own name and `Category.parseAt` calls itself.
#[validated]
pub type Category(
    name: string,
    subcategories: Array<Category>,
)

fn located(r: @Result<Order, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

test "validation: a nested document becomes nested records" {
    val order = try Order.decode(
        """{"id": "o1", "ship": {"street": "Rua A", "zip": "01310-100"},
            "lines": [{"sku": "x", "quantity": 2}]}""",
    );
    assert order.ship.zip == "01310-100";
    assert order.lines.length == 1;
    assert order.note == null;
}

test "validation: a violation names the path to the value, not the leaf alone" {
    val r = Order.decode(
        """{"id": "o1", "ship": {"street": "Rua A"},
            "lines": [{"sku": "x", "quantity": 2}, {"sku": 7, "quantity": "two"}]}""",
    );
    assert located(r)
        == "ship.zip:required,lines[1].sku:invalidType,lines[1].quantity:invalidType";
}

test "validation: an array field refuses a value that is not an array" {
    val r = Order.decode(
        """{"id": "o1", "ship": {"street": "a", "zip": "b"}, "lines": {}}""",
    );
    assert located(r) == "lines:invalidType";
}

test "validation: a recursive type decodes to any depth" {
    val tree = try Category.decode(
        """{"name": "root", "subcategories": [
              {"name": "a", "subcategories": [{"name": "a1", "subcategories": []}]},
              {"name": "b", "subcategories": []}]}""",
    );
    assert tree.subcategories.length == 2;
    assert tree.subcategories.at(0).unwrapOr(tree).subcategories.length == 1;
}
