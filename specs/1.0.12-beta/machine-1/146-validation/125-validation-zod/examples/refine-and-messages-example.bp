// Front 125 — validation: Zod's feature set · examples/refine-and-messages-example.bp
//
// Demonstrates: step 7 — the messages a check reports.
//
//   z.string().min(8, "Too short!")              // a check-level message
//   z.string("Not a string!")                    // a schema-level message
//   schema.parse(x, { error: iss => "…" })       // a per-parse message
//   z.config({ customError })                    // a global one
//
// Not here yet — a type-level rule takes the rule, the field it reports at, a
// message and a code as typed decorator arguments (decision 280, example 1),
// which `01-checker` step 24 brings:
//
//   #[validated]
//   #[check("Passwords don't match", passwordsMatch, at: .confirm, code: .Custom)]
//   pub type Account(…)
//
//   fn passwordsMatch(a: Account) -> bool { return a.password == a.confirm; }
//
// Upstream: ZOD_DOCUMENTATION.md §§ 4.31 (Refinements), 5 (Personalizando Erros)
//           — https://zod.dev/api#refinements · https://zod.dev/error-customization
//
// Target: both.

import {decorators.validated, decorators.minLength, decorators.message, decorators.typeMessage, decorators.stopOnFirst, decorators.lowercase} from "validation";
import {derived} from "validation";
import {report.ValidationReport, report.Violation} from "validation";
import {constraints.vMinLength, constraints.vLowercase, table.constraintTableJson} from "validation";
import {messages.MessageSource, messages.setMessageSource, messages.builtInOnly, messages.underSource} from "validation";
import {json, json.Json} from "std";

#[validated]
pub type Account(
    #[typeMessage("a handle is text")] handle: string,
    // Zod's `abort: true` — the second check is skipped when the first fails.
    #[stopOnFirst] #[minLength(8)] #[message("Too short!")] #[lowercase] #[message("Must be lowercase")] password: string,
    confirm: string,
)

fn messagesOf(r: @Result<Account, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ": " + v.message })
            .join(" | ");
    };
}

test "validation: a check-level message replaces the built-in one" {
    val _s = setMessageSource(builtInOnly());
    val r = Account.decode(
        """{"handle": "ana", "password": "short", "confirm": "short"}""",
    );
    assert messagesOf(r) == "password: Too short!";
}

test "validation: #[stopOnFirst] skips the checks after the first failure" {
    // "SHORT" fails both minLength and lowercase; only the first is reported.
    val r = Account.decode(
        """{"handle": "ana", "password": "SHORT", "confirm": "SHORT"}""",
    );
    assert messagesOf(r) == "password: Too short!";
    val long = Account.decode(
        """{"handle": "ana", "password": "LONG-ENOUGH", "confirm": "x"}""",
    );
    assert messagesOf(long) == "password: Must be lowercase";
}

test "validation: a schema-level message restates the wrong-type case" {
    val r = Account.decode(
        """{"handle": 7, "password": "correct-horse", "confirm": "correct-horse"}""",
    );
    assert messagesOf(r) == "handle: a handle is text";
}

test "validation: a per-parse source sits under the field's own message and over the global one" {
    val _s = setMessageSource(builtInOnly());
    val portuguese = MessageSource(
        locale: { -> "" },
        template: { key -> if (key == "required") "é obrigatório" else "" },
    );
    val doc = try json.decode("""{"handle": "ana", "password": "short"}""");
    val r = underSource(portuguese, { -> Account.parse(doc) });
    assert messagesOf(r) == "confirm: é obrigatório";
    val short = try json.decode(
        """{"handle": "ana", "password": "short", "confirm": "x"}""",
    );
    assert messagesOf(underSource(portuguese, { -> Account.parse(short) }))
        == "password: Too short!";
    // The source was for that call only.
    assert messagesOf(
        Account.decode("""{"handle": "ana", "password": "correct-horse"}"""),
    )
        == "confirm: must be present";
}
