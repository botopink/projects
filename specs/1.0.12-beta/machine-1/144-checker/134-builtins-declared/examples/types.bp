// Front 134 — builtins declared · examples/types.bp
//
// Demonstrates: std's `Type` (decisions 307, 308, 598, 599) — the derived-type functions
// and the build-time field, with every signature and what each call produces.
//
// Target file: `libs/std/src/types.bp`, exported by std's `root.bp` as `types`.
// Everything here runs at compile time. The bodies are botopink over `compiler.*`
// (599 (3)): `compiler.fields(T)` reads, `compiler.buildType` builds; no function is a
// bodyless `declare fn` (575 (6)).
//
// OPEN (this front, with `01-checker` step 28): the spelling of a type that only
// holds static members (`pub type Type { … }` with no case) and of a `type`
// answer (`-> type`).

// ── libs/std/src/types.bp ───────────────────────────────────────────────────

pub type Type {

    // A field of `T`'s declaration, a build-time value (599): nobody declares
    // them, and none exists at run time. `.title` is the shorthand where a
    // `Type.Field<T>` is expected in a decorator's argument, resolved against `T`.
    pub type Field<T>(
        name: string,                             // "title"
        type: anytype,                            // the field's type
        annotations: DeclAnnotation[],            // the field's markers
        defaultValue: ?anyvalue,                  // the default as written, null when none (598)
    )

    // The type functions — compile time only, every parameter `comptime`.
    pub fn partial<T>(comptime source: type<T>) -> anytype { … }     // every field F → ?F
    pub fn required<T>(comptime source: type<T>) -> anytype { … }    // every field ?F → F
    pub fn pick<T>(comptime source: type<T>, comptime ..fields: Type.Field<T>[]) -> anytype { … }
    pub fn omit<T>(comptime source: type<T>, comptime ..fields: Type.Field<T>[]) -> anytype { … }
    pub fn merge<A, B>(comptime first: type<A>, comptime second: type<B>) -> anytype { … }
}

// ── an application module ───────────────────────────────────────────────────

import {types.Type} from "std";
import {decorators.validated, decorators.minLength} from "validation";

#[validated]
pub type Recipe(
    #[minLength(1)] title: string,
    description: ?string,
    ingredients: Array<string>,
)

#[validated] pub type Dog(name: string, age: ?i32)
#[validated] pub type Breed(breed: string)

// Each result is a NEW nominal record named after its `val`, usable in every
// type position, exported and imported like any type; the source fields'
// markers come with them; a decorator on the `val` sees a type declaration.

#[validated] pub val RecipePatch = Type.partial(Recipe);
//   type RecipePatch(#[minLength(1)] title: ?string, description: ?string, ingredients: ?Array<string>)

#[validated] pub val RecipeFull = Type.required(RecipePatch);
//   type RecipeFull(#[minLength(1)] title: string, description: string, ingredients: Array<string>)
//   — every `?` goes, `description` included: `required` does not know what
//     was optional in `Recipe`

#[validated] pub val RecipeTitle = Type.pick(Recipe, .title);
//   type RecipeTitle(#[minLength(1)] title: string)

#[validated] pub val RecipeBrief = Type.omit(Recipe, .description);
//   type RecipeBrief(#[minLength(1)] title: string, ingredients: Array<string>)

#[validated] pub val DogWithBreed = Type.merge(Dog, Breed);
//   type DogWithBreed(name: string, age: ?i32, breed: string)

// ── the key at run time ─────────────────────────────────────────────────────

// Removed by decision 599: no `Type.keys`, `Field.of` or `Field.all`, no run-time field key.

// A PATCH applies only what the client sent.
pub fn applyPatch(recipe: Recipe, patch: RecipePatch) -> Recipe {
    return Recipe(
        ..recipe,
        title: patch.title ?? recipe.title,
        description: patch.description ?? recipe.description,
        ingredients: patch.ingredients ?? recipe.ingredients,
    );
}

test "a derived type is a type: constructed, passed, matched" {
    val t = RecipeTitle(title: "Feijoada");
    val brief = RecipeBrief(title: "Feijoada", ingredients: ["feijão"]);
    val dog = DogWithBreed(name: "Rex", age: null, breed: "vira-lata");
    assert t.title == brief.title;
    assert dog.breed == "vira-lata";
}

test "a patch changes what it names and nothing else" {
    val before = Recipe(title: "Feijoada", description: null, ingredients: ["feijão"]);
    val after = applyPatch(before, RecipePatch(title: "Feijoada completa", description: null, ingredients: null));
    assert after.title == "Feijoada completa";
    assert after.ingredients == ["feijão"];
}

// ── in a decorator and in reflection ────────────────────────────────────────

// pub fn unique<T>(expr decl: T, comptime field: Type.Field<T>) { … }
// pub fn index<T>(expr decl: T, comptime ..fields: Type.Field<T>[]) { … }
// pub fn check<T>(expr decl: T, comptime rule: ?fn(v: T) -> bool = null,
//                 comptime at: ?Type.Field<T> = null, …) { … }
//
// `compiler.fields(T)` answers `Type.Field<T>[]` (575 (3)); a decorator over an
// `expr decl: unknown` reads `Type.Field<unknown>[]`.

// ── does not compile (one `reject/` cell each, `01-checker` step 28) ─────────

// Type.pick(Recipe, "title")                 — a string where a field goes: write `.title`
// Type.pick(Recipe, .titel)                  — `Recipe` has no field `titel`
// Type.pick(Recipe, .breed)                  — `Recipe` has no field `breed`
// Type.pick(Recipe) / Type.omit(Recipe)      — at least one field
// Type.pick(Recipe, .title, .title)          — field repeated
// Type.omit(Recipe, .title, .description, .ingredients)
//                                            — leaves an empty record
// Type.partial(i32) / Type.partial(Fish)     — needs a record (`Fish` is an enum)
// Type.merge(Dog, Dog)                       — a field on both sides (`name`, `age`):
//                                              `omit` it first; nothing overrides silently
// val P = Type.partial(Recipe);  (in a fn)   — only a module-level `val`
// partial(Recipe)                            — unbound name: it is `Type.partial`
