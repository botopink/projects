// Front 119 — bpp styling · examples/src/components/Box.bpp
//
// Demonstrates: step 2 in a `.bpp` component — the style section (decision
// 338), between the header and the markup. `jhonstart-styled` (the package
// `"bpp".style` names) scopes it; the template gives every element IT writes
// the scope attribute; the slotted content was written by the caller and
// carries none.
//
//   ---
//   const { isRed } = Astro.props;
//   const foregroundColor = "rgb(221 243 228)";
//   ---
//   <div class:list={['box', { red: isRed }]}><slot /></div>
//   <style define:vars={{ foregroundColor }}>
//     .box { border: 1px solid blue; color: var(--foregroundColor); }
//     .red { border-color: red; }
//   </style>
//
// Astro's `define:vars` is a hole here: `${foregroundColor}` is a value of the
// header; known only at render, it becomes a CSS variable — the rule reads
// `var(--s-0)` and the root element gets `style="--s-0: rgb(221 243 228)"`.
//
// The `.bp` form, with its tests: `Box` in `scoped-style-example.bp` at the
// root of `examples/`.
//
// Upstream: astro-docs/11-styling.md (Estilos com Escopo, Variáveis CSS)
//           https://docs.astro.build/en/guides/styling/#scoped-styles

import {div} from "jhonstart";
import {classIf, classList} from "jhonstart";

type Props(
    isRed: bool,
    children: Node,
)

val foregroundColor = "rgb(221 243 228)";
--- style ---
.box { border: 1px solid blue; color: ${foregroundColor}; }
.red { border-color: red; }
---
<div class={classList(["box", classIf(props.isRed, "red")])}>
  {props.children}
</div>
