// Front 118 — bpp components · examples/template-expressions-example.bp
//
// Demonstrates: steps 1–3 — attributes that render, holes of any renderable
// type, and markup inside `if`, `case` and a lambda. This is the template half
// of an Astro component, written in a `.bp` module: the function body is the
// "component script", the `html` literal is the "component template".
//
//   ---
//   const items = ["Dog", "Cat", "Platypus"];
//   const visible = true;
//   ---
//   <ul>{items.map((item) => <li>{item}</li>)}</ul>
//   {visible && <p>Show me!</p>}
//   {visible ? <p>Show me!</p> : <p>Else show me!</p>}
//
// Upstream: astro-docs/13-astro-syntax.md (Expressões tipo JSX, HTML Dinâmico,
//           Fragments, Diferenças entre Astro e JSX)
//           https://docs.astro.build/en/reference/astro-syntax/
//
// Target: both — the template expands at compile time to builder calls, which
// render on the BEAM and re-render in an island.

import html, {Element, renderToString} from "jhonstart";
import {a, div, h1, li, p, span, ul, em, br, img} from "jhonstart";

type Status { Draft, Live }

// ── variables and dynamic attributes ────────────────────────────────────────

pub fn Greeting(name: string, href: string, external: bool) -> Element {
    // `name="text"`, `name={expr}`, a bare name, kebab-case — all four render.
    // `[name]={expr}` — the only form that rendered before this front — is gone.
    return html """
      <div class="greeting" data-kind="hello">
        <h1>Hello {name}!</h1>
        <a href={href} target={if (external) { "_blank" } else { "_self" }} hidden={name == ""}>
          two words work: <span title="more than one word">hover</span>
        </a>
      </div>
    """;
}

// ── dynamic HTML ────────────────────────────────────────────────────────────

pub fn Menu(items: Array<string>, visible: bool, status: Status) -> Element {
    return html """
      <ul>
        {items.map({ item -> <li>{item}</li> })}
      </ul>
      {if (visible) { <p>Show me!</p> }}
      {if (visible) { <p>Show me!</p> } else { <p>Else show me!</p> }}
      {case status { Draft -> <em>draft</em>; Live -> <span>live</span>; }}
    """;
}

// ── what a hole may hold ────────────────────────────────────────────────────

pub fn Counter(count: i32, label: ?string, extra: Element) -> Element {
    // A hole holds a `Node`: a string, a number or a bool (their text), an
    // `Element`, or a list of them. An optional renders through `if (x) { v -> … }`.
    return html """
      <p>
        {count.toString()} items
        {if (label) { text -> <span>{text}</span> }}
        {extra}
        <br/>
        <img src="/dot.png" alt="" />
      </p>
    """;
}

// ── fragments, comments, several roots ──────────────────────────────────────

pub fn Pair(left: string, right: string) -> Element {
    return html """
      <!-- an HTML comment is rendered -->
      <>
        <p>{left}</p>
        <p>{right}</p>
      </>
    """;
}

test "a static attribute reaches the rendered tree" {
    val markup = renderToString(Greeting("Astro", "/about", false));
    assert markup.contains("<div class=\"greeting\" data-kind=\"hello\">");
    assert markup.contains("title=\"more than one word\"");
}

test "an expression attribute is escaped, and a false bool attribute is absent" {
    val markup = renderToString(Greeting("Astro", "/a?b=1&c=2", true));
    assert markup.contains("href=\"/a?b=1&amp;c=2\"");
    assert markup.contains("target=\"_blank\"");
    assert markup.contains("hidden") == false;
}

test "a list maps to elements, in order" {
    val markup = renderToString(Menu(["Dog", "Cat", "Platypus"], true, Status.Draft));
    assert markup.contains("<ul><li>Dog</li><li>Cat</li><li>Platypus</li></ul>");
}

test "an if without else renders nothing when false" {
    val markup = renderToString(Menu([], false, Status.Live));
    assert markup.contains("Show me!") == false;
    assert markup.contains("<p>Else show me!</p>");
    assert markup.contains("<span>live</span>");
}

test "text in a hole is escaped; an Element in a hole is not" {
    val extra = html """<em>new</em>""";
    val markup = renderToString(Counter(3, "<b>", extra));
    assert markup.contains("3 items");
    assert markup.contains("<span>&lt;b&gt;</span>");
    assert markup.contains("<em>new</em>");
}

test "a void tag stays where it was written" {
    val markup = renderToString(Counter(0, null, html """<em>x</em>"""));
    assert markup.contains("<br><img src=\"/dot.png\" alt=\"\"></p>");
}

test "several roots and a fragment need no wrapper element" {
    val markup = renderToString(Pair("a", "b"));
    assert markup == "<!-- an HTML comment is rendered --><p>a</p><p>b</p>";
}

// What does not compile, and where the error lands:
//
//   html """<p>{subtitle}</p>"""         subtitle: ?string
//     error: type mismatch: expected string | i32 | i64 | f32 | f64 | bool | Element | Element[], got ?string
//
//   html """<p>{1 + <b>x</b>}</p>"""
//     error: markup may begin a lambda body, an `if` / `else` block or a `case`
//            arm — not an operand                               at the `<`
//
//   html """<div [class]={c}></div>"""
//     error: `[class]={…}` is written `class={…}`               at the attribute
