// Front 118 — bpp components · examples/src/components/Box.bpp
//
// Demonstrates: step 5 in a `.bpp` component (decision 278). `classList` drops
// what is empty; a `{value}` hole escapes (Astro's `set:text`); `#[isRaw]` keeps
// its body as text; `{raw(…)}` writes its value unescaped (Astro's `set:html`).
//
//   <div class={classList(["box", classIf(isRed, "red")])}><slot /></div>
//   <article>{raw(content)}</article>
//
// There is no object literal: the list is an `Array<string>`, and
// `classIf(cond, name)` answers the name or "".
//
// The `.bp` form, with its tests: `Box`, `Quoted`, `Snippet` and `Rendered` in
// `directives-example.bp` at the root of `examples/`.
//
// Upstream: astro-docs/11-styling.md (Combinando classes com `class:list`)
//           astro-docs/13-astro-syntax.md (`set:html`)
//           https://docs.astro.build/en/reference/directives-reference/

import {article, code, div, p, pre} from "jhonstart";
import {classIf, classList, raw} from "jhonstart";

type Props(
    isRed: bool,
    caption: string,
    trusted: string = "",
    extra: string = "",
    children: Node = [],
)
---
<div class={classList(["box", classIf(isRed, "red"), extra])}>
  <p>{caption}</p>
  <slot />
  <article>{raw(trusted)}</article>
  <pre><code #[isRaw]>{items.map({ x -> <li>{x}</li> })}</code></pre>
</div>
