// Front 125 — validation: Zod's feature set · examples/signup-schema-example.bp
//
// Demonstrates: steps 2 and 12 — the type is the schema. `#[validated]` on a
// record gives it `Signup.parse` (Zod's `.parse` / `.safeParse`) and
// `Signup.decode` (JSON text in) beside its checks (decisions 306, 327). There
// is no second declaration to keep in step with the type, no schema value, and
// nothing to infer: `z.infer<typeof Signup>` is `Signup`.
//
//   const Signup = z.object({ username: z.string(), xp: z.number(), bio: z.string().optional() });
//   type Signup = z.infer<typeof Signup>;
//   Signup.parse(input);        // throws ZodError
//   Signup.safeParse(input);    // { success, data } | { success, error }
//
// Upstream: ZOD_DOCUMENTATION.md § 3 (Uso Básico) — https://zod.dev/basics
//
// Target: both. The same source decodes the request body on the BEAM and the
// form state in the browser, and `test/parity_test.bp` holds the two to one
// digest.

import {decorators.validated} from "validation";
import {derived} from "validation";
import {report.ValidationReport, report.Violation} from "validation";
import {json, json.Json} from "std";
import {table.constraintTableJson} from "validation";

#[validated]
pub type Signup(
    username: string,
    xp: i32,
    bio: ?string,
)

// What the decorator adds to `Signup`, written out. Nothing below this comment
// is typed by the application:
//
//   pub fn parse(input: Json) -> @Result<Signup, ValidationReport>
//   pub fn parseAt(input: Json, at: string) -> @Result<Signup, ValidationReport>
//   pub fn decode(text: string) -> @Result<Signup, ValidationReport>
//   pub fn bind(pairs: Array<#(string, string)>) -> @Result<Signup, ValidationReport>
//   pub fn encode(v: Signup) -> @Result<Json, ValidationReport>
//   pub fn jsonSchema() -> string

// `.parse` — in a function that can fail, `try` hands the report up.
pub fn register(body: string) -> @Result<string, ValidationReport> {
    val signup = try Signup.decode(body);
    return "welcome, " + signup.username;
}

// `.safeParse` — the `@Result` itself, read on the spot.
pub fn describe(body: string) -> string {
    return case Signup.decode(body) {
        Ok(signup) -> signup.username + " has " + signup.xp.toString() + " xp";
        Error(report) -> report.violations.length.toString() + " problem(s)";
    };
}

fn located(r: @Result<Signup, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

test "validation: a well-formed document becomes a typed record" {
    val signup = try Signup.decode("""{"username": "billie", "xp": 100}""");
    assert signup.username == "billie";
    assert signup.xp == 100;
    assert signup.bio == null;
}

test "validation: every wrong field is reported, in declaration order" {
    // Zod's own example: `{ username: 42, xp: "100" }` — two `invalid_type` issues.
    val r = Signup.decode("""{"username": 42, "xp": "100"}""");
    assert located(r) == "username:invalidType,xp:invalidType";
}

test "validation: a missing key is required, a missing optional key is null" {
    assert located(Signup.decode("""{"xp": 1}""")) == "username:required";
}

test "validation: an i32 field refuses a fraction and a value outside the range" {
    assert located(Signup.decode("""{"username": "a", "xp": 1.5}"""))
        == "xp:invalidType";
    assert located(Signup.decode("""{"username": "a", "xp": 3000000000}"""))
        == "xp:invalidType";
}

test "validation: text that is not JSON is one violation, at the root" {
    assert located(Signup.decode("{nope")) == ":invalidJson";
}

test "validation: accepts() answers a bool and builds no report" {
    val ok = try json.decode("""{"username": "billie", "xp": 100}""");
    val bad = try json.decode("""{"username": 42}""");
    assert Signup.parse(ok).isOk();
    assert Signup.parse(bad).isError();
}

test "validation: try propagates the report out of a fallible function" {
    assert register("""{"username": "billie", "xp": 1}""").isOk();
    assert register("""{"xp": 1}""").isError();
}
