// Front 53 — onze example app · examples/app/loading.bpp
//
// The root loading UI of `boundaries-example.bp`, as a `.bpp` file. It unfolds
// to the module's anonymous `pub default fn () -> View` (288, 289), which the
// generated route table imports by path and names itself (285). It takes no
// argument, so the fence has nothing in scope but what it declares; here it
// declares nothing.
//
// The skeleton is deliberately the same shape as the content it replaces, so
// the swap does not move the page.
//
// Upstream: https://nextjs.org/docs/app/api-reference/file-conventions/loading

import {div, span} from "jhonstart";
---
<div class="skeleton">
  <span class="skeleton-line"></span>
  <span class="skeleton-line"></span>
</div>
