// Front 126 — bpp view transitions · examples/src/components/PostHero.bpp
//
// Demonstrates: `#[transitionName]` (Astro's `transition:name`, 278) in a `.bpp` component — the other half of the
// pair `list_item.bpp` opens. Two roots, no wrapper element.
//
// The `.bp` form, with its tests: `PostHero` in `view-transitions-example.bp`.
//
// Upstream: astro-docs/20-view-transitions.md (Nomeando uma transição)

import {h1, img} from "jhonstart";
import {transitionName} from "jhonstart-link";

type Props(
    slug: string,
    heading: string,
)

val cover = "/covers/" + slug + ".png";
val pair = "cover-" + slug;
---
<img class="hero" src={cover} alt="" #[transitionName(pair)] />
<h1>{heading}</h1>
