// Front 53 — onze example app · examples/app/(marketing)/about/page.bpp
//
// The route-group page of `app-tree-example.bp`, as a `.bpp` file. The route
// is this file's directory, `(marketing)/about`, read by the route table
// `rakun-app` generates (285); the group is transparent to the URL, so the page answers
// `/about`, not `/marketing/about`.
//
// A page that needs no data has an empty fence but for its imports: it awaits
// nothing and costs nothing.
//
// Upstream: https://nextjs.org/docs/app/api-reference/file-conventions/route-groups

import {div, h1, p} from "jhonstart";
---
<div>
  <h1>About</h1>
  <p>Rendered on BEAM, like every page in this tree.</p>
</div>
