---
// Front 26 — jhonstart-router · examples/src/app/blog/[slug]/page.bpp
//
// The `/blog/[slug]` page of `blog-post-page-example.bp`, as a `.bpp` file
// (1.0.11-beta `08-bpp/116`): the application's manifest says
// `"bpp": "jhonstart"`, and this file unfolds to the module's anonymous
// `pub default fn () -> View` around the statements below, with the markup as
// its return (275, 289) — no parameter (293); the route table calls
// `page("blog/[slug]", f)` on it (285).
//
// What does not change: everything here runs on the BEAM, once, while the
// request is in flight. The two awaits are sequential on purpose — the comments
// cannot be loaded until the post's id is known — and nothing ships to the
// browser but HTML.
//
// What does: the tree is written as markup. A `{…}` hole holding a `string` is
// escaped by the template, so the `escape.html` calls of the `.bp` form — where
// `text(value)` is written out as it is — are gone, and a comment body that
// looks like markup is still text.
//
// `use params<BlogParams>()` reads the bracket segment as a record (293;
// `#[page]` checks its fields against the pattern); `loadPost` and
// `loadComments` are the loaders of the `.bp` form, in a module of their own.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/fetching-data
//   https://nextjs.org/docs/app/api-reference/file-conventions/page

import {article, h1, h2, li, p, section, span, ul} from "jhonstart";
import {params} from "jhonstart";
import {lib.blog.loadPost, lib.blog.loadComments};

type BlogParams(slug: string)

val route = use params<BlogParams>();
val post = await loadPost(route.slug);
val comments = await loadComments(post.id);
---
<article class="post">
  <h1>{post.title}</h1>
  <p class="body">{post.body}</p>
  <section>
    <h2>{comments.length.toString()} comments</h2>
    <ul class="comments">
      {comments.map({ c ->
        <li class="comment">
          <span class="author">{c.author}</span>
          <p>{c.body}</p>
        </li>
      })}
    </ul>
  </section>
</article>
