// Front 27 — jhonstart-link · examples/src/components/nav_progress.bp
//
// The progress bar of `app/blog/page.bpp`: the one `#[client]` island of the
// page, and the only place `use linkStatus()` is read (decision 363). An
// island is a `.bp` function — a decorator sits on a function, not on a
// `.bpp` file — placed by the page with `<NavProgress #[clientOnly] />`.
// The return type keeps the base until front 134 step 6 drops it.

import {Element, client, div} from "jhonstart";
import {linkStatus} from "jhonstart-link";

#[client]
pub fn NavProgress() -> @Component<Element> {
    val s = use linkStatus();
    val state = if (s.pending) "busy" else "idle";
    return div([], attrs: [#("class", "nav-progress"), #("data-state", state)]);
}
