//// F04 — Web Middleware, CORS & Error Handling
////
//// Este exemplo demonstra middleware chain, CORS support, e error handling com RFC 9457.
////
//// Documentação Spring Boot:
//// - Filters: https://docs.spring.io/spring-boot/reference/web/servlet.html#web.servlet.embedded-container.servlets-filters-listeners
//// - CORS: https://docs.spring.io/spring-boot/reference/web/servlet.html#web.servlet.cors
//// - Error Handling: https://docs.spring.io/spring-boot/reference/web/servlet.html#web.servlet.spring-mvc.error-handling
//// - RFC 9457 Problem Details: https://docs.spring.io/spring-boot/reference/web/servlet.html#web.servlet.spring-mvc.error-handling.problem-details

import {Rakun, App, Request, Response} from "rakun";
import {service, restController, route, getMapping, postMapping, filter, order, crossOrigin, controllerAdvice, exceptionHandler} from "rakun";
import {FilterChain, ProblemDetail} from "rakun-web";

// ── Middleware: Logging Filter ───────────────────────────────────────────────
#[filter]
#[order(-100)]  // Early in chain
pub type LoggingFilter {
    pub fn doFilter(self: Self, request: Request, response: Response, chain: FilterChain) -> Response {
        val start = time.nowMillis();
        print("→ " + request.method + " " + request.path);

        val result = chain.doFilter(request);

        val duration = time.nowMillis() - start;
        print("← " + result.status + " (" + duration.toString() + "ms)");
        return result;
    }
}

// ── Middleware: Request ID Filter ────────────────────────────────────────────
#[filter]
#[order(-200)]  // Even earlier
pub type RequestIdFilter {
    pub fn doFilter(self: Self, request: Request, response: Response, chain: FilterChain) -> Response {
        var requestId = request.header("X-Request-Id");
        if (requestId == "") {
            requestId = generateUuid();
        }
        // Add to request context (available to handlers)
        val enrichedRequest = request.withHeader("X-Request-Id", requestId);
        val result = chain.doFilter(enrichedRequest);
        return result.withHeader("X-Request-Id", requestId);
    }
}

// ── Middleware: Authentication Filter ────────────────────────────────────────
#[filter]
#[order(-50)]
pub type AuthFilter {
    pub fn doFilter(self: Self, request: Request, response: Response, chain: FilterChain) -> Response {
        val token = request.header("Authorization");
        if (token == "" && !request.path.startsWith("/api/public")) {
            return Response.status(401).body("Unauthorized");
        }
        // Validate token, extract user, add to context
        return chain.doFilter(request);
    }
}

// ── CORS: Controller-level ──────────────────────────────────────────────────
#[restController]
#[route("/api")]
#[crossOrigin(origins: ["https://example.com", "https://app.example.com"])]
pub type PublicController {
    #[getMapping("/public/data")]
    pub fn getData(self: Self, req: Request) -> Response {
        return Response.json("{\"data\": \"public\"}");
    }
}

// ── CORS: Global configuration ──────────────────────────────────────────────
#[configuration]
pub type CorsConfig {
    #[bean]
    pub fn corsConfiguration(self: Self) -> CorsConfiguration {
        return CorsConfiguration(
            allowedOrigins: ["https://example.com"],
            allowedMethods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
            allowedHeaders: ["Content-Type", "Authorization", "X-Request-Id"],
            exposedHeaders: ["X-Request-Id"],
            maxAge: 3600,
        );
    }
}

// ── Error Handling: Custom Exceptions ───────────────────────────────────────
pub type NotFoundException(message: string, resource: string, id: string)
pub type ValidationException(message: string, field: string, value: string)
pub type UnauthorizedException(message: string)

// ── Error Handling: @ControllerAdvice ───────────────────────────────────────
#[controllerAdvice]
pub type GlobalExceptionHandler {
    #[exceptionHandler("NotFoundException")]
    pub fn handleNotFound(self: Self, ex: NotFoundException) -> ProblemDetail {
        return ProblemDetail(
            type: "https://api.example.com/problems/not-found",
            title: "Resource Not Found",
            status: 404,
            detail: ex.message,
            instance: "/api/" + ex.resource + "/" + ex.id,
        );
    }

    #[exceptionHandler("ValidationException")]
    pub fn handleValidation(self: Self, ex: ValidationException) -> ProblemDetail {
        return ProblemDetail(
            type: "https://api.example.com/problems/validation-error",
            title: "Validation Error",
            status: 400,
            detail: "Field '" + ex.field + "' has invalid value: " + ex.value,
            instance: "/api/validation",
        );
    }

    #[exceptionHandler("UnauthorizedException")]
    pub fn handleUnauthorized(self: Self, ex: UnauthorizedException) -> Response {
        return Response.status(401).body(ex.message);
    }
}

// ── Controller que lança exceções ───────────────────────────────────────────
#[restController]
#[route("/api")]
pub type UserController {
    #[getMapping("/users/:id")]
    pub fn getUser(self: Self, req: Request) -> Response {
        val id = req.param("id");
        if (id == "999") {
            throw NotFoundException("User not found", "users", id);
        }
        return Response.json("{\"id\": " + id + ", \"name\": \"Alice\"}");
    }

    #[postMapping("/users")]
    pub fn createUser(self: Self, req: Request) -> Response {
        val email = req.query("email");
        if (!email.contains("@")) {
            throw ValidationException("Invalid email", "email", email);
        }
        return Response.created("{\"id\": 1, \"email\": \"" + email + "\"}");
    }
}

fn main() {
    // Filter chain execution order:
    // 1. RequestIdFilter (order: -200) - adds X-Request-Id
    // 2. LoggingFilter (order: -100) - logs request/response
    // 3. AuthFilter (order: -50) - validates auth
    // 4. Controller handler
    //
    // CORS:
    // - Preflight OPTIONS handled automatically
    // - Access-Control-Allow-Origin set based on config
    //
    // Error handling:
    // - Exceptions caught by @controllerAdvice
    // - Converted to RFC 9457 Problem Details
    Rakun.run(App(port: 8080, basePath: "/api"));
}

//// Testes:
////
//// test "filters execute in order" {
////     // RequestIdFilter → LoggingFilter → AuthFilter → handler
//// }
////
//// test "CORS headers set correctly" {
////     // OPTIONS request returns correct CORS headers
//// }
////
//// test "exceptions converted to Problem Details" {
////     // NotFoundException → 404 with RFC 9457 JSON
//// }
