// Front 52 — onze Font · examples/font-example.bp
//
// Demonstrates: a root layout loading Inter from Google and a local brand face,
// applying one by class name and one by CSS variable. The font files are
// downloaded at build time and self-hosted, so nothing at request time reaches
// a third-party host.
//
// Upstream: https://nextjs.org/docs/app/api-reference/components/font
//           https://nextjs.org/docs/app/getting-started/fonts
//           NEXTJS-DOCS.md § 17. Otimização de Fontes
//
// Target: the fetch, the metrics lookup and the CSS generation run on the
// ERLANG half at build time; the `<head>` this produces is served from there.
// The JS half is what the descriptors then drive in the browser: paint in the
// adjusted fallback, swap to Inter, move nothing.

import {Element, div, text, renderToString} from "jhonstart";
import {
    Font,
    GoogleFontOptions,
    LocalFontOptions,
    LocalFontSource,
    googleFont,
    localFont,
    fontHead,
} from "onze";
import {layout, LayoutProps} from "rakun";                      // front 22
import {rkAppRegisterLayout} from "rakun";

// Body text: Inter, two weights, latin only, swap, with the metric-adjusted
// fallback on. `variable: ""` means "give me a class, not a custom property".
#[@future]
pub fn bodyFont() -> @Future<Font> {
    val opts = GoogleFontOptions(
        weights: ["400", "700"],
        styles: ["normal"],
        subsets: ["latin"],
        display: "swap",
        preload: true,
        variable: "",
        fallback: ["system-ui", "sans-serif"],
        adjustFontFallback: true,
    );
    return await googleFont("Inter", opts);
}

// Headings: a local face shipped with the app, exposed as a custom property so
// the app's own CSS can reference `var(--font-brand)`.
#[@future]
pub fn brandFont() -> @Future<Font> {
    val sources = [
        LocalFontSource(path: "./fonts/Brand-Bold.woff2", weight: "700", style: "normal"),
    ];
    val opts = LocalFontOptions(
        sources: sources,
        display: "swap",
        preload: true,
        variable: "--font-brand",
        fallback: ["Georgia", "serif"],
        adjustFontFallback: true,
    );
    return await localFont("Brand", opts);
}

// app/layout.bp — the root layout returns the BODY subtree only. The head is a
// separate value, because it has to be composed after the tree is built (that is
// when emilia's classes exist), and front 69 owns where in the head it goes.
//
// Front 22's layouts are synchronous, so the font class is named as a constant:
// front 52 resolves the family at BUILD time and the class name is a pure
// function of family and build id.
val siteFont = "onze-font-inter";

#[layout("")]
pub fn RootLayout(props: LayoutProps) -> Element {
    return div([props.children], attrs: [#("class", siteFont)]);
}

#[@future]
pub fn documentHead() -> @Future<string> {
    val body = await bodyFont();
    val brand = await brandFont();
    return fontHead([body, brand]);
}

test "the google font is self-hosted — no third-party host survives into the CSS" {
    val f = await bodyFont();
    assert f.css.contains("@font-face");
    assert f.css.contains("font-display:swap");
    assert f.css.contains("/static/fonts/");
    assert f.css.contains("fonts.gstatic.com").negate();
    assert f.css.contains("fonts.googleapis.com").negate();
}

test "a class-named font has no custom property, and a variable font has one" {
    val body = await bodyFont();
    val brand = await brandFont();
    assert body.className.startsWith("onze-font-");
    assert body.variable == "";
    assert brand.variable == "--font-brand";
    assert brand.css.contains("--font-brand:");
}

test "preload links come before the font CSS, so the request starts first" {
    val head = await documentHead();
    val linkAt = head.indexOf("rel=\"preload\"");
    val faceAt = head.indexOf("@font-face");
    assert linkAt >= 0;
    assert faceAt > linkAt;
}

test "the layout applies the body font by class, and the head carries the faces" {
    val leaf = text("hello", attrs: []);
    val markup = renderToString(RootLayout(LayoutProps(children: leaf)));
    assert markup.contains("class=\"onze-font-");

    val head = await documentHead();
    assert head.contains("@font-face");
    assert head.contains("rel=\"preload\"");
}
