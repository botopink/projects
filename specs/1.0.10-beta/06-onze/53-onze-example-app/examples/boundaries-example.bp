// Front 53 — onze example app · examples/boundaries-example.bp
// App files: app/loading.bp · app/error.bp · app/blog/[slug]/not-found.bp
//
// Demonstrates: the three boundary conventions and the one rule that makes them
// compose — a boundary must let front 63's signals through instead of swallowing
// them. A 404 travels the same `@Result` channel as a real failure, because
// `throw` is the only way to abort a render. A boundary that caught everything
// would turn every missing post into "something went wrong" and every redirect
// into a fallback page.
//
// Upstream: https://nextjs.org/docs/app/api-reference/file-conventions/loading
//           https://nextjs.org/docs/app/api-reference/file-conventions/error
//           https://nextjs.org/docs/app/api-reference/file-conventions/not-found
//           NEXTJS-DOCS.md § 13. Streaming · § 14. Error Handling
//
// Target: erlang (server). `reset` on the error boundary is the one browser-side
// affordance here, and front 68 is what ships it.

import {Element, div, p, span, text, renderToString} from "jhonstart";
import {section, h2, button} from "jhonstart";          // provided by front 94
import {Link, linkProps} from "jhonstart";              // front 27
// front 31 — the boundary surface
import {ErrorInfo, ErrorBoundary, catchError, renderBoundaryChecked, isSignal} from "jhonstart";
import {styled, Token} from "emilia";                   // front 48
import {notFound} from "jhonstart";                     // front 31 — a page's signals are jhonstart's (decision 115)
// app-local
import {Post, findPost, missingPost} from "@/lib.db";

fn panelTokens() -> Token[] {
    return [.Pad.All.8, .Bg.Gray.100, .Border.Rounded.Md];
}

// ── app/loading.bp — front 30 ───────────────────────────────────────────────
//
// One export, no arguments, no boundary name. Front 22 discovers the file; front
// 23 builds the boundary. The skeleton is deliberately the same shape as the
// content it replaces, so the swap does not move the page.
pub fn Loading() -> Element {
    return div([
        span([text("", attrs: [])], attrs: [#("class", "skeleton-line")]),
        span([text("", attrs: [])], attrs: [#("class", "skeleton-line")]),
    ], attrs: [#("class", "skeleton")]);
}

// ── app/error.bp — front 31 ─────────────────────────────────────────────────
//
// The fallback receives `ErrorInfo`, which carries the DIGEST and not the
// message: front 17 logs the full error on the server under that digest, and the
// browser is told only the reference. A user-facing error message is a leak.
pub fn errorFallback(info: ErrorInfo) -> Element {
    return section([
        h2([text("Something went wrong", attrs: [])], attrs: []),
        p([text("Reference " + info.digest, attrs: [])], attrs: [#("class", "digest")]),
        button([text("Try again", attrs: [])], attrs: [#("data-jh-on-click", "error:reset")]),
    ], attrs: [styled(panelTokens())]);
}

// ── app/blog/[slug]/not-found.bp — front 31 + front 63 ──────────────────────
//
// The NEAREST boundary wins: a `notFound()` raised by `app/blog/[slug]/page.bp`
// lands here, not in the root `app/not-found.bp`.
pub fn NotFound() -> Element {
    return section([
        h2([text("Post not found", attrs: [])], attrs: []),
        p([text("It may have been unpublished.", attrs: [])], attrs: []),
        Link(linkProps("/blog"), [text("Back to the blog", attrs: [])]),
    ], attrs: [styled(panelTokens())]);
}

// ── the page this wraps ─────────────────────────────────────────────────────

#[@result]
fn postPanel(slug: string) -> @Result<Element, string> {
    val found = findPost(slug);
    if (found.isEmpty()) {
        throw notFound();
    };
    val post = found.first().unwrapOr(missingPost(slug));
    return div([text(post.title, attrs: [])], attrs: [#("class", "post")]);
}

pub fn postBoundary(slug: string) -> ErrorBoundary {
    return catchError("blog.slug.page", errorFallback, { ->
        postPanel(slug);
    });
}

// ── stubs, so both outcomes are reachable without a filesystem ─────────────

#[@result]
fn signallingPanel() -> @Result<Element, string> {
    throw "jhonstart:not-found";
}

#[@result]
fn failingPanel() -> @Result<Element, string> {
    throw "the content directory is unreadable";
}

fn boundaryOver(child: fn() -> @Result<Element, string>) -> ErrorBoundary {
    return catchError("blog.slug.page", errorFallback, child);
}

test "a navigation signal is recognised as a signal, an error is not" {
    assert isSignal("jhonstart:not-found");
    assert isSignal("jhonstart:redirect:/login");
    assert isSignal("the content directory is unreadable") == false;
}

test "a signal passes through the boundary uncaught, so the 404 survives" {
    val outcome = renderBoundaryChecked(boundaryOver(signallingPanel));
    assert outcome.isError();
}

test "an ordinary failure is caught and becomes the fallback" {
    val outcome = renderBoundaryChecked(boundaryOver(failingPanel));
    assert outcome.isOk();
}

test "the error fallback shows a digest and never a message" {
    val markup = renderToString(errorFallback(ErrorInfo(digest: "d41d8cd9", message: "unreadable")));
    assert markup.contains("d41d8cd9");
    assert markup.contains("unreadable") == false;
}

test "the not-found page links back to the index" {
    val markup = renderToString(NotFound());
    assert markup.contains("Post not found");
    assert markup.contains("href=\"/blog\"");
}

test "the loading skeleton renders without touching the store" {
    assert renderToString(Loading()).contains("skeleton");
}
