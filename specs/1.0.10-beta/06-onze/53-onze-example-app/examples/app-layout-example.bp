// Front 53 — onze example app · examples/app-layout-example.bp
// App file: app/layout.bp
//
// Demonstrates: the root layout. `#[layout("")]` (jhonstart front 30) registers
// it at the root, and onze copies the record into rakun's route table;
// `props.children` is the subtree the router already built. It returns the BODY
// subtree only — the document shell and the moment the head is written belong
// to jhonstart front 30's render, the one place that knows whether the response
// is streaming.
//
// Upstream: https://nextjs.org/docs/app/api-reference/file-conventions/layout
//           https://nextjs.org/docs/app/getting-started/fonts
//           NEXTJS-DOCS.md § 5. Layouts and Pages · § 15. Styling · § 17. Fonts
//
// Target: erlang (server). The nav it renders contains `Link` elements whose
// click behaviour is the JS half (front 27, shipped by front 68); the markup is
// not.

import {Element, div, text, renderToString} from "jhonstart";
// `header`, `main` and `nav` are provided by front 94 (jhonstart-element-surface)
// in `repository/jhonstart/src/elements.bp`; `element.bp` is frozen at eight
// builders and is not where these live.
import {header, main, nav} from "jhonstart";
import {Link, linkProps, withClass} from "jhonstart";          // front 27
// front 48 — `styled(tokens)` is `#("class", emilia(tokens))`; `styledWith`
// puts a static class first and the emilia class second, one ASCII space.
import {styled, styledWith, Token} from "emilia";
import {layout, LayoutProps} from "jhonstart";                     // front 30
// front 52 — self-hosted fonts with a metric-adjusted fallback
import {Font, GoogleFontOptions, googleFont, fontHead} from "onze";

// Token lists live in named functions, not inline: the server and the client
// must build the SAME list in the SAME order, because token order is class
// identity (contracts.md § 4).
fn pageTokens() -> Token[] {
    return [.Bg.White, .Color.Gray.900, .Pad.All.4];
}

fn navTokens() -> Token[] {
    return [.Layout.Flex, .Flex.Gap.4, .Pad.Y.2];
}

// front 52 — one family, two weights, latin, swap, adjusted fallback on. The
// font files are downloaded at build time and self-hosted, so nothing at
// request time reaches a third-party host.
#[@future]
fn bodyFont() -> @Future<Font> {
    val opts = GoogleFontOptions(
        weights: ["400", "700"],
        styles: ["normal"],
        subsets: ["latin"],
        display: "swap",
        preload: true,
        variable: "",
        fallback: ["system-ui", "sans-serif"],
        adjustFontFallback: true,
    );
    return await googleFont("Inter", opts);
}

// front 27 — `Link` is client navigation; the server renders an ordinary
// anchor, and front 68's bundle is what intercepts the click.
fn siteNav() -> Element {
    return nav([
        Link(linkProps("/"), [text("Home", attrs: [])]),
        Link(withClass(linkProps("/blog"), "nav-item"), [text("Blog", attrs: [])]),
        Link(linkProps("/about"), [text("About", attrs: [])]),
    ], attrs: [styled(navTokens())]);
}

// front 30 — `#[layout("")]` is the root layout: the one segment every request
// passes through. The decorator argument is the app-relative directory, and
// front 50's scan fails the build when it disagrees with the file's location.
//
// jhonstart front 30's layouts are synchronous (`LayoutProps -> Element`), so the font
// cannot be awaited here. It does not need to be: front 52 resolves the family
// at BUILD time and its class name is a pure function of family and build id,
// so the layout names it as a constant and `documentHead` below produces the
// bytes it refers to.
val siteFont = "onze-font-inter";

#[layout("")]
pub fn rootLayout(props: LayoutProps) -> Element {
    return div([
        header([siteNav()], attrs: []),
        main([props.children], attrs: []),
    ], attrs: [styledWith(siteFont, pageTokens())]);
}

// front 52 + front 69 — the head. `fontHead` produces the preload links and the
// `@font-face` blocks; front 69's sink is what decides where they go relative to
// emilia's `<style>` and to a streamed chunk's own block.
#[@future]
pub fn documentHead() -> @Future<string> {
    val font = await bodyFont();
    return fontHead([font]);
}

test "the layout wraps the router's subtree in a header and a main" {
    val leaf = text("body", attrs: []);
    val markup = renderToString(rootLayout(LayoutProps(children: leaf)));
    assert markup.contains("<header>");
    assert markup.contains("<main>");
    assert markup.contains("body");
}

test "the static font class comes first and the emilia class second" {
    val leaf = text("body", attrs: []);
    val markup = renderToString(rootLayout(LayoutProps(children: leaf)));
    assert markup.contains("class=\"onze-font-inter e_");
}

test "the nav renders anchors the browser can follow before hydration" {
    val markup = renderToString(siteNav());
    assert markup.contains("href=\"/\"");
    assert markup.contains("href=\"/blog\"");
    assert markup.contains("href=\"/about\"");
}

test "the head carries the preload links before the font faces" {
    val head = await documentHead();
    val linkAt = head.indexOf("rel=\"preload\"");
    val faceAt = head.indexOf("@font-face");
    assert linkAt >= 0;
    assert faceAt > linkAt;
    assert head.contains("fonts.gstatic.com") == false;
}
