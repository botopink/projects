// Front 50 — onze CLI · examples/generated-routes-example.bp
//
// Demonstrates: the file `onze build` writes to `<outDir>/app_tree.bp`, and
// the check that goes with it.
//
// Front 22 registers a route from a DECORATOR ARGUMENT — `#[page("blog/[slug]")]`
// — because `@Decl` carries no source location and a decorator cannot read the
// file it annotates (`language-gaps.md`). That makes the file-system convention
// two halves: the argument, written by the developer, and the module actually
// being compiled, decided by the tree. This generated module is the second half,
// and `checkTree` below is what stops the two from drifting.
//
// A developer does not write this file. They read it when a route does not
// resolve, which is why the generator emits source rather than an opaque table.
//
// The app it was generated from, and the staging the CLI applies because a
// botopink `mod` path segment is an identifier and `[slug]` is not:
//
//   app/layout.bp                  -> app/layout.bp                 #[layout("")]
//   app/page.bp                    -> app/page.bp                   #[page("")]
//   app/blog/layout.bp             -> app/blog/layout.bp            #[layout("blog")]
//   app/blog/page.bp               -> app/blog/page.bp              #[page("blog")]
//   app/blog/loading.bp            -> app/blog/loading.bp           (discovered, not decorated)
//   app/blog/[slug]/page.bp        -> app/blog/d_slug/page.bp       #[page("blog/[slug]")]
//   app/blog/[slug]/not-found.bp   -> app/blog/d_slug/not_found.bp  (discovered, not decorated)
//   app/(marketing)/about/page.bp  -> app/g_marketing/about/page.bp #[page("(marketing)/about")]
//   app/api/posts/route.bp         -> app/api/posts/route.bp        #[getRoute("api/posts")]
//   app/_drafts/                   -> not staged, not routed
//
// Upstream: https://nextjs.org/docs/app/getting-started/project-structure
//           NEXTJS-DOCS.md § 3. Estrutura do Projeto · § 29. CLI
//
// Target: both — the generated module compiles for erlang (the server registers
// and serves these routes) and the route table it produces is the artifact front
// 68's client router prefetches against.

// GENERATED by onze build — do not edit.
//
// Loading a module is what runs its `#[page]` / `#[layout]` / `#[getRoute]`
// decorators, so this file's only job is to make every convention module part of
// the build tree. There is no registry call here: front 22's decorators do the
// registering.

pub mod app;

// …and, inside `<outDir>/app/root.bp`, likewise generated:
//
//   pub mod layout;
//   pub mod page;
//   pub mod blog;
//   pub mod g_marketing;
//   pub mod api;
//
// one `pub mod` per staged directory and per convention file, in sorted order so
// two builds of an unchanged tree produce byte-identical output — which is what
// makes front 03's build id stable.

// ── the check that keeps the two halves in step ──────────────────────────────
//
// This half is ordinary CLI code, not generated. It compares what the tree says
// a file's segment is against what the file's decorator argument says, and fails
// the build naming the AUTHORED path — never the staged one, which the developer
// has never seen.

import {AppFile} from "onze";

pub type TreeError(
    authoredPath: string,
    expected: string,
    declared: string,
)

pub fn checkTree(files: AppFile[], declared: Array<#(string, string)>) -> TreeError[] {
    var errors: TreeError[] = [];
    loop (files) { f ->
        val says = declaredFor(declared, f.authoredPath);
        val agrees = says == f.segment;
        if (agrees == false) {
            errors.push(TreeError(
                authoredPath: f.authoredPath,
                expected: f.segment,
                declared: says,
            ));
        };
    };
    return errors;
}

fn declaredFor(declared: Array<#(string, string)>, authoredPath: string) -> string {
    var found = "";
    loop (declared) { d ->
        if (d._0 == authoredPath) found = d._1;
    };
    return found;
}

fn scanned() -> AppFile[] {
    return [
        AppFile(authoredPath: "app/layout.bp", segment: "", kind: "layout"),
        AppFile(authoredPath: "app/page.bp", segment: "", kind: "page"),
        AppFile(authoredPath: "app/blog/page.bp", segment: "blog", kind: "page"),
        AppFile(authoredPath: "app/blog/[slug]/page.bp", segment: "blog/[slug]", kind: "page"),
        AppFile(authoredPath: "app/(marketing)/about/page.bp", segment: "(marketing)/about", kind: "page"),
        AppFile(authoredPath: "app/api/posts/route.bp", segment: "api/posts", kind: "route"),
    ];
}

test "a tree whose decorators match its directories produces no errors" {
    val declared = [
        #("app/layout.bp", ""),
        #("app/page.bp", ""),
        #("app/blog/page.bp", "blog"),
        #("app/blog/[slug]/page.bp", "blog/[slug]"),
        #("app/(marketing)/about/page.bp", "(marketing)/about"),
        #("app/api/posts/route.bp", "api/posts"),
    ];
    assert checkTree(scanned(), declared).isEmpty();
}

test "a moved file fails the build, naming the path the developer wrote" {
    val declared = [
        #("app/layout.bp", ""),
        #("app/page.bp", ""),
        #("app/blog/page.bp", "blog"),
        #("app/blog/[slug]/page.bp", "posts/[slug]"),
        #("app/(marketing)/about/page.bp", "(marketing)/about"),
        #("app/api/posts/route.bp", "api/posts"),
    ];
    val errors = checkTree(scanned(), declared);
    assert errors.length == 1;
    val first = errors.first().unwrapOr(TreeError(authoredPath: "", expected: "", declared: ""));
    assert first.authoredPath == "app/blog/[slug]/page.bp";
    assert first.expected == "blog/[slug]";
    assert first.declared == "posts/[slug]";
}

test "the bracket spelling survives staging — the segment is not the module path" {
    val hit = scanned().filter({ f -> f.authoredPath == "app/blog/[slug]/page.bp" });
    val f = hit.first().unwrapOr(AppFile(authoredPath: "", segment: "", kind: ""));
    assert f.segment == "blog/[slug]";
    assert f.segment.contains("d_slug") == false;
}

test "a route group is in the segment and never in the URL — front 22's job, not this one" {
    val hit = scanned().filter({ f -> f.segment.startsWith("(marketing)") });
    assert hit.length == 1;
}
