// Front 49 — onze stand-up · examples/alias-and-env-example.bp
//
// Demonstrates: the two project-level rules onze declares and other fronts
// enforce.
//   1. the import alias map — `@/components.post_card` resolved to a
//      package-relative module path by front 50 before the compiler sees it;
//   2. the `ONZE_PUBLIC_` prefix rule — the only names front 68 may inline into
//      the browser bundle. Everything else stays on the server.
//
// Upstream: https://nextjs.org/docs/app/getting-started/installation
//           https://nextjs.org/docs/app/guides/environment-variables
//           NEXTJS-DOCS.md § 2. Installation and Configuration · § 7. Server and Client Components
//
// Target: both — the alias map is a build-time (js half) concern, the env split
// decides what the js half is allowed to contain and is therefore enforced
// against a value the erlang half reads freely.

import {AliasMap, resolveAlias, isPublicEnvName, publicEnv} from "onze";

// What a project's botopink.json `alias` map becomes.
pub fn blogAliases() -> AliasMap {
    return AliasMap(entries: [
        #("@/components", "components"),
        #("@/lib", "lib"),
        #("@/lib/db", "lib.database"),
    ]);
}

// The names an app declares as safe to ship to the browser. The predicate is
// applied again inside `publicEnv`, so a mistake in this list cannot leak.
pub fn browserEnvNames() -> string[] {
    return ["ONZE_PUBLIC_SITE_URL", "ONZE_PUBLIC_ANALYTICS_ID"];
}

test "an alias prefix resolves to the mapped module path" {
    val m = blogAliases();
    assert resolveAlias(m, "@/components.post_card") == "components.post_card";
    assert resolveAlias(m, "@/lib.actions") == "lib.actions";
}

test "the longest matching prefix wins" {
    val m = blogAliases();
    assert resolveAlias(m, "@/lib/db.posts") == "lib.database.posts";
}

test "a spec with no alias prefix is returned unchanged" {
    val m = blogAliases();
    assert resolveAlias(m, "jhonstart") == "jhonstart";
    assert resolveAlias(m, "app.blog.page") == "app.blog.page";
}

test "only the ONZE_PUBLIC_ prefix is inlinable, and the match is case-sensitive" {
    assert isPublicEnvName("ONZE_PUBLIC_SITE_URL");
    assert isPublicEnvName("DATABASE_URL").negate();
    assert isPublicEnvName("onze_public_site_url").negate();
    assert isPublicEnvName("MY_ONZE_PUBLIC_URL").negate();
}

test "publicEnv drops a non-public name even when the caller asks for it" {
    val asked = ["ONZE_PUBLIC_SITE_URL", "DATABASE_URL"];
    val allowed = publicEnv(asked);
    assert allowed.count({ e -> isPublicEnvName(e._0) }) == allowed.length;
    assert allowed.any({ e -> e._0 == "DATABASE_URL" }).negate();
}
