// Front 49 — onze stand-up · examples/integration-example.bp
//
// Demonstrates: what an onze app's entry module looks like, and — more to the
// point — how little of it is onze's. The page and the layout are written in
// jhonstart front 30's vocabulary (`#[page]`, `#[layout]`, `PageContext`, `LayoutProps`),
// the class comes from front 48's `styled`, and onze contributes exactly two
// things: the config value, and `Onze.run` turning it into a listener.
//
// onze proposes no `PageProps`, `Params`, `registerPage` or `renderDocument`:
// jhonstart front 30 and rakun fronts 22 and 23 own them, and a second name for
// a value in the same stack is a translation layer.
//
// Upstream: https://nextjs.org/docs/app/getting-started/layouts-and-pages
//           https://nextjs.org/docs/app/api-reference/config/next-config-js
//           NEXTJS-DOCS.md § 3. Project Structure · § 5. Layouts and Pages
//
// Target: erlang (server) for the render and the listener. The config value is
// also read by the js half at build time, which is why front 49's target is both.

import {Element, div, h1, p, text, renderToString} from "jhonstart";
import {styled, Token} from "emilia";                          // front 48
import {page, layout, PageContext, LayoutProps} from "jhonstart";  // front 30
import {Onze, OnzeConfig, defaultConfig, withPort} from "onze";
import {collections.Dict} from "std";

fn shellTokens() -> Token[] {
    return [.Bg.White, .Color.Gray.900, .Pad.All.4];
}

fn titleTokens() -> Token[] {
    return [.Text.Size.X2xl, .Text.Bold];
}

// app/layout.bp — jhonstart front 30's decorator registers it at the root, and
// onze copies the record into rakun's route table at boot. The
// decorator argument is the app-relative directory, and front 50's scan fails
// the build when it disagrees with where the file actually is. A layout is a
// component (decision 117): `#[@use] … -> @Component<Element>`, or the marker
// refuses it at compile time.
#[layout("")]
#[@use]
pub fn rootLayout(props: LayoutProps) -> @Component<Element> {
    return div([props.children], attrs: [styled(shellTokens())]);
}

// app/blog/[slug]/page.bp — the param arrives in `route.params`, a std `Dict`,
// read with `lookup(k).unwrapOr(...)`. onze does not wrap it.
#[page("blog/[slug]")]
#[@use]
pub fn blogPostPage(route: PageContext) -> @Component<Element> {
    val slug = route.params.lookup("slug").unwrapOr("");
    return div([
        h1([text("Post: " + slug, attrs: [])], attrs: [styled(titleTokens())]),
        p([text("Rendered on the BEAM.", attrs: [])], attrs: []),
    ], attrs: []);
}

// The app's entry point. This is the whole of onze's integration layer at run
// time: a port and a base path.
pub fn main() {
    val config = withPort(defaultConfig(), 3000);
    Onze.run(config);
}

fn postRoute(slug: string) -> PageContext {
    return PageContext(
        pathname: "/blog/" + slug,
        pattern: "/blog/[slug]",
        params: Dict.empty().insert("slug", slug),
        query: Dict.empty(),
        rest: [],
    );
}

test "a page reads its dynamic segment out of jhonstart's PageContext" {
    val markup = renderToString(await blogPostPage(postRoute("hello-world")));
    assert markup.contains("Post: hello-world");
    assert markup.contains("class=\"e_");
}

test "an absent param reads as empty, never as an error" {
    val empty = PageContext(
        pathname: "/blog/",
        pattern: "/blog/[slug]",
        params: Dict.empty(),
        query: Dict.empty(),
        rest: [],
    );
    assert renderToString(await blogPostPage(empty)).contains("Post: ");
}

test "the layout wraps the router's subtree and styles it through front 48" {
    val leaf = text("inner", attrs: []);
    val markup = renderToString(await rootLayout(LayoutProps(children: leaf)));
    assert markup.startsWith("<div class=\"e_");
    assert markup.contains("inner");
}
