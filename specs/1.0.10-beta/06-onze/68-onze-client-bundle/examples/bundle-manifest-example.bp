// Front 68 — onze-client-bundle · examples/bundle-manifest-example.bp
//
// The bundle contract, as code. This is the file fronts 23, 50, 69 and 71 read
// against: the build host writes the manifest, the BEAM server reads it back on
// every render and turns it into the `<script>` tags of the matched route.
//
// It is a `|`-delimited text table rather than JSON because std's json module is
// `parse`/`stringify` over strings with no structured walker
// (libs/std/src/json.bp:36,45) — there is no JSON object to decode into a
// record. The same reason gave front 22's route table the same shape.
//
// This file compiles for BOTH targets, and the round-trip test below is run on
// both. That is the whole justification for this front not being js-only: two
// parsers that agree until they do not is the failure this avoids.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/cli/next
//   https://nextjs.org/docs/app/api-reference/components/script

import { ChunkRef, ClientBundleManifest } from "onze-bundler";
import { parseManifest, formatManifest, chunkFor, scriptTags } from "onze-bundler";

// The payload script (`<script>window.__bp0 = …</script>`) is jhonstart's render's
// (front 30) and is placed last in `<body>`, before these tags — `contracts.md § 2`. This front emits the bundle
// tags that follow it and nothing else.

// One route's worth of a real manifest: a shared chunk, one route chunk, the
// entry, one stylesheet from front 69, and the single public variable.
fn sampleManifest() -> ClientBundleManifest {
    val entry = ChunkRef(
        id: "entry",
        url: "/_onze/static/b7f2a1/entry.9c1d40.js",
        hash: "9c1d40",
        bytes: 2480,
    );
    val shared = ChunkRef(
        id: "shared",
        url: "/_onze/static/b7f2a1/shared.41ab08.js",
        hash: "41ab08",
        bytes: 18320,
    );
    val postChunk = ChunkRef(
        id: "route:/blog/[slug]",
        url: "/_onze/static/b7f2a1/r3.7e0055.js",
        hash: "7e0055",
        bytes: 5120,
    );
    val sheet = ChunkRef(
        id: "styles",
        url: "/_onze/static/b7f2a1/app.2b91cc.css",
        hash: "2b91cc",
        bytes: 940,
    );
    return ClientBundleManifest(
        version: "1",
        buildId: "b7f2a1",
        entry: entry,
        shared: [shared],
        chunks: [postChunk],
        routes: [#("/blog/[slug]", "route:/blog/[slug]")],
        styles: [sheet],
        publicEnv: [#("ONZE_PUBLIC_API_URL", "https://api.example.com")],
    );
}

// ── tests ────────────────────────────────────────────────────────────────────

test "a manifest survives the round trip the build host and the server share" {
    val written = formatManifest(sampleManifest());
    val read = parseManifest(written);
    assert read.version == "1";
    assert read.buildId == "b7f2a1";
    assert read.entry.hash == "9c1d40";
    assert read.chunks.length == 1;
    assert read.publicEnv.length == 1;
}

test "the text form is the documented table, one record per line" {
    val written = formatManifest(sampleManifest());
    assert written.contains("V|1|b7f2a1");
    assert written.contains("E|entry|/_onze/static/b7f2a1/entry.9c1d40.js|9c1d40|2480");
    assert written.contains("R|/blog/[slug]|route:/blog/[slug]");
    assert written.contains("Y|styles|");
}

test "a record kind a reader does not know is ignored, not an error" {
    val extended = formatManifest(sampleManifest()) + "\nZ|something|front-71-added-this";
    val read = parseManifest(extended);
    assert read.buildId == "b7f2a1";
    assert read.chunks.length == 1;
}

test "the route chunk is found by pattern, and an unmatched route has none" {
    val m = sampleManifest();
    assert chunkFor(m, "/blog/[slug]").hash == "7e0055";
    assert chunkFor(m, "/about").id == "";
}

test "bundle tags come out in the documented order, entry last" {
    val tags = scriptTags(sampleManifest(), "/blog/[slug]");
    val sharedAt = tags.indexOf("shared.41ab08.js");
    val routeAt = tags.indexOf("r3.7e0055.js");
    val entryAt = tags.indexOf("entry.9c1d40.js");
    assert sharedAt < routeAt;
    assert routeAt < entryAt;
    assert tags.contains("defer");
}

test "the payload tag is jhonstart's render's and this front never formats one" {
    val tags = scriptTags(sampleManifest(), "/blog/[slug]");
    assert tags.contains("window.__bp") == false;
    assert tags.contains("application/json") == false;
}

test "a route with no chunk of its own still gets shared and entry" {
    val tags = scriptTags(sampleManifest(), "/about");
    assert tags.contains("shared.41ab08.js");
    assert tags.contains("entry.9c1d40.js");
    assert tags.contains("src=\"\"") == false;
}
