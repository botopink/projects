// Front 68 — onze-client-bundle · examples/client-island-example.bp
//
// The only file of this front an application author ever writes: a client
// component that ends up in the browser bundle.
//
// Three things happen to this module at build time, all of them front 68's:
//   1. It is a ROOT of the client graph, because it carries front 29's boundary
//      marker. Everything it imports goes to the browser with it.
//   2. `ONZE_PUBLIC_API_URL` is inlined into the bundle's public table. A read
//      of any other variable from this module would fail the build — see
//      `env-refusal-example.bp`.
//   3. `emilia(cardTokens)` is resolved at build time: its rule body goes into
//      the server's stylesheet (front 69) and its class name is hashed with both
//      the commonJS and the erlang fold, which must agree or the build fails.
//      That is what makes the class in the server HTML and the class in the
//      hydrated component the same string.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/server-and-client-components
//   https://nextjs.org/docs/app/guides/environment-variables

// The boundary marker is front 29's; its spelling is front 29's to choose and
// this file uses the name that front lands.
import { client } from "jhonstart";
import { Element, div, span, text, renderToString } from "jhonstart";
import { emilia, Token } from "emilia";
import { io.env } from "std";

// Inlined by the bundler: the name is `ONZE_PUBLIC_`-prefixed, so its value is
// written into the manifest's public table and this read becomes a lookup.
// The prefix rule is front 49's; front 68 is where it is enforced.
val apiBase = env.read("ONZE_PUBLIC_API_URL").unwrapOr("http://localhost:3000");

// A literal token list, so the bundler can evaluate the rule body. A token list
// computed at run time would fail the build, because a class the stylesheet does
// not contain is invisible breakage.
val cardTokens: Token[] = [.Bg.White, .Text.Bold, .Color.Black];

val cardClass = emilia(cardTokens);

#[client]
pub fn StatusCard(name: string, online: bool) -> Element {
    return statusCard(name, online);
}

// Pure, so the markup is testable without a browser and identical on the server
// pass and after hydration — which is the property hydration depends on.
fn statusCard(name: string, online: bool) -> Element {
    val label = if (online) { "online" } else { "offline" };
    return div([
        span([text(name, attrs: [])], attrs: [#("class", "name")]),
        span([text(label, attrs: [])], attrs: [#("class", "state")]),
        span([text(apiBase, attrs: [])], attrs: [#("class", "endpoint")]),
    ], attrs: [#("class", cardClass)]);
}

// ── tests ────────────────────────────────────────────────────────────────────

test "the card carries the emilia class the server render assigned" {
    val markup = renderToString(statusCard("ana", true));
    assert markup.contains("class=\"" + cardClass + "\"");
    assert cardClass.startsWith("e_");
}

test "the same inputs render the same markup twice — hydration compares strings" {
    val first = renderToString(statusCard("ana", true));
    val second = renderToString(statusCard("ana", true));
    assert first == second;
}

test "the public endpoint reaches the browser; nothing else from the environment does" {
    val markup = renderToString(statusCard("bob", false));
    assert markup.contains(apiBase);
    assert markup.contains("offline");
}
