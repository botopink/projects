// Front 01 — std lib enablement · path-and-process-example.bp
//
// What the file router (front 22) and the onze CLI (front 50) need from std:
// walk a directory tree, turn each file into a route segment list, reject the
// ones that escape the root, and shell out to a child process for the build.
//
// Upstream: https://nodejs.org/api/path.html
//           https://nodejs.org/api/child_process.html
//           https://www.erlang.org/doc/apps/stdlib/filename.html
//           https://www.erlang.org/doc/apps/stdlib/filelib.html
//
// SERVER SIDE. `path` is pure botopink and runs on every backend; `fs.walk` and
// `process.run` carry both an erlang and a commonJS cell, so the CLI works under
// `node` and under the BEAM. The two that touch the disk and the process table
// come from `io/` (decision 106); `path` stays at the pure root.

import {path, io: {fs, process}} from "std";

// Every `page.bp` under `root`. `fs.walk` is the recursive directory walk
// front 22 cannot exist without — today std can read a directory but not
// descend into it.
fn pageFiles(root: string) -> string[] {
    val walked = fs.walk(root);
    val all = walked.unwrapOr([]);
    return all.filter({ p -> path.basename(p) == "page.bp" });
}

// `app/blog/[slug]/page.bp` → ["blog", "[slug]"] — the route the file router
// registers. The leading and trailing empty segments `path.split` leaves behind
// are dropped here rather than in the router.
fn routeSegments(root: string, file: string) -> string[] {
    val dir = path.dirname(file);
    val rel = path.relative(root, dir);
    val parts = path.split(rel);
    return parts.filter({ s -> s != "" });
}

// The traversal guard. A route file that resolves outside the app root is not a
// route, it is an attempt to serve `/etc/passwd`, and front 22 rejects it here
// rather than after the path has been opened.
fn isServable(root: string, file: string) -> bool {
    val inside = path.isInside(root, file);
    val isPage = path.basename(file) == "page.bp";
    val ok = if (inside) isPage else false;
    return ok;
}

// The route table one `app/` directory produces, as `"blog/[slug]"` strings.
pub fn routeTable(appDir: string) -> string[] {
    val files = pageFiles(appDir);
    val servable = files.filter({ f -> isServable(appDir, f) });
    return servable.map({ f -> routeSegments(appDir, f).join("/") });
}

// The CLI's build step. `process.run` captures stdout and stderr rather than
// inheriting them, so `onze build` can put the compiler's output behind
// `--verbose` and print a one-line summary by default.
pub fn runCompiler(projectRoot: string) -> i32 {
    val entry = path.join([projectRoot, "src", "root.bp"]);
    val outcome = process.run("botopink", ["build", entry]);
    val status = case outcome {
        Ok(result) -> result.status;
        Error(error) -> -1;
    };
    return status;
}

// The compiler's own output, for `--verbose`. A non-zero exit is still `Ok` —
// the process ran, it just failed, and the caller wants to see why.
pub fn compilerOutput(projectRoot: string) -> string {
    val entry = path.join([projectRoot, "src", "root.bp"]);
    val outcome = process.run("botopink", ["build", entry]);
    val text = case outcome {
        Ok(result) -> result.stdout + result.stderr;
        Error(error) -> error;
    };
    return text;
}

// The asset name the image and font optimizers write to (fronts 51 and 52):
// `hero.png` beside a content hash becomes `hero.<hash>.png`.
pub fn fingerprintedPath(assetDir: string, fileName: string, hash: string) -> string {
    val stem = path.withoutExtension(fileName);
    val ext = path.extname(fileName);
    return path.join([assetDir, stem + "." + hash + ext]);
}

// One pass of what `onze dev` does at start-up: discover the routes, then
// compile them. Answers the route count, or -1 when the build failed.
pub fn discoverAndBuild(projectRoot: string) -> i32 {
    val appDir = path.join([projectRoot, "app"]);
    val routes = routeTable(appDir);
    val status = runCompiler(projectRoot);
    val built = status == 0;
    val answer = if (built) routes.length else -1;
    return answer;
}

// `process.cwd()` and `process.platform` are already in std today; the CLI reads
// both to resolve a relative project argument and to pick the shipped binary.
pub fn resolveProject(argument: string) -> string {
    val absolute = path.isAbsolute(argument);
    val here = process.cwd();
    val resolved = if (absolute) path.normalize(argument) else path.resolve([here, argument]);
    return resolved;
}
