// Front 01 — std lib enablement · crypto-and-encoding-example.bp
//
// Signing and verifying an HS256 token, deriving an ETag, and putting a signed
// value on a URL. These are the three things fronts 10 (security), 18 (session)
// and 03 (content hash) bottom out in, and none of them can be written against
// std as it stands: `hash.hmacSha256` answers hex, RFC 7515 wants base64url of
// the raw digest, and nothing in std compares two signatures in constant time.
//
// Upstream: https://datatracker.ietf.org/doc/html/rfc7519  (JWT)
//           https://datatracker.ietf.org/doc/html/rfc7515  (JWS — base64url)
//           https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/ETag
//           https://www.erlang.org/doc/apps/crypto/crypto.html
//           https://nodejs.org/api/crypto.html
//
// SERVER SIDE. Both modules build for either target, but only the server ever
// holds the signing key — a client front that calls `hash.hmacSha256Base64Url`
// has a design error, not a dependency.

import {encoding, hash} from "std";

// The JWS signing input: base64url(header) "." base64url(payload).
fn signingInput(headerJson: string, payloadJson: string) -> string {
    val header = encoding.base64UrlEncode(headerJson);
    val payload = encoding.base64UrlEncode(payloadJson);
    return header + "." + payload;
}

// A complete HS256 token. `hmacSha256Base64Url` answers the base64url of the
// RAW digest; `hash.hmacSha256` answers hex, which is a different string and
// not the one a JWT verifier anywhere else will accept.
pub fn signHs256(key: string, headerJson: string, payloadJson: string) -> string {
    val input = signingInput(headerJson, payloadJson);
    val signature = hash.hmacSha256Base64Url(key, input);
    return input + "." + signature;
}

// Verify in constant time. `expected == presented` here leaks the signature one
// byte at a time to anyone who can time the response; `equalsConstantTime` is a
// security requirement, not a convenience.
pub fn verifyHs256(key: string, token: string) -> bool {
    val parts = token.split(".");
    val wellFormed = parts.length == 3;
    if (wellFormed == false) {
        return false;
    };
    val header = parts.at(0).unwrapOr("");
    val payload = parts.at(1).unwrapOr("");
    val presented = parts.at(2).unwrapOr("");
    val expected = hash.hmacSha256Base64Url(key, header + "." + payload);
    return hash.equalsConstantTime(expected, presented);
}

// The claims half of a verified token, still base64url-encoded on the way in.
// `base64UrlDecode` is total on well-formed input and answers "" otherwise, so a
// tampered token reads as an empty claim set rather than a crash.
pub fn claimsOf(key: string, token: string) -> string {
    val valid = verifyHs256(key, token);
    if (valid == false) {
        return "";
    };
    val parts = token.split(".");
    val payload = parts.at(1).unwrapOr("");
    return encoding.base64UrlDecode(payload);
}

// A strong ETag for a rendered body. Front 03 wraps this as `hash.etag`;
// the primitive underneath is a digest plus a base64url rendering.
pub fn etagOf(body: string) -> string {
    val digest = hash.sha256Base64Url(body);
    return "\"" + digest + "\"";
}

// A signed callback URL. `querystring.stringify` does not percent-encode — its
// own docblock says callers must pre-escape — so a signature containing `-` and
// `_` is safe but a state value containing `&` is not. `encoding.formStringify`
// is the escaping form, and it is why `encoding` owns the query codec.
pub fn callbackUrl(base: string, state: string, key: string) -> string {
    val signature = hash.hmacSha256Base64Url(key, state);
    val pairs = [#("state", state), #("sig", signature)];
    return base + "?" + encoding.formStringify(pairs);
}

// The other direction: read the pairs back and check the signature before the
// state value is trusted for anything.
pub fn verifyCallback(query: string, key: string) -> bool {
    val pairs = encoding.formParse(query);
    val state = valueOf(pairs, "state");
    val presented = valueOf(pairs, "sig");
    val expected = hash.hmacSha256Base64Url(key, state);
    return hash.equalsConstantTime(expected, presented);
}

fn valueOf(pairs: Array<#(string, string)>, name: string) -> string {
    val hit = pairs.find({ p -> p._0 == name });
    return hit.map({ p -> p._1 }).unwrapOr("");
}

// The WebSocket handshake accept key (front 20): SHA-1 of the client key
// concatenated with the RFC 6455 GUID, base64 — not base64url, and not hex.
pub fn websocketAccept(clientKey: string) -> string {
    val guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    return hash.sha1Base64(clientKey + guid);
}
