// Front 01 — std lib enablement · net-server-example.bp
//
// A TCP echo server and its client half, written the way an application writes
// one: bind, accept, read, write, close. This is the primitive under rakun's
// HTTP server (front 04) and the WebSocket upgrade (front 20).
//
// Upstream: https://www.erlang.org/doc/apps/kernel/gen_tcp.html
//           https://www.erlang.org/doc/apps/ssl/ssl.html
//           https://nodejs.org/api/net.html
//
// SERVER SIDE. `std/io/net` is server-only: it declares an erlang cell and an
// explicit commonJS refusal, so on the js target every call below answers
// `Error("std/io/net: server-only")`.
//
// `Listener`, `Socket`, `TlsSocket` and `Peer` come into scope with the module
// import, the way `Dict` does for `collections`; the host calls that belong to a
// socket are its methods (`sock.recv(…)`, `listener.accept(…)`). Only the leaf
// `net` enters scope (decision 107).

import {io.net} from "std";

// Serve one connection: read up to 4096 bytes, write the same bytes back, close.
// Answers true when the whole exchange completed.
fn echoOnce(sock: Socket) -> bool {
    val received = sock.recv(4096, 5000);
    val handled = case received {
        Ok(result) -> sock.send(result).isOk();
        Error(error) -> false;
    };
    val _c = sock.close();
    return handled;
}

// Accept up to `budget` connections, one at a time, and answer how many were
// served. `budget` bounds the loop so the test harness terminates; a real server
// loops forever and hands each socket to a worker.
fn acceptLoop(listener: Listener, budget: i32) -> i32 {
    var served = 0;
    var attempts = 0;
    while (attempts < budget) {
        attempts = attempts + 1;
        val accepted = listener.accept(30000);
        val completed = case accepted {
            Ok(result) -> echoOnce(result);
            Error(error) -> false;
        };
        if (completed) {
            served = served + 1;
        };
    };
    val _c = listener.close();
    return served;
}

// Bind `port` and serve `budget` connections. A failed bind is an `Error`, not a
// crash — the caller decides whether to retry on another port.
pub fn serve(port: i32, budget: i32) -> i32 {
    val bound = net.listen(port, 16);
    val served = case bound {
        Ok(result) -> acceptLoop(result, budget);
        Error(error) -> -1;
    };
    return served;
}

// The client half. Front 13 (http clients) and front 08 (SQL drivers) both open
// their connection exactly like this before speaking their own protocol.
fn writeThenRead(sock: Socket, payload: string) -> string {
    val written = sock.send(payload);
    val answer = case written {
        Ok(result) -> sock.recv(0, 5000).unwrapOr("");
        Error(error) -> "";
    };
    val _c = sock.close();
    return answer;
}

pub fn echoRoundTrip(host: string, port: i32, payload: string) -> string {
    val connected = net.connect(host, port, 5000);
    val answer = case connected {
        Ok(result) -> writeThenRead(result, payload);
        Error(error) -> "";
    };
    return answer;
}

// TLS is the same calls with the `ssl` application behind them. Front 10
// (security) and front 13 (http clients) take this path for https; the CA
// file, certificate and key are paths the caller owns, never bytes std holds.
pub fn tlsRoundTrip(host: string, port: i32, caFile: string, payload: string) -> string {
    val connected = net.tlsConnect(host, port, caFile, 5000);
    val answer = case connected {
        Ok(result) -> tlsWriteThenRead(result, payload);
        Error(error) -> "";
    };
    return answer;
}

fn tlsWriteThenRead(sock: TlsSocket, payload: string) -> string {
    val written = sock.send(payload);
    val answer = case written {
        Ok(result) -> sock.recv(0, 5000).unwrapOr("");
        Error(error) -> "";
    };
    val _c = sock.close();
    return answer;
}

// Who is on the other end — front 07 logs it, front 17 correlates by it.
pub fn peerLabel(sock: Socket) -> string {
    val p = sock.peer();
    val label = case p {
        Ok(result) -> result.host + ":" + result.port.toString();
        Error(error) -> "unknown";
    };
    return label;
}
