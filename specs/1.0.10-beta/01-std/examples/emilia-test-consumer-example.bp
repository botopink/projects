// Front 01 — std · examples/emilia-test-consumer-example.bp
//
// Example 2, part 2: a test file that consumes `emilia-test` with `@src()`.
// This is the shape of a test at the foot of `modules/emilia/src/emilia.bp`
// (emilia core's own tests) or of `test/emilia_test.bp` in a project that
// depends on emilia and has `"emilia-test"` in its dependencies.
//
// Each `assert<Subject>(@src(), …)` records or checks a snapshot at
// `<dir of this file>/__snapshots__/<suite>/<slug>.snap`; a mismatch writes
// `<path>.new` and fails the test. A person renames the `.new` to accept it.
// There is no flag.
//
// With this file at `src/emilia.bp`, the snapshots below live at
//   src/__snapshots__/css/modifiers_hover_on_md_breakpoint.snap
//   src/__snapshots__/utility/modifiers_hover_on_md_breakpoint.snap
//   src/__snapshots__/css/shared_fixture_bg_white_text_lg.snap
//   src/__snapshots__/utility/two_utilities_side_by_side.snap
//   src/__snapshots__/utility/two_utilities_side_by_side.second.snap
// and snapshots.md shows the exact bytes of the first two.

import {asserts} from "std";
import {Token} from "emilia";
import {assertCss, assertUtility, assertUtilityNamed, assertDeclaration, hoverOnMd, sharedFixtureTokens} from "emilia-test";

// ── snapshots ──────────────────────────────────────────────────────────────

// The enum example from the contract, in the spelling that parses today.
test "css: modifiers ---- hover on md breakpoint" {
    val leaf: Token[] = [.Bg.Red.500];
    try assertCss(@src(), hoverOnMd(leaf));
}

// Same tokens, whole utility (class + rule). Suite `utility`, same slug.
test "utility: modifiers ---- hover on md breakpoint" {
    val leaf: Token[] = [.Bg.Red.500];
    try assertUtility(@src(), hoverOnMd(leaf));
}

// The contract-4 shared fixture, as CSS. When front 56 changes the emitted
// body this snapshot mismatches, a `.new` appears, and a person reads it —
// the regeneration contract 4 describes, made visible.
test "css: shared fixture ---- bg white text lg" {
    try assertCss(@src(), sharedFixtureTokens());
}

// Two snapshots from one test: the second is named.
test "utility: two utilities side by side" {
    val bold: Token[] = [.Text.Bold];
    val white: Token[] = [.Bg.White];
    try assertUtility(@src(), bold);
    try assertUtilityNamed(@src(), "second", white);
}

// ── plain assertions beside the snapshots ──────────────────────────────────

test "emilia: a single text token lowers to one declaration" {
    val tokens: Token[] = [.Text.Bold];
    try assertDeclaration(tokens, "font-weight:bold");
}

test "emilia: @src() names this test and this file" {
    val loc = @src();
    try asserts.equals(loc.fnName, "emilia: @src() names this test and this file");
    try asserts.endsWith(loc.file, "emilia.bp");
    try asserts.greaterThan(loc.line, 0);
}
