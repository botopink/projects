// Front 02 — std async primitives · parallel-fetch-example.bp
//
// A server-rendered dashboard that issues its three reads together instead of
// one after another, renders without the optional widgets when they are down,
// and puts a time budget on a slow dependency.
//
// Upstream: NEXTJS-DOCS.md § 9. Data Fetching
//           https://nextjs.org/docs/app/getting-started/fetching-data
//           https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise/all
//
// SERVER SIDE. This runs on the erlang target with the rest of the render half.
// `runAll`, `raceOf` and `timeout` take UNSTARTED tasks — `{ -> fetchBody(url) }`
// thunks rather than `fetchBody(url)` calls — because `@Task<T>` lowers eagerly
// on erlang: a Task that is already a value cannot be run in parallel with
// anything. See the README's *The module*.

import {async, io: {http, clock}} from "std";

// One read. A `@Task<@Result<…>>` return: a live Promise on commonJS, an
// already-resolved value on erlang. The read can fail, so the failure is inside
// the value; `try await` propagates the fetch's own `Error`.
fn fetchBody(url: string) -> @Task<@Result<string, string>> {
    val resp = try await http.fetch(url);
    return resp.body;
}

// The three reads the dashboard cannot render without. `runAll` starts all
// three and answers each one's `@Result` in input order; if any one failed the
// whole page fails, which is what we want for required data.
//
// LANGUAGE GAP: no array destructuring in a binding — `val [users, posts, stats]
// = bodies;` does not parse. Read positionally with `.at(i).unwrapOr(…)`.
pub fn dashboardBody() -> @Task<@Result<string, string>> {
    val parts = await async.runAll([
        { -> fetchBody("https://api.example.com/users") },
        { -> fetchBody("https://api.example.com/posts") },
        { -> fetchBody("https://api.example.com/stats") },
    ]);
    val errors = parts.map({ r -> async.errorText(r) }).filter({ e -> e != "" });
    if (errors.length > 0) {
        throw errors.join("; ");
    };
    val bodies = parts.map({ r -> r.unwrapOr("") });
    val users = bodies.at(0).unwrapOr("");
    val posts = bodies.at(1).unwrapOr("");
    val stats = bodies.at(2).unwrapOr("");
    return users + posts + stats;
}

// Two optional widgets from two independent services. Each slot of `runAll`
// is the task's own `@Result`, so the page renders whichever answered. Nothing
// propagates, so the return is a plain `@Task<string>`.
pub fn widgetStrip() -> @Task<string> {
    val settled = await async.runAll([
        { -> fetchBody("https://a.example.com/widget") },
        { -> fetchBody("https://b.example.com/widget") },
    ]);
    val answered = settled.filter({ r -> r.isOk() });
    return answered.map({ r -> r.unwrapOr("") }).join("");
}

// Two mirrors of the same asset, first ANSWER wins — not first in the list.
// `raceOf` can make that promise because the tasks are unstarted when it
// receives them; the started-task `race` cannot, and no server function here
// uses it.
pub fn fastestMirror() -> @Task<@Result<string, string>> {
    return await async.raceOf([
        { -> fetchBody("https://mirror-a.example.com/asset") },
        { -> fetchBody("https://mirror-b.example.com/asset") },
    ]);
}

// The report, or its placeholder when the service answered an error.
fn reportOrPlaceholder() -> @Task<string> {
    val r = await fetchBody("https://slow.example.com/report");
    return r.unwrapOr("<p>report unavailable</p>");
}

// A report service that is sometimes slow. Two seconds is the page's whole
// budget for it; past that the section renders the placeholder and the page
// still ships. The task keeps running — there is no cancellation.
pub fn reportSection() -> @Task<string> {
    val answered = await async.timeout({ -> reportOrPlaceholder() }, 2000);
    return answered.unwrapOr("<p>report unavailable</p>");
}

// The whole page: the optional sections run together, then the required reads
// (three tasks run together themselves). The optional ones never fail; the
// required one is the only error that reaches the page.
pub fn renderDashboard() -> @Task<@Result<string, string>> {
    val optional = await async.runAll([
        { -> widgetStrip() },
        { -> reportSection() },
    ]);
    val body = try await dashboardBody();
    return body + optional.join("");
}

// ── tests ────────────────────────────────────────────────────────────────────
// `delay` is the instrument: without a task of known duration there is no way
// to tell a concurrent `runAll` from a sequential map.

fn okAfter(millis: i32, value: string) -> @Task<@Result<string, string>> {
    return await async.delay(millis, value);
}

test "runAll answers input order, not completion order" {
    val out = await async.runAll([
        { -> async.delay(60, "a") },
        { -> async.delay(20, "b") },
        { -> async.delay(40, "c") },
    ]);
    assert out.join(",") == "a,b,c";
}

test "runAll runs its tasks concurrently" {
    val start = clock.nowMillis();
    val out = await async.runAll([
        { -> async.delay(60, "a") },
        { -> async.delay(60, "b") },
        { -> async.delay(60, "c") },
    ]);
    val elapsed = clock.nowMillis() - start;
    assert out.length == 3;
    assert elapsed < 150;
}

test "raceOf answers the fastest task" {
    val first = await async.raceOf([
        { -> async.delay(80, "slow") },
        { -> async.delay(10, "fast") },
    ]);
    assert first == "fast";
}

test "runAll keeps each fallible task's @Result in its slot" {
    val settled = await async.runAll([
        { -> okAfter(10, "ok") },
        { -> async.failed("down") },
    ]);
    assert settled.length == 2;
    assert settled.map({ r -> async.errorText(r) }).join("|") == "|down";
}
