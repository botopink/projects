// Front 48 — emilia attributes: the class slot.
//
// A card component's attributes built with the slot as plain data — the
// `#("class", …)` pairs a builder's `attrs:` array takes, and the bare class
// string a `[class]={…}` hole takes — the static-class merge, the no-space rule
// shown as the form that works, and the flushed CSS those classes select.
//
// emilia imports nobody (decisions 113 and 114): this example uses emilia only
// and asserts class names, attribute arrays and CSS strings. Rendering these
// attributes into HTML is jhonstart's; the rendered round trip (builders and
// the html DSL producing the same bytes) is the `jhonstart-emilia` bridge's
// test, and an application that renders a styled page is an onze example.
//
// Upstream:
//   https://tailwindcss.com/docs/styling-with-utility-classes
//   https://nextjs.org/docs/app/getting-started/css
// Reference: TAILWIND_CSS_DOCS.md § 3. Core Concepts
//
// THE CONTRACT THIS FILE DEMONSTRATES:
//   class = "e_" + contentHash(encodeSheet(tokensToSheet(tokens, theme)))   // std content_hash, a djb2 fold
//   - a pure function of the token list, in author order, and the theme
//   - nothing else enters the hash
//   - a static class merges BEFORE the emilia class, one ASCII space
//   - the rule body must be ASCII, or the JS and erlang hashes diverge
// The server renders this class into the HTML on BEAM; the client recomputes
// it in JavaScript during hydration. If the two disagree, the page flashes.

import {styled, styledWith, className, cls, clsWith, mergeClass, flush, defaultTheme, Theme, Token} from "emilia";

// ── the token lists, in named functions ──────────────────────────────────────
//
// Token lists live in functions rather than inline for two reasons, and both
// are load-bearing. First, the `[class]={...}` hole in jhonstart's html DSL may
// not contain a space, so an inline array literal cannot go there. Second, the
// server and the client must build the SAME list in the SAME order: one shared
// function guarantees that, two inline copies do not.

fn cardTokens() -> Token[] {
    val hovered: Token[] = [.Effect.Shadow.Lg];
    val card: Token[] = [
        .Bg.White,
        .Pad.All.4,
        .Border.Rounded.Lg,
        .Effect.Shadow.Md,
        .Transition.Shadow,
        .Transition.Duration.200,
        Token.Hover(hovered),
    ];
    return card;
}

fn cardTitleTokens() -> Token[] {
    val title: Token[] = [
        .Text.Bold,
        .Text.Size.Lg,
        .Color.Gray.900,
    ];
    return title;
}

fn cardBodyTokens() -> Token[] {
    val body: Token[] = [
        .Color.Gray.700,
        .Margin.Y.2,
    ];
    return body;
}

// ── the slot, as attribute data ──────────────────────────────────────────────
//
// `styled(tokens, th)` is `#("class", emilia(tokens, th))` — the pair drops
// straight into any builder's `attrs:` array. Here it is only data: the array a
// renderer would write, in the order it would write it.

pub fn cardAttrs(th: Theme) -> Array<#(string, string)> {
    val attrs: Array<#(string, string)> = [#("id", "card-4821"), styled(cardTokens(), th)];
    return attrs;
}

// ── the static-class merge ───────────────────────────────────────────────────
//
// `styledWith(base, tokens, th)` puts the static class FIRST and the emilia
// class second, separated by one ASCII space. The order is fixed because
// `class="card e_1f3a9b"` and `class="e_1f3a9b card"` are the same CSS and two
// different attribute strings, and a hydrator comparing strings sees two
// different values. The base is passed through unchanged: no sorting, no
// de-duplication, no trimming of interior spaces.

pub fn legacyCardAttr(th: Theme) -> #(string, string) {
    return styledWith("legacy-card", cardTokens(), th);
}

// ── the class a `[class]={…}` hole receives ──────────────────────────────────
//
// `cls(tokens, th)` returns the class name as a bare string, which is what a
// hole in jhonstart's `html """…"""` DSL wants.
//
// THE NO-SPACE RULE. The DSL splits a tag's body on " " before parsing
// attributes, so a hole containing a space is lexed as several attributes and
// fails with a parse error carrying no line number. This does NOT work:
//
//     html """<div [class]={cls(cardTokens(), th)}>hi</div>"""
//
// Bind the value first — `val card = cls(cardTokens(), th);` and then
// `[class]={card}`. The bound values are all this library produces.

pub fn holeClasses(th: Theme) -> Array<string> {
    val card = cls(cardTokens(), th);
    val title = cls(cardTitleTokens(), th);
    val body = clsWith("legacy-body", cardBodyTokens(), th);
    val out: Array<string> = [card, title, body];
    return out;
}

// Reading a class back out of an attribute array: "" for an absent name rather
// than `?string`, the convention the slot's consumers use.

fn attrOf(attrs: Array<#(string, string)>, name: string) -> string {
    var found = "";
    for (attrs) { a ->
        if (a._0 == name) found = a._1;
    };
    return found;
}

// ── the page's CSS ───────────────────────────────────────────────────────────
//
// `flush()` returns a `@Task<string>`, so the caller must return a `@Task` too (or be a `test`) and must
// `await` it. The sheet it returns is what the server ships in <style>; the
// client does the same `emilia()` calls during hydration, gets the same class
// names, and never flushes.

pub fn cardSheet() -> @Task<string> {
    val th = defaultTheme();
    val card = className(cardTokens(), th);
    val title = className(cardTitleTokens(), th);
    val sheet = await flush();
    return sheet;
}

fn main() -> @Task<void> {
    val th = defaultTheme();
    @print("card attrs class: " + attrOf(cardAttrs(th), "class"));
    @print("legacy card class: " + legacyCardAttr(th)._1);
    @print(await cardSheet());
}

// ── tests ────────────────────────────────────────────────────────────────────

test "attributes: styled is the class pair" {
    val th = defaultTheme();
    val pair = styled(cardTokens(), th);
    assert pair._0 == "class";
    assert pair._1 == className(cardTokens(), th);
}

test "attributes: the slot appends after the attributes before it" {
    val th = defaultTheme();
    val attrs = cardAttrs(th);
    assert attrs.at(0).unwrapOr(#("", ""))._0 == "id";
    assert attrs.at(1).unwrapOr(#("", ""))._0 == "class";
}

test "attributes: the static class merges first" {
    val th = defaultTheme();
    val v = legacyCardAttr(th)._1;
    assert v.startsWith("legacy-card ");
    assert v.endsWith(className(cardTokens(), th));
    assert mergeClass("", "e_x") == "e_x";
    assert mergeClass("a  b", "e_x") == "a  b e_x";
}

test "attributes: three names, one value" {
    val th = defaultTheme();
    assert cls(cardTokens(), th) == className(cardTokens(), th);
    assert holeClasses(th).at(0).unwrapOr("") == className(cardTokens(), th);
}

test "attributes: order is identity" {
    val th = defaultTheme();
    val a: Token[] = [.Text.Bold, .Color.Black];
    val b: Token[] = [.Color.Black, .Text.Bold];
    assert className(a, th) != className(b, th);
}

test "attributes: the flushed sheet selects the card class" {
    val th = defaultTheme();
    val card = className(cardTokens(), th);
    val sheet = await flush();
    assert sheet.indexOf("." + card) != -1;
}
