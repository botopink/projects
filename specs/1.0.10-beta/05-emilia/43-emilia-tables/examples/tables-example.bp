// Front 43 — emilia tables.
//
// The whole `Table` catalogue, then a data table whose outer element is
// `border-separate` with a row gap, a fixed layout and a bottom caption.
//
// Upstream:
//   https://tailwindcss.com/docs/border-collapse
//   https://tailwindcss.com/docs/border-spacing
//   https://tailwindcss.com/docs/table-layout
//   https://tailwindcss.com/docs/caption-side
// Reference: TAILWIND_CSS_DOCS.md § 14. Tabelas (spacing base from § 21.2)
//
// The spacing steps are `spacing(n)` = `calc(var(--spacing) * n)`, never a
// resolved `rem` (contract § 4a). They are the same steps `Pad` and `Margin`
// already use, so `.Pad.All.4` and `.Table.Spacing.4` mean the same distance —
// and both follow the theme when a project overrides `--spacing`.

import {emilia, flush, Token} from "emilia";

// ── border-collapse ──────────────────────────────────────────────────────────

val collapseModes: Token[] = [
    .Table.Collapse,
    .Table.Separate,
];

// ── table-layout ─────────────────────────────────────────────────────────────

val layoutModes: Token[] = [
    .Table.Layout.Auto,
    .Table.Layout.Fixed,
];

// ── border-spacing, uniform ──────────────────────────────────────────────────

val spacingScale: Token[] = [
    .Table.Spacing.0,
    .Table.Spacing.1,
    .Table.Spacing.2,
    .Table.Spacing.4,
    .Table.Spacing.8,
];

// ── border-spacing, per axis ─────────────────────────────────────────────────
//
// `SpacingX` writes the horizontal component first (`border-spacing:0.5rem 0`)
// and `SpacingY` writes it second (`border-spacing:0 0.5rem`). The two are not
// interchangeable; only the `0` step is the same for both.

val spacingXScale: Token[] = [
    .Table.SpacingX.0,
    .Table.SpacingX.1,
    .Table.SpacingX.2,
    .Table.SpacingX.4,
    .Table.SpacingX.8,
];

val spacingYScale: Token[] = [
    .Table.SpacingY.0,
    .Table.SpacingY.1,
    .Table.SpacingY.2,
    .Table.SpacingY.4,
    .Table.SpacingY.8,
];

// LANGUAGE GAP: a payload leaf nested inside an enum section cannot be
// constructed by any spelling (language-gaps.md row 52), so this is a TOP-LEVEL
// `Token` variant — `TableSpacingRaw`, not `Table.Spacing.Raw`. Contract § 4a.
//
// LANGUAGE GAP: and even at top level, a dot-shorthand path followed by a
// payload call does not propagate the typed-array context (row 51), so the
// construction goes through a fn.
fn rawSpacing(v: string) -> Token {
    return Token.TableSpacingRaw(value: v);
}

val hairlineGap: Token[] = [rawSpacing("1px 2px")];

// ── caption-side ─────────────────────────────────────────────────────────────

val captionSides: Token[] = [
    .Table.Caption.Top,
    .Table.Caption.Bottom,
];

// ── the component ────────────────────────────────────────────────────────────
//
// A ledger table: separated borders so each row reads as its own band, a
// vertical gap between rows, fixed column widths so a long description does not
// push the amount column off the edge, and the caption under the table.
//
// The narrow-screen fallback drops back to `auto` layout, because a fixed table
// with five columns on a phone is unreadable — `Md` applies the fixed layout
// only from 768px up.

fn ledgerTableTokens() -> Token[] {
    val wide: Token[] = [.Table.Layout.Fixed];
    val ledger: Token[] = [
        .Table.Separate,
        .Table.SpacingY.2,
        .Table.Layout.Auto,
        .Table.Caption.Bottom,
        Token.Md(wide),
    ];
    return ledger;
}

// A compact variant for a sidebar: collapsed borders, no spacing at all.
fn compactTableTokens() -> Token[] {
    val compact: Token[] = [
        .Table.Collapse,
        .Table.Spacing.0,
        .Table.Layout.Fixed,
        .Table.Caption.Top,
    ];
    return compact;
}

#[@future]
pub fn renderLedger() -> @Future<string> {
    val ledgerCls = emilia(ledgerTableTokens());
    val compactCls = emilia(compactTableTokens());
    val styles = await flush();
    val markup = "<table class=\"" + ledgerCls + "\">"
        + "<caption>Movimentacoes de setembro</caption>"
        + "<tr><td>Aluguel</td><td>1.200,00</td></tr>"
        + "</table>"
        + "<table class=\"" + compactCls + "\">"
        + "<caption>Resumo</caption>"
        + "<tr><td>Total</td><td>1.200,00</td></tr>"
        + "</table>";
    return markup + styles;
}
