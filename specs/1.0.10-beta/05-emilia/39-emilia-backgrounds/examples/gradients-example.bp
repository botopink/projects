// Front 39 — emilia-backgrounds
//
// The gradient family: eight linear directions and the three colour stops.
//
// Upstream: https://tailwindcss.com/docs/background-image
//           https://tailwindcss.com/docs/background-image#adding-color-stops
// Reference: TAILWIND_CSS_DOCS.md § 10.4 background-image
//
// emilia runs at comptime and emits a CSS string; this file is target-independent.
// The whole `Gradient` section is delivered by front 39. The stop colours are
// front 33's palette reached through `paletteVar`, so a gradient stop and a
// background colour name the same custom property. `bg-clip-text` is front 39's
// too; layout comes from front 36, spacing from 35, modifiers from 34.
//
// NOTE — the reference shows `from-*`/`via-*`/`to-*` in markup and prints no
// CSS for them. The custom-property shape below is recorded in this front's
// README under `## Reference gaps` and must be verified against upstream before
// implementation; it is not a transcription.

import {emilia, flush, Token} from "emilia";

// ── direction ────────────────────────────────────────────────────────────────
// Eight directions, each a `linear-gradient(<phrase>, var(--tw-gradient-stops))`.
// The phrase is spelled `to top right`, with spaces, not `to top-right`.

fn directions() -> Token[] {
    val values: Token[] = [
        .Gradient.To.T,
        .Gradient.To.Tr,
        .Gradient.To.R,
        .Gradient.To.Br,
        .Gradient.To.B,
        .Gradient.To.Bl,
        .Gradient.To.L,
        .Gradient.To.Tl,
    ];
    return values;
}

// ── stops ────────────────────────────────────────────────────────────────────
// The terminal stop is `Stop`, not `To`: `.Gradient.To.*` is already the
// direction. Tailwind spells both with the word `to` while they set unrelated
// things, and this front does not copy that collision.

fn twoStop() -> Token[] {
    val values: Token[] = [
        .Gradient.To.R,
        .Gradient.From.Indigo.500,
        .Gradient.Stop.Pink.500,
    ];
    return values;
}

fn threeStop() -> Token[] {
    val values: Token[] = [
        .Gradient.To.Br,
        .Gradient.From.Indigo.500,
        .Gradient.Via.Purple.500,
        .Gradient.Stop.Pink.500,
    ];
    return values;
}

// A stop may be any family and shade the palette carries, or one of the five
// named colours.

fn namedStops() -> Token[] {
    val values: Token[] = [
        .Gradient.To.B,
        .Gradient.From.Transparent,
        .Gradient.Stop.Slate.950,
    ];
    return values;
}

// ── the component ────────────────────────────────────────────────────────────
// A call-to-action: a gradient panel, a gradient-text heading built by clipping
// the background to the glyphs and making the text transparent, and a button
// whose gradient flips direction on hover.

pub fn callToAction(heading: string, body: string, action: string) -> @Task<string> {
    val panel: Token[] = [
        .Gradient.To.Br,
        .Gradient.From.Indigo.600,
        .Gradient.Via.Purple.600,
        .Gradient.Stop.Pink.600,
        .Pad.All.10,
        .Border.Rounded.X2xl,
        .Color.White,
    ];

    val gradientText: Token[] = [
        .Gradient.To.R,
        .Gradient.From.Sky.400,
        .Gradient.Stop.Emerald.400,
        .Bg.Clip.Text,
        .Color.Transparent,
        .Text.Size.X4xl,
        .Font.Weight.Extrabold,
    ];

    val flipped: Token[] = [
        .Gradient.To.L,
        .Gradient.From.Pink.500,
        .Gradient.Stop.Indigo.500,
    ];
    val button: Token[] = [
        .Gradient.To.R,
        .Gradient.From.Indigo.500,
        .Gradient.Stop.Pink.500,
        .Pad.X.5,
        .Pad.Y.2,
        .Border.Rounded.Full,
        .Color.White,
        Token.Hover(flipped),
    ];

    val panelClass = emilia(panel);
    val headingClass = emilia(gradientText);
    val buttonClass = emilia(button);
    val styles = await flush();

    val markup = "<div class=\"" + panelClass + "\">"
        + "<h2 class=\"" + headingClass + "\">" + heading + "</h2>"
        + "<p>" + body + "</p>"
        + "<span class=\"" + buttonClass + "\">" + action + "</span>"
        + "</div>";
    return styles + markup;
}

test "a direction is a linear-gradient over the stops variable" {
    val tokens: Token[] = [.Gradient.To.R];
    val cls = emilia(tokens);
    val styles = await flush();
    assert styles == "<style>." + cls
        + "{background-image:linear-gradient(to right, var(--tw-gradient-stops))}</style>";
}

test "the diagonal directions keep their two-word phrases" {
    val cls = emilia(directions());
    val styles = await flush();
    assert styles.contains("linear-gradient(to top right, var(--tw-gradient-stops))");
    assert styles.contains("linear-gradient(to bottom left, var(--tw-gradient-stops))");
    assert !styles.contains("to top-right");
}

test "a two-stop gradient composes from and to" {
    val cls = emilia(twoStop());
    val styles = await flush();
    assert styles.contains("--tw-gradient-from:var(--color-indigo-500)");
    assert styles.contains("--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-to)");
    assert styles.contains("--tw-gradient-to:var(--color-pink-500)");
}

test "a via stop rewrites the stops list to three" {
    val cls = emilia(threeStop());
    val styles = await flush();
    assert styles.contains("--tw-gradient-via:var(--color-purple-500)");
    assert styles.contains("--tw-gradient-stops:var(--tw-gradient-from), var(--tw-gradient-via), var(--tw-gradient-to)");
}

test "token order decides which stops list survives" {
    val viaFirst: Token[] = [
        .Gradient.Via.Purple.500,
        .Gradient.From.Indigo.500,
    ];
    val a = emilia(viaFirst);

    val fromFirst: Token[] = [
        .Gradient.From.Indigo.500,
        .Gradient.Via.Purple.500,
    ];
    val b = emilia(fromFirst);
    val styles = await flush();

    assert a != b;
    assert styles.contains("--tw-gradient-via");
}

test "a gradient stop and a background colour name the same custom property" {
    val stopTokens: Token[] = [.Gradient.From.Indigo.500];
    val stopClass = emilia(stopTokens);
    val stopStyles = await flush();

    val bgTokens: Token[] = [.Bg.Color.Indigo.500];
    val bgClass = emilia(bgTokens);
    val bgStyles = await flush();

    assert stopStyles.contains("var(--color-indigo-500)");
    assert bgStyles.contains("var(--color-indigo-500)");
}

test "the named stops work alongside the palette" {
    val cls = emilia(namedStops());
    val styles = await flush();
    assert styles.contains("--tw-gradient-from:transparent");
    assert styles.contains("--tw-gradient-to:var(--color-slate-950)");
}

test "the call to action clips its heading to the glyphs and flips on hover" {
    val out = await callToAction("Ship it", "One token list per element.", "Get started");
    assert out.startsWith("<style>");
    assert out.contains("background-clip:text;color:transparent");
    assert out.contains("linear-gradient(to bottom right, var(--tw-gradient-stops))");
    assert out.contains("@media (hover: hover){&:hover{background-image:linear-gradient(to left, var(--tw-gradient-stops))");
}
