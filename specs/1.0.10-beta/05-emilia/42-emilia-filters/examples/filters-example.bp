// Front 42 — emilia filters.
//
// The Filter and BackdropFilter catalogues as typed `Token[]` lists, filter
// composition in one list, the `Raw` escape hatch, then a frosted navigation
// bar over a dimmed hero image.
//
// Upstream:
//   https://tailwindcss.com/docs/filter
//   https://tailwindcss.com/docs/blur
//   https://tailwindcss.com/docs/backdrop-filter
// Reference: TAILWIND_CSS_DOCS.md § 13. Filters
//
// Every value is the reference's, character for character:
//   brightness(.5), not brightness(0.5)
//   grayscale(100%), not grayscale(1)
//
// Each filter leaf emits TWO declarations — its own `--tw-<family>` custom
// property and one `filter:` reader that chains every family back
// (`var(--tw-blur, ) var(--tw-brightness, ) …`), so two filter tokens in a list
// compose instead of overwriting.

import {emilia, flush, Token} from "emilia";

// ── filter: blur ─────────────────────────────────────────────────────────────

val blurScale: Token[] = [
    .Filter.Blur.None,
    .Filter.Blur.Xs,
    .Filter.Blur.Sm,
    .Filter.Blur.Md,
    .Filter.Blur.Lg,
    .Filter.Blur.Xl,
    .Filter.Blur.X2xl,
    .Filter.Blur.X3xl,
];

// ── filter: brightness / contrast ────────────────────────────────────────────

val brightnessScale: Token[] = [
    .Filter.Brightness.0,
    .Filter.Brightness.50,
    .Filter.Brightness.75,
    .Filter.Brightness.90,
    .Filter.Brightness.95,
    .Filter.Brightness.100,
    .Filter.Brightness.105,
    .Filter.Brightness.110,
    .Filter.Brightness.125,
    .Filter.Brightness.150,
    .Filter.Brightness.200,
];

val contrastScale: Token[] = [
    .Filter.Contrast.0,
    .Filter.Contrast.50,
    .Filter.Contrast.75,
    .Filter.Contrast.100,
    .Filter.Contrast.125,
    .Filter.Contrast.150,
    .Filter.Contrast.200,
];

// ── filter: colour adjustment ────────────────────────────────────────────────

val grayscaleSteps: Token[] = [
    .Filter.Grayscale.0,
    .Filter.Grayscale.100,
];

val hueRotateSteps: Token[] = [
    .Filter.HueRotate.0,
    .Filter.HueRotate.15,
    .Filter.HueRotate.30,
    .Filter.HueRotate.60,
    .Filter.HueRotate.90,
    .Filter.HueRotate.180,
];

val invertSteps: Token[] = [
    .Filter.Invert.0,
    .Filter.Invert.100,
];

val saturateScale: Token[] = [
    .Filter.Saturate.0,
    .Filter.Saturate.50,
    .Filter.Saturate.100,
    .Filter.Saturate.150,
    .Filter.Saturate.200,
];

val sepiaSteps: Token[] = [
    .Filter.Sepia.0,
    .Filter.Sepia.100,
];

// ── filter: drop-shadow ──────────────────────────────────────────────────────
//
// `drop-shadow(var(--drop-shadow-md))` — theme references; the values are
// `filterEntries()`, composed into `fullTheme()`. `None` empties the family.

val dropShadows: Token[] = [
    .Filter.DropShadow.None,
    .Filter.DropShadow.Xs,
    .Filter.DropShadow.Sm,
    .Filter.DropShadow.Md,
    .Filter.DropShadow.Lg,
    .Filter.DropShadow.Xl,
    .Filter.DropShadow.X2xl,
];

// ── backdrop-filter ──────────────────────────────────────────────────────────

val backdropBlurScale: Token[] = [
    .BackdropFilter.Blur.None,
    .BackdropFilter.Blur.Sm,
    .BackdropFilter.Blur.Md,
    .BackdropFilter.Blur.Lg,
    .BackdropFilter.Blur.Xl,
    .BackdropFilter.Blur.X2xl,
    .BackdropFilter.Blur.X3xl,
];

val backdropAdjust: Token[] = [
    .BackdropFilter.Brightness.110,
    .BackdropFilter.Contrast.125,
    .BackdropFilter.Grayscale.100,
    .BackdropFilter.HueRotate.90,
    .BackdropFilter.Invert.100,
    .BackdropFilter.Saturate.150,
    .BackdropFilter.Sepia.100,
];

val backdropOpacitySteps: Token[] = [
    .BackdropFilter.Opacity.0,
    .BackdropFilter.Opacity.50,
    .BackdropFilter.Opacity.100,
];

// ── composition ──────────────────────────────────────────────────────────────
//
// CSS `filter` does not accumulate: two `filter:` declarations and the second
// wins. Upstream, `blur-sm grayscale` works because each utility writes a
// `--tw-*` custom property that one `filter` declaration reads back; emilia
// does the same: the list below writes `--tw-blur`, `--tw-grayscale` and one
// idempotent chain reader into a single rule, and both families survive.

val composesThroughTheChain: Token[] = [.Filter.Blur.Sm, .Filter.Grayscale.100];

// A payload leaf nested inside an enum section cannot be constructed, so the
// escape hatches are TOP-LEVEL `Token` variants — `FilterRaw`, not `Filter.Raw`.
// A dot-shorthand path followed by a payload call does not carry the
// typed-array context (`[.FilterRaw("blur(8px)")]` does not parse), so
// construction goes through a fn — emilia exports `rawFilter` and
// `rawBackdropFilter`; these local ones are the same.
fn rawFilter(v: string) -> Token {
    return Token.FilterRaw(value: v);
}

fn rawBackdrop(v: string) -> Token {
    return Token.BackdropRaw(value: v);
}

// The `Raw` leaf stays, for a filter function the token set does not name.
val rawStack: Token[] = [rawFilter("blur(8px) grayscale(100%) brightness(1.1)")];

// ── the component ────────────────────────────────────────────────────────────
//
// A frosted navigation bar sitting over a hero image: the bar blurs and
// saturates what is behind it, the image itself is dimmed and desaturated so
// the bar's text stays legible. `flush()` returns a `@Task<string>`, so the caller must
// return a `@Task` too (or be a `test`) and must `await` it.

fn heroImageTokens() -> Token[] {
    val dimmed: Token[] = [.Filter.Brightness.75, .Filter.Saturate.50];
    return dimmed;
}

fn frostedBarTokens() -> Token[] {
    val hovered: Token[] = [.BackdropFilter.Brightness.110];
    val bar: Token[] = [
        .BackdropFilter.Blur.Md,
        Token.Hover(hovered),
    ];
    return bar;
}

fn frostedBarSaturationTokens() -> Token[] {
    // `BackdropFilter.Blur` and `BackdropFilter.Saturate` each write their own
    // `--tw-backdrop-<family>` property plus the shared `backdrop-filter:`
    // chain reader, so both survive in one rule. `rawBackdrop` is still there for a function the tokens do not
    // name.
    val sat: Token[] = [.BackdropFilter.Blur.Md, .BackdropFilter.Saturate.150];
    return sat;
}

fn frostedBarRawTokens() -> Token[] {
    val sat: Token[] = [rawBackdrop("blur(12px) saturate(1.5) contrast(1.1)")];
    return sat;
}

pub fn renderFrostedHeader() -> @Task<string> {
    val heroCls = emilia(heroImageTokens());
    val barCls = emilia(frostedBarSaturationTokens());
    val styles = await flush();
    val markup = "<div class=\"" + heroCls + "\">"
        + "<p class=\"" + barCls + "\">Arquivo</p>"
        + "</div>";
    return markup + styles;
}
