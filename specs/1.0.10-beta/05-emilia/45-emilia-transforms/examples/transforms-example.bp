// Front 45 — emilia transforms.
//
// The whole `Transform` catalogue, then a card that lifts and scales on hover and a
// disclosure chevron that rotates 180 degrees when open.
//
// Upstream:
//   https://tailwindcss.com/docs/rotate
//   https://tailwindcss.com/docs/scale
//   https://tailwindcss.com/docs/translate
//   https://tailwindcss.com/docs/transform-origin
//   https://tailwindcss.com/docs/perspective
// Reference: TAILWIND_CSS_DOCS.md § 16. Transforms
//
// Two conventions live in this file:
//   scale-50 -> --tw-scale-x/y/z:50% + scale:var(--tw-scale-x) var(--tw-scale-y)  (upstream v4)
//   zoom-50  -> zoom:0.5      (the reference's bare number, § 16.11)
//
// Perspective keywords are theme references (`transformEntries()`). Translate and
// skew take upstream v4's form: each axis writes its `--tw-*` variable and reads
// both, so two axis tokens in one rule compose; the variables are registered
// with `@property`.

import {emilia, flush, Token} from "emilia";

// ── rotate ───────────────────────────────────────────────────────────────────

val rotateSteps: Token[] = [
    .Transform.Rotate.0,
    .Transform.Rotate.1,
    .Transform.Rotate.45,
    .Transform.Rotate.90,
    .Transform.Rotate.180,
];

// A numeric enum leaf is a digit run and there is no spelling for a negative
// one, so `-rotate-12` is `Rotate.Neg.12`: the `Neg` sub-section holds the
// magnitudes and the dispatcher prepends the sign.
val rotateNegSteps: Token[] = [
    .Transform.Rotate.Neg.1,
    .Transform.Rotate.Neg.12,
    .Transform.Rotate.Neg.45,
    .Transform.Rotate.Neg.90,
    .Transform.Rotate.Neg.180,
];

// A payload leaf nested inside an enum section cannot be constructed, so the
// escape hatches are TOP-LEVEL `Token` variants — `TransformRotateRaw`, not
// `Transform.Rotate.Raw`. A dot-shorthand path followed by a payload call does
// not carry the typed-array context, so every arbitrary value goes through a fn
// (emilia exports `rawRotate` and `rawTranslate`).
fn rawRotate(v: string) -> Token {
    return Token.TransformRotateRaw(value: v);
}

fn rawTranslate(v: string) -> Token {
    return Token.TransformTranslateRaw(value: v);
}

val oddAngle: Token[] = [rawRotate("17deg")];

// ── scale ────────────────────────────────────────────────────────────────────

val scaleSteps: Token[] = [
    .Transform.Scale.0,
    .Transform.Scale.50,
    .Transform.Scale.75,
    .Transform.Scale.90,
    .Transform.Scale.95,
    .Transform.Scale.100,
    .Transform.Scale.105,
    .Transform.Scale.110,
    .Transform.Scale.125,
    .Transform.Scale.150,
];

val scaleAxes: Token[] = [
    .Transform.ScaleX.50,
    .Transform.ScaleY.50,
];

// ── translate ────────────────────────────────────────────────────────────────
//
// `TranslateX.Half` is `--tw-translate-x:50%;translate:var(--tw-translate-x)
// var(--tw-translate-y)`; the other axis reads its `@property` initial `0`.

val translateXSteps: Token[] = [
    .Transform.TranslateX.0,
    .Transform.TranslateX.Px,
    .Transform.TranslateX.1,
    .Transform.TranslateX.Half,
    .Transform.TranslateX.Full,
];

val translateYSteps: Token[] = [
    .Transform.TranslateY.0,
    .Transform.TranslateY.Px,
    .Transform.TranslateY.1,
    .Transform.TranslateY.Half,
    .Transform.TranslateY.Full,
];

// `TransformTranslateRaw` remains, for a translate the token set does not name.
val centred: Token[] = [rawTranslate("-50% -50%")];

// ── skew ─────────────────────────────────────────────────────────────────────
//
// Upstream's form, not the reference file's `skew-x:` column (which is not
// CSS): `.Transform.SkewX.3` is `--tw-skew-x:skewX(3deg)` and the five-variable
// `transform` chain, so two skews in one rule skew on both axes.

val skewXSteps: Token[] = [
    .Transform.SkewX.0,
    .Transform.SkewX.1,
    .Transform.SkewX.2,
    .Transform.SkewX.3,
    .Transform.SkewX.6,
    .Transform.SkewX.12,
];

val skewYSteps: Token[] = [
    .Transform.SkewY.0,
    .Transform.SkewY.1,
    .Transform.SkewY.2,
    .Transform.SkewY.3,
    .Transform.SkewY.6,
    .Transform.SkewY.12,
];

// ── transform-origin ─────────────────────────────────────────────────────────

val origins: Token[] = [
    .Transform.Origin.Center,
    .Transform.Origin.Top,
    .Transform.Origin.TopRight,
    .Transform.Origin.Right,
    .Transform.Origin.BottomRight,
    .Transform.Origin.Bottom,
    .Transform.Origin.BottomLeft,
    .Transform.Origin.Left,
    .Transform.Origin.TopLeft,
];

// ── the 3-D surface the reference actually covers ────────────────────────────
//
// `transform-style`, `backface-visibility`, `perspective` and
// `perspective-origin` are all in § 16 and all ship here. The axis variants
// rotate-x/y/z, translate-z, scale-z are NOT in § 16 and are not declared.

val threeD: Token[] = [
    .Transform.Style.Flat,
    .Transform.Style.Preserve3d,
    .Transform.Backface.Visible,
    .Transform.Backface.Hidden,
];

val perspectives: Token[] = [
    .Transform.Perspective.None,
    .Transform.Perspective.Dramatic,
    .Transform.Perspective.Near,
    .Transform.Perspective.Normal,
    .Transform.Perspective.Midrange,
    .Transform.Perspective.Distant,
];

val perspectiveOrigins: Token[] = [
    .Transform.PerspectiveOrigin.Center,
    .Transform.PerspectiveOrigin.Top,
    .Transform.PerspectiveOrigin.Bottom,
    .Transform.PerspectiveOrigin.Left,
    .Transform.PerspectiveOrigin.Right,
];

// ── zoom ─────────────────────────────────────────────────────────────────────

val zoomSteps: Token[] = [
    .Transform.Zoom.0,
    .Transform.Zoom.50,
    .Transform.Zoom.75,
    .Transform.Zoom.100,
    .Transform.Zoom.125,
    .Transform.Zoom.150,
    .Transform.Zoom.200,
];

// ── the transform shorthand ──────────────────────────────────────────────────
//
// Upstream v4's rows: `Cpu` is the skew chain and `Gpu` puts `translateZ(0)` in
// front of it, so either keeps a skew beside it.

val shorthands: Token[] = [
    .Transform.Shorthand.None,
    .Transform.Shorthand.Cpu,
    .Transform.Shorthand.Gpu,
];

// ── the component ────────────────────────────────────────────────────────────
//
// A card that lifts and scales on hover, and a disclosure chevron that rotates
// 180 degrees when its panel is open. `rotate` and `scale` are independent CSS
// properties in v4, so two of them in one list compose without the shorthand.
//
// Without the transition tokens the motion is a single frame and the transform
// is invisible.
//
// `flush()` returns a `@Task<string>`, so the caller must return a `@Task` too (or be a `test`) and must
// `await` it.

fn liftCardTokens() -> Token[] {
    val lifted: Token[] = [
        .Transform.Scale.105,
        .Effect.Shadow.Xl,
    ];
    val card: Token[] = [
        .Bg.White,
        .Pad.All.4,
        .Border.Rounded.Lg,
        .Effect.Shadow.Md,
        .Transform.Origin.Center,
        .Transition.All,
        .Transition.Duration.200,
        Token.Hover(lifted),
    ];
    return card;
}

fn chevronTokens(open: bool) -> Token[] {
    val turned: Token[] = [
        .Transform.Rotate.180,
        .Transform.Origin.Center,
        .Transition.Transform,
        .Transition.Duration.150,
    ];
    val resting: Token[] = [
        .Transform.Rotate.0,
        .Transform.Origin.Center,
        .Transition.Transform,
        .Transition.Duration.150,
    ];
    val out = if (open) turned else resting;
    return out;
}

pub fn renderDisclosureCard(open: bool) -> @Task<string> {
    val cardCls = emilia(liftCardTokens());
    val chevronCls = emilia(chevronTokens(open));
    val styles = await flush();
    val markup = "<div class=\"" + cardCls + "\">"
        + "<span class=\"" + chevronCls + "\">v</span>"
        + "<p>Detalhes do pedido</p>"
        + "</div>";
    return markup + styles;
}
