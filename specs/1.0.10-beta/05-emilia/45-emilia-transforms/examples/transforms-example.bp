// Front 45 — emilia transforms.
//
// The whole `Transform` catalogue, with the inert `var(--tw-*)` families marked
// at their declaration site, then a card that lifts and scales on hover and a
// disclosure chevron that rotates 180 degrees when open.
//
// Upstream:
//   https://tailwindcss.com/docs/rotate
//   https://tailwindcss.com/docs/scale
//   https://tailwindcss.com/docs/translate
//   https://tailwindcss.com/docs/transform-origin
//   https://tailwindcss.com/docs/perspective
// Reference: TAILWIND_CSS_DOCS.md § 16. Transforms
//
// Two decimal conventions live in this file and both are the reference's:
//   scale-50 -> scale:.5      (no leading zero, § 16.5)
//   zoom-50  -> zoom:0.5      (leading zero,    § 16.11)
//
// Perspective keywords are themeVar lookups (front 54), and each axis token
// writes its own `--tw-*` variable plus the shorthand that reads both back, so
// two axis tokens in one rule compose (front 56's `Rule.declarations`).

import {emilia, flush, Token} from "emilia";

// ── rotate ───────────────────────────────────────────────────────────────────

val rotateSteps: Token[] = [
    .Transform.Rotate.0,
    .Transform.Rotate.1,
    .Transform.Rotate.45,
    .Transform.Rotate.90,
    .Transform.Rotate.180,
];

// LANGUAGE GAP: a numeric enum leaf is declared as bare digits and there is no
// spelling for a negative one, so `-rotate-12` has no direct token. The `Neg`
// sub-section holds the magnitudes and the dispatcher prepends the sign.
val rotateNegSteps: Token[] = [
    .Transform.Rotate.Neg.1,
    .Transform.Rotate.Neg.12,
    .Transform.Rotate.Neg.45,
    .Transform.Rotate.Neg.90,
    .Transform.Rotate.Neg.180,
];

// LANGUAGE GAP: a payload leaf nested inside an enum section cannot be
// constructed by any spelling (language-gaps.md row 52), so these are TOP-LEVEL
// `Token` variants — `TransformRotateRaw`, not `Transform.Rotate.Raw`.
// Contract § 4a states the rule.
//
// LANGUAGE GAP: and even at top level, a dot-shorthand path followed by a
// payload call does not propagate the typed-array context (row 51), so every
// arbitrary value goes through a fn.
fn rawRotate(v: string) -> Token {
    return Token.TransformRotateRaw(value: v);
}

fn rawTranslate(v: string) -> Token {
    return Token.TransformTranslateRaw(value: v);
}

val oddAngle: Token[] = [rawRotate("17deg")];

// ── scale ────────────────────────────────────────────────────────────────────

val scaleSteps: Token[] = [
    .Transform.Scale.0,
    .Transform.Scale.50,
    .Transform.Scale.75,
    .Transform.Scale.90,
    .Transform.Scale.95,
    .Transform.Scale.100,
    .Transform.Scale.105,
    .Transform.Scale.110,
    .Transform.Scale.125,
    .Transform.Scale.150,
];

val scaleAxes: Token[] = [
    .Transform.ScaleX.50,
    .Transform.ScaleY.50,
];

// ── translate ────────────────────────────────────────────────────────────────
//
// Each leaf writes its own `--tw-translate-x` or `--tw-translate-y` AND the
// shared `translate:var(--tw-translate-x) var(--tw-translate-y)` shorthand, so
// a list carrying both axes composes: front 56's `Rule.declarations` keeps
// writer and reader in one rule, and front 54's theme carries the identity
// defaults so a lone axis token still renders.

val translateXSteps: Token[] = [
    .Transform.TranslateX.0,
    .Transform.TranslateX.Px,
    .Transform.TranslateX.1,
    .Transform.TranslateX.Half,
    .Transform.TranslateX.Full,
];

val translateYSteps: Token[] = [
    .Transform.TranslateY.0,
    .Transform.TranslateY.Px,
    .Transform.TranslateY.1,
    .Transform.TranslateY.Half,
    .Transform.TranslateY.Full,
];

// `TransformTranslateRaw` remains, for a translate the token set does not name.
val centred: Token[] = [rawTranslate("-50% -50%")];

// ── skew ─────────────────────────────────────────────────────────────────────
//
// FLAGGED. The reference's column names the property `skew-x` / `skew-y`, and
// neither is a registered CSS property. These tokens transcribe the reference
// faithfully and emit a declaration no browser applies. Confirm against
// https://tailwindcss.com/docs/skew before this front lands.

val skewXSteps: Token[] = [
    .Transform.SkewX.0,
    .Transform.SkewX.1,
    .Transform.SkewX.2,
    .Transform.SkewX.3,
    .Transform.SkewX.6,
    .Transform.SkewX.12,
];

val skewYSteps: Token[] = [
    .Transform.SkewY.0,
    .Transform.SkewY.1,
    .Transform.SkewY.2,
    .Transform.SkewY.3,
    .Transform.SkewY.6,
    .Transform.SkewY.12,
];

// ── transform-origin ─────────────────────────────────────────────────────────

val origins: Token[] = [
    .Transform.Origin.Center,
    .Transform.Origin.Top,
    .Transform.Origin.TopRight,
    .Transform.Origin.Right,
    .Transform.Origin.BottomRight,
    .Transform.Origin.Bottom,
    .Transform.Origin.BottomLeft,
    .Transform.Origin.Left,
    .Transform.Origin.TopLeft,
];

// ── the 3-D surface the reference actually covers ────────────────────────────
//
// `transform-style`, `backface-visibility`, `perspective` and
// `perspective-origin` are all in § 16 and all ship here. The axis variants the
// brief asks about — rotate-x/y/z, translate-z, scale-z — are NOT in § 16 and
// are not invented.

val threeD: Token[] = [
    .Transform.Style.Flat,
    .Transform.Style.Preserve3d,
    .Transform.Backface.Visible,
    .Transform.Backface.Hidden,
];

val perspectives: Token[] = [
    .Transform.Perspective.None,
    .Transform.Perspective.Dramatic,
    .Transform.Perspective.Near,
    .Transform.Perspective.Normal,
    .Transform.Perspective.Midrange,
    .Transform.Perspective.Distant,
];

val perspectiveOrigins: Token[] = [
    .Transform.PerspectiveOrigin.Center,
    .Transform.PerspectiveOrigin.Top,
    .Transform.PerspectiveOrigin.Bottom,
    .Transform.PerspectiveOrigin.Left,
    .Transform.PerspectiveOrigin.Right,
];

// ── zoom ─────────────────────────────────────────────────────────────────────

val zoomSteps: Token[] = [
    .Transform.Zoom.0,
    .Transform.Zoom.50,
    .Transform.Zoom.75,
    .Transform.Zoom.100,
    .Transform.Zoom.125,
    .Transform.Zoom.150,
    .Transform.Zoom.200,
];

// ── the transform shorthand ──────────────────────────────────────────────────
//
// These resolve: the axis tokens write the `--tw-*` variables and front 54's
// theme carries the identity defaults, so `transform-gpu` alongside a rotate
// composes the way it does upstream.

val shorthands: Token[] = [
    .Transform.Shorthand.None,
    .Transform.Shorthand.Cpu,
    .Transform.Shorthand.Gpu,
];

// ── the component ────────────────────────────────────────────────────────────
//
// A card that lifts and scales on hover, and a disclosure chevron that rotates
// 180 degrees when its panel is open. `rotate` and `scale` are independent CSS
// properties in v4, so two of them in one list compose without the shorthand.
//
// The transition tokens come from front 44; without them the motion is a single
// frame and the transform is invisible.
//
// `flush()` is `#[@future]`, so the caller must be `#[@future]` too and must
// `await` it.

fn liftCardTokens() -> Token[] {
    val lifted: Token[] = [
        .Transform.Scale.105,
        .Effect.Shadow.Xl,
    ];
    val card: Token[] = [
        .Bg.White,
        .Pad.All.4,
        .Border.Rounded.Lg,
        .Effect.Shadow.Md,
        .Transform.Origin.Center,
        .Transition.All,
        .Transition.Duration.200,
        Token.Hover(lifted),
    ];
    return card;
}

fn chevronTokens(open: bool) -> Token[] {
    val turned: Token[] = [
        .Transform.Rotate.180,
        .Transform.Origin.Center,
        .Transition.Transform,
        .Transition.Duration.150,
    ];
    val resting: Token[] = [
        .Transform.Rotate.0,
        .Transform.Origin.Center,
        .Transition.Transform,
        .Transition.Duration.150,
    ];
    val out = if (open) turned else resting;
    return out;
}

#[@future]
pub fn renderDisclosureCard(open: bool) -> @Future<string> {
    val cardCls = emilia(liftCardTokens());
    val chevronCls = emilia(chevronTokens(open));
    val styles = await flush();
    val markup = "<div class=\"" + cardCls + "\">"
        + "<span class=\"" + chevronCls + "\">v</span>"
        + "<p>Detalhes do pedido</p>"
        + "</div>";
    return markup + styles;
}
