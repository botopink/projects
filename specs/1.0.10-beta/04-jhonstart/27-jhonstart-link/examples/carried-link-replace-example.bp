// app/settings/page.bp
#[client]
import {Link} from "jhonstart";
import {Element, div, text} from "jhonstart";

pub fn SettingsPage() -> Element {
    return div([
        Link("/settings/profile", [text("Profile", attrs: [])], replace: true),
        Link("/settings/security", [text("Security", attrs: [])], replace: true),
    ], attrs: []);
}
