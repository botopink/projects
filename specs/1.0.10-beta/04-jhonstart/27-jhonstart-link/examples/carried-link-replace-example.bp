// app/settings/page.bp
// `replace` is a `LinkProps` field: the settings tabs replace the history
// entry instead of pushing one.
import {Link, linkProps, withReplace} from "jhonstart-link";
import {Element, div, text} from "jhonstart";

pub fn SettingsPage() -> Element {
    return div([
        Link(withReplace(linkProps("/settings/profile"), true), [text("Profile", attrs: [])]),
        Link(withReplace(linkProps("/settings/security"), true), [text("Security", attrs: [])]),
    ], attrs: []);
}
