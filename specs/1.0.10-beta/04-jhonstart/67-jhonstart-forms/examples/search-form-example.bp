// Front 67 — jhonstart-forms · examples/search-form-example.bp
//
// The §25 `<Form>`: a GET form whose submit becomes a client navigation to a
// path with search params, and whose target is prefetched.
//
// This is the one form where progressive enhancement costs nothing — a browser
// with no JavaScript already turns a `method="get"` form into exactly this URL.
// The hydrated path must therefore produce the SAME URL, and the test at the
// foot of this file is what holds the two together.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/components/form
//   NEXTJS-DOCS.md § 25. Component Reference — `<Form>`

import { Element, text, renderToString } from "jhonstart";
// provided by front 94 (`jhonstart-element-surface`, src/elements.bp)
import { form, input, button } from "jhonstart";
import { SearchFormProps, searchFormProps, searchFormAttrs } from "jhonstart";
import { querystring } from "std";

// The URL the browser's own GET submit produces, written as a function so the
// hydrated navigation can be asserted against it.
fn searchUrl(action: string, fields: Array<#(string, string)>) -> string {
    val query = querystring.stringify(fields);
    if (query == "") return action;
    return action + "?" + query;
}

fn searchForm(props: SearchFormProps) -> Element {
    return form([
        input([], attrs: [#("name", "q"), #("type", "search"), #("placeholder", "Search")]),
        button([text("Search", attrs: [])], attrs: [#("type", "submit")]),
    ], attrs: searchFormAttrs(props));
}

fn SearchForm() -> Element {
    return searchForm(searchFormProps("/search"));
}

// ── tests ────────────────────────────────────────────────────────────────────

test "a search form is a GET form and is not claimed by the action interceptor" {
    val markup = renderToString(searchForm(searchFormProps("/search")));
    assert markup.contains("method=\"get\"");
    assert markup.contains("action=\"/search\"");
    assert markup.contains("data-onze-a") == false;
    assert markup.contains("data-onze-sf=\"1\"");
}

test "the hydrated navigation target equals the URL a plain GET submit produces" {
    val fields = [#("q", "botopink")];
    assert searchUrl("/search", fields) == "/search?q=botopink";
}

test "an empty form navigates to the bare path, not to a trailing question mark" {
    assert searchUrl("/search", []) == "/search";
}
