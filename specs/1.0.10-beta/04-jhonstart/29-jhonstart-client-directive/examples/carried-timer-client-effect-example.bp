// components/timer.bp
// `effect(setup: fn(), deps)` — the setup runs in the browser only; on the
// server pass `effect` is a no-op.
import {Element, ElementBase, div, p, text} from "jhonstart";
import {client, state, effect} from "jhonstart";

#[client]
pub fn Timer() -> @Component<ElementBase, Element> {
    val seconds = use state(0);
    val ticking = use effect({ ->
        setInterval({ ->
            seconds.set(seconds.value + 1);
        }, 1000);
    }, []);
    return div([
        p([text("Time: " + seconds.value.toString() + "s", attrs: [])], attrs: []),
    ], attrs: []);
}
