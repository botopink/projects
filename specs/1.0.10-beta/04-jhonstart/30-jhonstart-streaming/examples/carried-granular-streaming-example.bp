// app/dashboard/page.bp
import {Element, div, h1, Suspense, text} from "jhonstart";

pub fn DashboardPage() -> @Component<ElementBase, Element> {
    return div([
        h1([text("Dashboard", attrs: [])], attrs: []),
        div([
            Suspense(SuspenseProps(
                fallback: div([text("Loading stats...", attrs: [])], attrs: []),
                children: [await StatsPanel()],
            )),
        ], attrs: []),
        div([
            Suspense(SuspenseProps(
                fallback: div([text("Loading data...", attrs: [])], attrs: []),
                children: [await DataTable()],
            )),
        ], attrs: []),
    ], attrs: []);
}
