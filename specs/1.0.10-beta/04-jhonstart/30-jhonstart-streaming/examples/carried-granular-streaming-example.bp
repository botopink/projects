// app/dashboard/page.bp
import {Element, ElementBase, PageContext, div, h1, text} from "jhonstart";
import {Boundary, Suspense, holeId} from "jhonstart";

#[page("dashboard")]
pub fn DashboardPage(route: PageContext) -> @Component<ElementBase, Element> {
    return div([
        h1([text("Dashboard", attrs: [])], attrs: []),
        div([
            Suspense(Boundary(
                id: holeId(1),
                fallback: div([text("Loading stats...", attrs: [])], attrs: []),
                child: { -> StatsPanel() },
            )),
        ], attrs: []),
        div([
            Suspense(Boundary(
                id: holeId(2),
                fallback: div([text("Loading data...", attrs: [])], attrs: []),
                child: { -> DataTable() },
            )),
        ], attrs: []),
    ], attrs: []);
}
