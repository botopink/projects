// app/blog/page.bp
import {Element, ElementBase, PageContext, div, h1, text} from "jhonstart";
import {Boundary, Suspense, holeId} from "jhonstart";

#[page("blog")]
pub fn BlogPage(route: PageContext) -> @Component<ElementBase, Element> {
    return div([
        h1([text("Blog", attrs: [])], attrs: []),
        Suspense(Boundary(
            id: holeId(1),
            fallback: div([text("Loading posts...", attrs: [])], attrs: []),
            child: { -> PostList() },
        )),
    ], attrs: []);
}
