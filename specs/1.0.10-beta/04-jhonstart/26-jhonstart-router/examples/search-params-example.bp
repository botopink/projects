// Front 26 — jhonstart-router · examples/search-params-example.bp
//
// A product toolbar that reads the sort order out of the query string and
// rewrites the URL when the reader changes it.
//
// The URL arithmetic is pure and runs on the SERVER during the first render
// (`searchParams` reads the snapshot front 23 filled). `replace` is the one
// dual-target call: on erlang it records a redirect, in the browser it is
// `history.replaceState` followed by a re-render with no reload — the shape
// NEXTJS-DOCS.md § 8 calls *History API nativa*.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/functions/use-search-params
//   https://nextjs.org/docs/app/api-reference/functions/use-router

import { Element, div, span, text, renderToString } from "jhonstart";
import { searchParams, pairValue, replace } from "jhonstart";
import { Link, linkProps } from "jhonstart";
import { querystring } from "std";

// Build the href for a sort order, keeping every other query parameter. The
// pair list is the same `Array<#(string, string)>` the snapshot carries, so
// `querystring.stringify` is the only encoder involved on either side.
fn sortHref(current: Array<#(string, string)>, order: string) -> string {
    val kept = current.filter({ p -> p._0 != "sort" });
    val next = kept.append([#("sort", order)]);
    return "?" + querystring.stringify(next);
}

// The label shown for the order currently in the URL.
fn orderLabel(order: string) -> string {
    return case order {
        "asc" -> "price, low to high";
        "desc" -> "price, high to low";
        _ -> "relevance";
    };
}

// The toolbar as a server-rendered component.
#[@context]
fn ProductToolbar() -> Element {
    val search = use searchParams();
    val order = pairValue(search, "sort");
    return div([
        span([text("Sorted by " + orderLabel(order), attrs: [])], attrs: [#("class", "toolbar-label")]),
        Link(linkProps(sortHref(search, "asc")), [text("Low to high", attrs: [])]),
        Link(linkProps(sortHref(search, "desc")), [text("High to low", attrs: [])]),
    ], attrs: [#("class", "toolbar")]);
}

// The programmatic form, for a client component that changes the order without
// a full navigation. `replace` keeps the reader's back button clean: reversing
// a sort should not need three presses to undo.
pub fn applySort(search: Array<#(string, string)>, order: string) -> i32 {
    return replace(sortHref(search, order));
}

test "changing the sort keeps every other query parameter" {
    val current = querystring.parse("q=boots&page=2&sort=asc");
    assert sortHref(current, "desc") == "?q=boots&page=2&sort=desc";
}

test "a URL with no sort yet gains one" {
    val current = querystring.parse("q=boots");
    assert sortHref(current, "asc") == "?q=boots&sort=asc";
}

test "an unknown order falls back to the relevance label" {
    assert orderLabel("") == "relevance";
    assert orderLabel("asc") == "price, low to high";
}
