// components/login-form.bp
// A client component that navigates programmatically: `use router()` under a
// `@Component<ElementBase, Element>` return; the binding never reuses the
// hook's name.
import {router} from "jhonstart";
import {Element, ElementBase, form, input, button, text} from "jhonstart";

#[client]
pub fn LoginForm() -> @Component<ElementBase, Element> {
    val r = use router();
    return form([
        input([], attrs: [#("type", "email"), #("name", "email")]),
        button([text("Sign in", attrs: [])], attrs: [
            #("onClick", "handleLogin"),
        ]),
    ], attrs: [#("action", "/api/login")]);
}
