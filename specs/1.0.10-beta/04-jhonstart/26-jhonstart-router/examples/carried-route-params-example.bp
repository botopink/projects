// app/blog/[slug]/page.bp
// `use router()` binding `r`; a route parameter is read with `r.param(name)`,
// `""` when absent.
import {router} from "jhonstart";
import {Element, ElementBase, div, h1, text} from "jhonstart";

pub fn BlogPost() -> @Component<ElementBase, Element> {
    val r = use router();
    val slug = r.param("slug");
    return div([
        h1([text("Post: " + slug, attrs: [])], attrs: []),
    ], attrs: []);
}
