// app/blog/[slug]/not-found.bp — jhonstart only (decision 114, item 6): the
// styled version of this file, with an emilia class, is an onze example.
import {Element, div, h2, p, text} from "jhonstart";
import {Link} from "jhonstart";

pub fn NotFound() -> Element {
    return div([
        h2([text("Post not found", attrs: [])], attrs: []),
        p([text("The post you are looking for does not exist.", attrs: [])], attrs: []),
        Link("/blog", [text("Back to the blog", attrs: [])]),
    ], attrs: [#("class", "not-found")]);
}
