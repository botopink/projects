// Front 31 — jhonstart-error-boundaries · examples/not-found-example.bp
//
// A `not-found.bp`, and the reason a boundary must let navigation signals
// through instead of swallowing them.
//
// A 404 travels the same `@Result` channel as a real failure — `throw` is the
// only way to abort a render. So a boundary that caught everything would turn
// every missing post into "something went wrong" and every redirect into a
// fallback page. `renderBoundaryChecked` re-raises anything `isSignal`
// recognises; front 30's render turns it into a 404 (the not-found document) or
// a 307 before its first chunk, and into markup after it (decision 117).
//
// `notFound()` is jhonstart's own (front 31, `error_boundary.bp`): it builds the
// `nav:not-found` signal string of `contracts.md § 5b` with the bundled library
// `routing`'s `navigation.signalReason` (decision 116), and jhonstart imports
// nothing from rakun (decision 113).
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/file-conventions/not-found
//   https://nextjs.org/docs/app/getting-started/error-handling

import { Element, div, p, text, renderToString } from "jhonstart";
import { ErrorInfo, ErrorBoundary, catchError, renderBoundaryChecked, isSignal } from "jhonstart";
import { Link, linkProps } from "jhonstart";
import { section, h2 } from "jhonstart";
import { notFound } from "jhonstart";

// `section` and `h2` come from front 94 (jhonstart-element-surface). `Link`/`linkProps` are front 27's; `notFound` is
// front 31's and builds the signal string — the caller writes the `throw`.
//
// The page names only jhonstart, and jhonstart alone handles the signal: onze
// only adapts rakun's response to jhonstart's `Response`.

// ── what the developer writes: app/blog/[slug]/not-found.bp ─────────────────

pub fn NotFound() -> Element {
    return section([
        h2([text("Post not found", attrs: [])], attrs: []),
        p([text("It may have been unpublished.", attrs: [])], attrs: []),
        Link(linkProps("/blog"), [text("Back to the blog", attrs: [])]),
    ], attrs: [#("class", "not-found")]);
}

// ── what the developer writes: the page ────────────────────────────────────

pub type Post(slug: string, title: string)

#[@External.Erlang("blog_repo", "post_by_slug")]
declare fn postRow(slug: string) -> string;

#[@result]
fn PostPanel(slug: string) -> @Result<Element, string> {
    val raw = postRow(slug);
    if (raw == "") { throw notFound(); };
    return div([text(raw, attrs: [])], attrs: [#("class", "post")]);
}

// ── the boundary ───────────────────────────────────────────────────────────

fn fallbackFor(info: ErrorInfo) -> Element {
    return section([
        h2([text("Something went wrong", attrs: [])], attrs: []),
        p([text("Reference " + info.digest, attrs: [])], attrs: [#("class", "digest")]),
    ], attrs: [#("class", "error")]);
}

pub fn postBoundary(slug: string) -> ErrorBoundary {
    return catchError("blog.slug.page", fallbackFor, { ->
        PostPanel(slug);
    });
}

// ── stubs ──────────────────────────────────────────────────────────────────

#[@result]
fn signallingPanel() -> @Result<Element, string> {
    throw notFound();
}

#[@result]
fn failingPanel() -> @Result<Element, string> {
    throw "the database is on fire";
}

fn boundaryOver(child: fn() -> @Result<Element, string>) -> ErrorBoundary {
    return catchError("blog.slug.page", fallbackFor, child);
}

test "a not-found signal is recognised as a signal" {
    assert isSignal("nav:not-found");
    assert isSignal("nav:redirect:/login");
    assert isSignal("nav:") == false;
    assert isSignal("the database is on fire") == false;
}

test "a signal passes through the boundary uncaught" {
    val outcome = renderBoundaryChecked(boundaryOver(signallingPanel));
    assert outcome.isError();
}

test "an ordinary failure is caught and becomes the fallback" {
    val outcome = renderBoundaryChecked(boundaryOver(failingPanel));
    assert outcome.isOk();
}

test "the not-found page links back to the index" {
    val markup = renderToString(NotFound());
    assert markup.contains("Post not found");
    assert markup.contains("href=\"/blog\"");
}
