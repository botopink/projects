// app/blog/error.bp
#[client]
import {Element, div, h2, p, button, text} from "jhonstart";

pub fn Error(error: string, retry: fn()) -> Element {
    return div([
        h2([text("Something went wrong!", attrs: [])], attrs: []),
        p([text(error, attrs: [])], attrs: []),
        button([text("Try again", attrs: [])], attrs: [
            #("onClick", "retry"),
        ]),
    ], attrs: []);
}
