// app/blog/[slug]/page.bp
import {Element, ElementBase, PageContext, ctxParam, div, h1, text} from "jhonstart";
import {notFound} from "jhonstart";

#[page("blog/[slug]")]
pub fn BlogPost(route: PageContext) -> @Component<ElementBase, Element> {
    val slug = ctxParam(route, "slug");
    val title = await postTitle(slug);   // "" when there is no such post
    if (title == "") {
        notFound();
    };
    return div([
        h1([text(title, attrs: [])], attrs: []),
    ], attrs: []);
}
