// NOTE: 32 spells the static export `pub fn metadata() -> Metadata`, `OpenGraph.type` as `ogType`,
// `OpenGraph` with `siteName` and `Metadata` with `titleTemplate`; this example keeps the older shape.

// app/about/page.bp
import {Element, div, h1, p, text} from "jhonstart";
import {Metadata} from "jhonstart";

pub val metadata: Metadata = Metadata(
    title: "About Us — My Company",
    description: "Learn more about our company.",
    openGraph: OpenGraph(
        title: "About Us",
        description: "Our mission is to transform the world.",
        images: ["/og/about.png"],
        url: "/about",
        type: "website",
    ),
    twitter: TwitterCard(
        card: "summary_large_image",
        title: "About Us",
        description: "Get to know our company.",
        images: ["/og/about.png"],
    ),
    icons: Icons(icon: "/favicon.ico", apple: "/apple-icon.png"),
);

pub fn AboutPage() -> Element {
    return div([
        h1([text("About Us", attrs: [])], attrs: []),
        p([text("We are a technology company.", attrs: [])], attrs: []),
    ], attrs: []);
}
