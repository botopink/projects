// app/about/page.bp
import {Element, ElementBase, PageContext, div, h1, p, text} from "jhonstart";
import {Metadata, OpenGraph, TwitterCard, Icons} from "jhonstart";

pub fn metadata() -> Metadata {
    return Metadata(
        title: "About Us — My Company",
        titleTemplate: "",
        description: "Learn more about our company.",
        openGraph: OpenGraph(
            title: "About Us",
            description: "Our mission is to transform the world.",
            url: "/about",
            ogType: "website",
            siteName: "",
            images: ["/og/about.png"],
        ),
        twitter: TwitterCard(
            card: "summary_large_image",
            title: "About Us",
            description: "Get to know our company.",
            images: ["/og/about.png"],
        ),
        icons: Icons(icon: "/favicon.ico", apple: "/apple-icon.png"),
    );
}

#[page("about")]
pub fn AboutPage(route: PageContext) -> @Component<ElementBase, Element> {
    return div([
        h1([text("About Us", attrs: [])], attrs: []),
        p([text("We are a technology company.", attrs: [])], attrs: []),
    ], attrs: []);
}
