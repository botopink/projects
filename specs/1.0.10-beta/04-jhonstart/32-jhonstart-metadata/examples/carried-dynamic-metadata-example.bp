// NOTE: 32 spells `generateMetadata(params: Array<#(string, string)>, parent)` with `pairValue`,
// `OpenGraph.type` as `ogType`, and every field (no optionals); this example keeps the older shape.

// app/blog/[slug]/page.bp
import {Element, div, h1, p, text} from "jhonstart";
import {Metadata} from "jhonstart";
import {collections.Dict} from "std";

pub fn generateMetadata(params: Dict<string, string>) -> @Task<Metadata> {
    val slug = params.get("slug");
    val post = await fetchPost(slug);
    return Metadata(
        title: post.title + " — Blog",
        description: post.excerpt,
        openGraph: OpenGraph(
            title: post.title,
            description: post.excerpt,
            images: ["/og/blog/" + slug + ".png"],
            url: "/blog/" + slug,
            type: "article",
        ),
        twitter: TwitterCard(
            card: "summary_large_image",
            title: post.title,
            description: post.excerpt,
            images: [],
        ),
        icons: Icons(icon: "/favicon.ico", apple: ""),
    );
}

pub fn BlogPost(params: Dict<string, string>) -> @Component<ElementBase, Element> {
    val slug = params.get("slug");
    val post = await fetchPost(slug);
    return div([
        h1([text(post.title, attrs: [])], attrs: []),
        p([text(post.content, attrs: [])], attrs: []),
    ], attrs: []);
}
