// app/blog/[slug]/page.bp
import {Element, ElementBase, PageContext, ctxParam, div, h1, p, text} from "jhonstart";
import {Metadata, OpenGraph, TwitterCard, Icons, pairValue} from "jhonstart";

pub fn generateMetadata(params: Array<#(string, string)>) -> @Task<Metadata> {
    val slug = pairValue(params, "slug");
    val post = await fetchPost(slug);
    return Metadata(
        title: post.title + " — Blog",
        titleTemplate: "",
        description: post.excerpt,
        openGraph: OpenGraph(
            title: post.title,
            description: post.excerpt,
            url: "/blog/" + slug,
            ogType: "article",
            siteName: "",
            images: ["/og/blog/" + slug + ".png"],
        ),
        twitter: TwitterCard(
            card: "summary_large_image",
            title: post.title,
            description: post.excerpt,
            images: [],
        ),
        icons: Icons(icon: "/favicon.ico", apple: ""),
    );
}

#[page("blog/[slug]")]
pub fn BlogPost(route: PageContext) -> @Component<ElementBase, Element> {
    val post = await fetchPost(ctxParam(route, "slug"));
    return div([
        h1([text(post.title, attrs: [])], attrs: []),
        p([text(post.content, attrs: [])], attrs: []),
    ], attrs: []);
}
