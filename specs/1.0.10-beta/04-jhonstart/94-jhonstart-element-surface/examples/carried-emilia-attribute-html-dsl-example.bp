// NOTE: `html.bp` is frozen and has no `[emilia]` attribute; the class goes through the
// existing `[class]={c}` hole with `c` pre-bound via front 48's `cls(tokens, th)`. This example keeps the older shape.

import {html, renderToString} from "jhonstart";

val page = html """
<div [emilia]={[.Pad.All.8, .Bg.Gray100]}>
  <h1 [emilia]={[.Text.Size.X3xl, .Text.Bold]}>Title</h1>
  <p [emilia]={[.Text.Size.Base, .Color.Gray500]}>Description</p>
  <button [emilia]={[.Pad.X.4, .Pad.Y.2, .Bg.Blue500, .Hover([.Bg.Blue700])]}>
    Click here
  </button>
</div>
""";
