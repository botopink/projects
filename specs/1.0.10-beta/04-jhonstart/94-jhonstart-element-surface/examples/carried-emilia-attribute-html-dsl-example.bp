// An emilia class reaches the markup through the `[class]={c}` hole: `html.bp` has
// no `[emilia]` attribute, and a hole may not contain a space, so each class is
// bound to a `val` first with emilia's `cls(tokens, th)` (front 48).

import {html} from "jhonstart-html";
import {div, h1, p, button, text, renderToString} from "jhonstart";
import {Token, cls, defaultTheme} from "emilia";

val th = defaultTheme();
val cardTokens: Token[] = [.Pad.All.8, .Bg.Gray100];
val titleTokens: Token[] = [.Text.Size.X3xl, .Text.Bold];
val bodyTokens: Token[] = [.Text.Size.Base, .Color.Gray500];
val buttonTokens: Token[] = [.Pad.X.4, .Pad.Y.2, .Bg.Blue500, .Hover([.Bg.Blue700])];

val cardClass = cls(cardTokens, th);
val headingClass = cls(titleTokens, th);
val bodyClass = cls(bodyTokens, th);
val actionClass = cls(buttonTokens, th);

val page = html """
<div [class]={cardClass}>
  <h1 [class]={headingClass}>Title</h1>
  <p [class]={bodyClass}>Description</p>
  <button [class]={actionClass}>Click here</button>
</div>
""";
