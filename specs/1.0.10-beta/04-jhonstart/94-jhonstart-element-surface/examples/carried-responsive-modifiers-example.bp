// NOTE: the frozen `html.bp` has no `[emilia]` attribute; bind `cls(tokens, th)` to a `val`
// and use `[class]={c}`. This example keeps the older shape.

val card = html """
<div [emilia]={[.Pad.All.4, .Md([.Pad.All.8]), .Lg([.Pad.All.16])]}>
  <h2 [emilia]={[.Text.Size.Xl, .Md([.Text.Size.X2xl]), .Lg([.Text.Size.X3xl])]}>
    Responsive
  </h2>
</div>
""";
