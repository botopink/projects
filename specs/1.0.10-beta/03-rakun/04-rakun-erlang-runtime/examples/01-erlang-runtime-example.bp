// carried from specs/1.0.6-beta/examples/01-erlang-runtime-example.bp
//// F01 — Erlang Runtime: Exemplo de aplicação rodando no BEAM
////
//// Este exemplo demonstra o Rakun rodando em Erlang/BEAM usando cowboy como HTTP server.
//// Documentação Spring Boot: https://docs.spring.io/spring-boot/reference/web/servlet.html#web.servlet.embedded-container
////
//// O runtime.erl implementa toda a infraestrutura de DI, router e HTTP server
//// usando ETS tables para estado mutável e cowboy para o servidor HTTP.

import {Rakun, App, Request, Response} from "rakun";
import {service, restController, route, getMapping, postMapping} from "rakun";
import {rkScan, rkSingleton, rkEnter, rkDone, rkRegisterRoute} from "rakun";

// ── Service: lógica de negócio ──────────────────────────────────────────────
#[service]
pub type GreetingService {
    pub fn greet(self: Self, name: string) -> string {
        return "Hello, " + name + "! (from BEAM 🚀)";
    }
}

// ── Repository: acesso a dados (mock) ───────────────────────────────────────
#[repository]
pub type UserRepository {
    pub fn findAll(self: Self) -> Array<string> {
        return ["alice", "bob", "charlie"];
    }

    pub fn findById(self: Self, id: string) -> ?string {
        val users = self.findAll();
        return users.find({ u -> u == id });
    }
}

// ── Controller: endpoints HTTP ──────────────────────────────────────────────
#[restController]
#[route("/api")]
pub type GreetingController(service: GreetingService, repo: UserRepository) {
    #[getMapping("/hello/:name")]
    pub fn hello(self: Self, req: Request) -> Response {
        val name = req.param("name");
        return Response.ok(self.service.greet(name));
    }

    #[getMapping("/users")]
    pub fn listUsers(self: Self, req: Request) -> Response {
        val users = self.repo.findAll();
        return Response.json(users.join(", "));
    }

    #[getMapping("/users/:id")]
    pub fn getUser(self: Self, req: Request) -> Response {
        val id = req.param("id");
        val user = self.repo.findById(id);
        return match user {
            @Ok(u) => Response.ok("User: " + u),
            @Err(_) => Response.notFound(),
        };
    }
}

// ── Bootstrap: inicia o servidor ────────────────────────────────────────────
fn main() {
    // Em Erlang, isso inicia cowboy na porta 8080
    // O runtime.erl cuida de:
    // - ETS tables para DI registry, singleton cache, router
    // - cowboy para HTTP server
    // - Pattern matching para rotas com :params
    Rakun.run(App(port: 8080, basePath: "/api"));
}

