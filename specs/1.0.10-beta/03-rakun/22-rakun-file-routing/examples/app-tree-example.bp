// Front 22 — rakun file routing.
//
// A realistic `app/` tree, and the `layout.bp` / `page.bp` bodies that populate it.
// Everything below runs on BEAM: a layout and a page are server render functions.
// The route table they build is the one artifact that also reaches the browser.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/project-structure
//   https://nextjs.org/docs/app/getting-started/layouts-and-pages
//   https://nextjs.org/docs/app/api-reference/file-conventions/dynamic-routes
//   https://nextjs.org/docs/app/api-reference/file-conventions/route-groups
//
// The tree this file stands in for — `appDir` is config (front 05), so it is
// `app/` or `src/app/`, and the decorator argument is relative to whichever:
//
//   app/
//   |-- layout.bp                 -> #[layout("")]                  wraps everything
//   |-- page.bp                   -> #[page("")]                    /
//   |-- blog/
//   |   |-- layout.bp             -> #[layout("blog")]              wraps /blog and below
//   |   |-- page.bp               -> #[page("blog")]                /blog
//   |   |-- [slug]/
//   |   |   `-- page.bp           -> #[page("blog/[slug]")]         /blog/:slug
//   |   `-- _drafts/              private: skipped by the scan, never registered
//   `-- (marketing)/
//       `-- about/
//           `-- page.bp           -> #[page("(marketing)/about")]   /about
//
// Each of those files is one botopink module; the CLI (front 50) generates the
// `pub mod` lines and the decorator argument from the file's own location, and
// fails the scan when the two disagree. They are gathered into one file here so
// the example is one compilable unit.

import {Element, bracketPair, div, h1, p, ul, li, text} from "jhonstart";
import {page, layout, PageContext, LayoutProps} from "rakun";
// The module carrying decorated declarations must also import the registry cells
// the `@emit`ted wiring calls by name — the same rule as rakun's `rkScan`/`rkSingleton`.
import {rkAppRegisterPage, rkAppRegisterLayout, rkAppTable} from "rakun";

// LANGUAGE GAP: `@Decl` carries no source location, so a decorator cannot read the file it
// annotates; the app-relative directory has to be passed as an argument. With `decl.source()`
// these would all be a bare `#[page]` / `#[layout]`.
// LANGUAGE GAP: declared parameter defaults are never applied, so every constructor call below
// writes `attrs:` even though `element.bp` declares a default for it.

// ---- app/layout.bp — the root layout ------------------------------------------
//
// The root layout is the one segment every request passes through. `props.children`
// is the subtree the router already rendered: the next layout down, or the page.

#[layout("")]
pub fn rootLayout(props: LayoutProps) -> Element {
    val header = div([h1([text("onze", attrs: [])], attrs: [])], attrs: [
        bracketPair("data-onze-chrome", "header"),
    ]);
    return div([header, props.children], attrs: [bracketPair("data-onze-root", "")]);
}

// ---- app/blog/layout.bp — a segment layout ------------------------------------
//
// Wraps /blog and everything under it. It is NOT re-rendered when the client
// navigates between two routes that share it — that is the difference between
// `layout.bp` and `template.bp`, and front 23 owns the distinction.

#[layout("blog")]
pub fn blogLayout(props: LayoutProps) -> Element {
    val crumb = p([text("Blog", attrs: [])], attrs: []);
    return div([crumb, props.children], attrs: [bracketPair("data-onze-seg", "blog")]);
}

// ---- app/page.bp — the home page ----------------------------------------------
//
// Every page is `#[@future]`: the registry pins one shape, so the pipeline in
// front 23 has one shape to drive. A page that needs no data awaits nothing and
// costs nothing.

#[@future]
fn recentSlugs() -> @Future<string[]> {
    return ["hello-world", "beam-renders-the-server"];
}

#[page("")]
#[@future]
pub fn homePage(route: PageContext) -> @Future<Element> {
    val slugs = await recentSlugs();
    val items = slugs.map({ s -> li([text(s, attrs: [])], attrs: []) });
    return div([
        h1([text("Recent posts", attrs: [])], attrs: []),
        ul(items, attrs: []),
    ], attrs: []);
}

// ---- app/blog/page.bp — the blog index ----------------------------------------

#[page("blog")]
#[@future]
pub fn blogIndexPage(route: PageContext) -> @Future<Element> {
    val slugs = await recentSlugs();
    val items = slugs.map({ s -> li([text(s, attrs: [])], attrs: []) });
    return ul(items, attrs: [bracketPair("data-onze-list", "posts")]);
}

// ---- app/blog/[slug]/page.bp — a dynamic segment ------------------------------
//
// `blogPostPageParams` is emitted by the `#[page]` decorator from the bracket
// segments of its own argument — the `PageProps<'/blog/[slug]'>` equivalent. It is
// visible under `botopink test` and `botopink build`; `botopink check` skips
// decorator invocation and will report it unbound.

#[@future]
fn postBody(slug: string) -> @Future<string> {
    return "The body of " + slug + ", loaded on the server.";
}

#[page("blog/[slug]")]
#[@future]
pub fn blogPostPage(route: PageContext) -> @Future<Element> {
    val params = blogPostPageParams(route);
    val body = await postBody(params.slug);
    return div([
        h1([text(params.slug, attrs: [])], attrs: []),
        p([text(body, attrs: [])], attrs: []),
    ], attrs: [bracketPair("data-onze-seg", "post")]);
}

// ---- app/(marketing)/about/page.bp — a route group ----------------------------
//
// `(marketing)` is transparent to the URL: this page answers `/about`, not
// `/marketing/about`. The group still owns its own layout subtree, which is how
// `§ 5. Multiple Root Layouts` is expressed.

#[page("(marketing)/about")]
#[@future]
pub fn aboutPage(route: PageContext) -> @Future<Element> {
    return div([
        h1([text("About", attrs: [])], attrs: []),
        p([text("Rendered on BEAM, like every page in this tree.", attrs: [])], attrs: []),
    ], attrs: []);
}

// ---- what the five registrations above produce --------------------------------

test "the app tree registers one route-table record per convention file" {
    val wire = rkAppTable();
    val lines = wire.split("\n");
    assert lines.contains("L|/||");
    assert lines.contains("L|/blog||");
    assert lines.contains("P|/||");
    assert lines.contains("P|/blog||");
    assert lines.contains("P|/blog/[slug]||");
    assert lines.contains("P|/about||");
}

test "a group segment is absent from every pattern it encloses" {
    val wire = rkAppTable();
    assert wire.contains("(marketing)") == false;
}
