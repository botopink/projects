// Front 23 — rakun SSR pipeline: the page dispatch.
//
// rakun matches the route, opens the request scope with the `Render` phase set,
// calls the page-render function onze handed it at boot, and writes the chunks
// that function returns. It builds no HTML and imports nothing from jhonstart,
// emilia or onze (decision 113): in an application the function below is
// installed by onze and its chunks are rendered by jhonstart front 30. Here a
// stub stands in for it, so every assertion is about dispatch, scope, status
// and bytes — never about markup.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/layouts-and-pages
//   https://nextjs.org/docs/app/api-reference/file-conventions/loading
//
// LANGUAGE GAP: declared parameter defaults are never applied, so every
// `RenderedPage(...)` below passes all three fields.

// NOTE: front 22's `rkAppRegisterPage` takes a render function typed over
// jhonstart's `Element`, which rakun cannot name under decision 113; the
// pattern-only registration it needs is not specified yet. `rkAppRegisterPattern`
// below stands for it.
// `PageContext` and `rkAppRegisterPattern` are front 22's; `RenderedPage`,
// `setPageRender`, `servePage` and `toResponse` are this front's; `requestPhase`
// and `RequestPhase` are front 62's.
import {PageContext, rkAppRegisterPattern} from "rakun";
import {RenderedPage, setPageRender, servePage, toResponse} from "rakun";
import {requestPhase, RequestPhase} from "rakun";

// ---- the stand-in for onze's render function ------------------------------------
//
// It records the phase it ran under and returns three fixed chunks: the shell,
// one fill, the tail. rakun never looks inside them.

var phaseSeen: string = "";

#[@future]
fn stubRender(ctx: PageContext) -> @Future<RenderedPage> {
    phaseSeen = if (requestPhase() == RequestPhase.Render) { "render" } else { "other" };
    return RenderedPage(
        status: 200,
        headers: [#("Content-Type", "text/html; charset=utf-8")],
        chunks: ["<shell " + ctx.pattern + ">", "<fill h1>", "<tail>"],
    );
}

fn install() -> void {
    rkAppRegisterPattern("/blog/[slug]");
    setPageRender({ ctx -> stubRender(ctx) });
}

// ---- what the dispatch does ------------------------------------------------------

test "a matched page is written as the chunks the render function returned" {
    install();
    val page = await servePage("/blog/hello", "");
    assert page.status == 200;
    assert page.chunks.join("|") == "<shell /blog/[slug]>|<fill h1>|<tail>";
}

test "the render function runs under the Render phase" {
    install();
    val page = await servePage("/blog/hello", "");
    assert phaseSeen == "render";
}

test "a url with no page answers 404 without rendering" {
    install();
    phaseSeen = "";
    val page = await servePage("/nowhere", "");
    assert page.status == 404;
    assert phaseSeen == "";
}

test "the non-streaming path joins the chunks into one body" {
    install();
    val page = await servePage("/blog/hello", "");
    val res = toResponse(page);
    assert res.body == "<shell /blog/[slug]><fill h1><tail>";
}
