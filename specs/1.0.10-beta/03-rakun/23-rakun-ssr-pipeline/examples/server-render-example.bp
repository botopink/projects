// Front 23 — rakun SSR pipeline: the page dispatch.
//
// rakun matches the route, opens the request scope with the `Render` phase set,
// calls the renderer registered for the matched pattern with the request and a
// `ChunkWriter`, and closes the response when the renderer's future resolves.
// It builds no HTML and imports nothing from jhonstart, emilia or onze
// (decisions 113, 114): in an application the renderer is registered by onze
// and its chunks are rendered by jhonstart front 30. Here a renderer that writes
// plain text stands in for it, so every assertion is about dispatch, scope,
// status and bytes — never about markup.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/layouts-and-pages
//   https://nextjs.org/docs/app/api-reference/file-conventions/loading

// `ChunkWriter`, `PageRenderer`, `page` and `servePage` are this front's;
// `notFound` is front 63's; `requestPhase` and `RequestPhase` are front 62's;
// `Request` is front 04's; `fakeGet` is front 19's request double.
import {ChunkWriter, PageRenderer, page, servePage} from "rakun";
import {notFound} from "rakun";
import {requestPhase, RequestPhase, Request} from "rakun";
import {fakeGet} from "rakun-test";

// ---- a recording ChunkWriter -------------------------------------------------------
//
// The socket stand-in: it records what the dispatch wrote and how many times it
// closed the response.

var written: string[] = [];
var closes: i32 = 0;

fn recorder() -> ChunkWriter {
    written = [];
    closes = 0;
    return ChunkWriter(
        write: fn(chunk: string) { written.push(chunk); },
        close: fn() { closes = closes + 1; },
    );
}

// ---- the stand-in renderers ----------------------------------------------------------
//
// The first records the phase it ran under and writes three fixed chunks: the
// shell, one fill, the tail. rakun never looks inside them.

var phaseSeen: string = "";

#[@future]
fn stubRender(req: Request, out: ChunkWriter) -> @Future<void> {
    phaseSeen = if (requestPhase() == RequestPhase.Render) { "render" } else { "other" };
    await out.write("<shell " + req.param("slug") + ">");
    await out.write("<fill h1>");
    await out.write("<tail>");
}

#[@future]
fn missingRender(req: Request, out: ChunkWriter) -> @Future<void> {
    val _gone = notFound();
    await out.write("never written");
}

val _post = page("blog/[slug]", stubRender);
val _gone = page("gone", missingRender);

// ---- what the dispatch does ------------------------------------------------------------

test "a matched page is written as the chunks the renderer wrote" {
    val status = await servePage(fakeGet("/blog/hello"), recorder());
    assert status == 200;
    assert written.join("|") == "<shell hello>|<fill h1>|<tail>";
}

test "the dispatch closes the response once, after the renderer resolves" {
    val _status = await servePage(fakeGet("/blog/hello"), recorder());
    assert closes == 1;
}

test "the renderer runs under the Render phase" {
    val _status = await servePage(fakeGet("/blog/hello"), recorder());
    assert phaseSeen == "render";
}

test "a url with no page answers 404 without rendering" {
    phaseSeen = "";
    val status = await servePage(fakeGet("/nowhere"), recorder());
    assert status == 404;
    assert phaseSeen == "";
    assert written.length == 0;
}

test "a not-found raised before the first write answers 404" {
    val status = await servePage(fakeGet("/gone"), recorder());
    assert status == 404;
    assert written.length == 0;
}
