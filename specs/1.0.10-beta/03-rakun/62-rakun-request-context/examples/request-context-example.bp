// Front 62 — Rakun Request Context
//
// What this demonstrates: reading a session cookie from a page renderer,
// writing a cookie from a server action, deferring work past the response, and
// reading a request header from a route handler. Every function in this file runs
// on the BEAM while a request is in flight. Nothing here compiles for the browser.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/functions/cookies
//   https://nextjs.org/docs/app/api-reference/functions/headers
//   https://nextjs.org/docs/app/api-reference/functions/after
//   https://nextjs.org/docs/app/guides/authentication

import {cookies, headers, after, CookieAttrs} from "rakun";
import {page, ChunkWriter} from "rakun";                       // provided by front 23
import {action} from "rakun";                                  // provided by front 24
import {getRoute} from "rakun";                                // provided by front 25
import {redirect} from "rakun";                                // provided by front 63
import {Request, Response} from "rakun";

// SERVER — the auth guard of NEXTJS-DOCS.md § 23, on a page renderer (front 23).
// The renderer reads the cookie out of the request frame this front
// establishes; a missing session raises front 63's redirect before the first
// write, so the dispatch answers 307. Reading a cookie marks the render
// dynamic, so front 60 will not prerender this route, and `dynamicReason()`
// answers "cookies" in the build report. In an application the renderer is
// the one onze registers and the markup is jhonstart's (onze front 53).
val _dashboard = page("dashboard", fn(req: Request, out: ChunkWriter) {
    val session = cookies().get("session").unwrapOr("");
    if (session == "") {
        val _gone = redirect("/login");
    };
    val theme = cookies().get("theme").unwrapOr("system");
    return out.write("signed in as " + session + "; theme: " + theme);
});

// SERVER — a server action. The phase is Action, so a cookie write is legal.
// The same call from the page renderer above would raise.
#[action]
pub fn setTheme(theme: string) -> string {
    val attrs = CookieAttrs(
        path: "/",
        domain: "",
        maxAge: 31536000,
        httpOnly: false,
        secure: true,
        sameSite: "Lax",
    );
    val _written = cookies().set("theme", theme, attrs);
    val _deferred = after({ ->
        recordThemeChange(theme);
    });
    return theme;
}

// SERVER — deferred work. It runs in its own process after the response bytes
// are on the wire, with a frozen copy of the request frame: reads are legal,
// writes raise, and a failure here is logged and never reaches the client.
fn recordThemeChange(theme: string) -> i32 {
    val agent = headers().get("user-agent").unwrapOr("unknown");
    @print("theme=" + theme + " agent=" + agent);
    return 1;
}

// SERVER — a route handler. The phase is Handler, so both reads and the cookie
// write below are legal, and reading a header marks this response dynamic.
#[getRoute("api/whoami")]
#[@future]
pub fn whoami(req: Request) -> @Future<Response> {
    val authorization = headers().get("authorization").unwrapOr("");
    if (authorization == "") {
        return Response.withStatus(401, "");
    };
    val theme = cookies().get("theme").unwrapOr("system");
    return Response.json("{\"theme\":\"" + theme + "\"}");
}
