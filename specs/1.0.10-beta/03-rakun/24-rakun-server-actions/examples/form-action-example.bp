// Front 24 — rakun server actions.
//
// An action whose submission mutates and revalidates. Both halves are named:
//
//   SERVER (BEAM): `createPost` and everything it awaits. The action body never
//   reaches the browser; only its id does.
//   CLIENT (browser): the POST. With scripting off it is a plain form submission
//   to the current pathname; with front 67 loaded it is the same POST carrying
//   the action header and receiving the result envelope instead of a document.
//
// The field and header names are configuration onze sets (`rakun.actions.field`
// / `rakun.actions.header`, decision 114); this example's configuration uses
// onze's defaults, `__bp_action` and `X-Bp-Action`.
//
// The form itself is not here: rakun builds no HTML and imports nothing from
// jhonstart (decision 113). jhonstart front 67 writes the form with the id onze
// asks this front for (`actionIdOf`); this file tests the id and the POST.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/updating-data
//   https://nextjs.org/docs/app/api-reference/directives/use-server

// This front's surface.
import {serverAction, FormData, ActionResult, actionIdOf, dispatchAction} from "rakun";
// provided by front 12 — `revalidatePath` and the `revalidatedPaths()` test seam.
import {cache} from "rakun-cache";
import {collections.Dict} from "std";

// The app's own data layer — front 08 in a real application. Stubbed here so the
// example is about the action, not about the store.
#[@future]
fn savePost(title: string, body: string) -> @Future<string> {
    return "post_" + title;
}

// ---- app/blog/actions.bp — SERVER ---------------------------------------------
//
// `#[serverAction]` is the inline `'use server'`. The file-level directive is the
// same decorator applied by the CLI to every `pub fn` of a file that opens with
// `pub val useServer = true;` — one registration path, two spellings.
//
// The id the browser sends back is derived at module load from the module, the
// function name and the build id, HMAC'd with the deployment secret. It is never
// the function's own name: an unmarked `pub fn` must not be reachable by naming it.

#[serverAction]
#[@future]
pub fn createPost(form: FormData) -> @Future<ActionResult> {
    val title = form.field("title");
    val body = form.field("body");
    val tooShort = title.length() < 3;
    if (tooShort) {
        return ActionResult.invalid("title", "Title must be at least 3 characters");
    };
    val _id = await savePost(title, body);
    // Invalidate before the re-render, so the document the browser gets back is
    // built from the refilled cache and not from the entry this action just made
    // stale. The ordering is the point.
    cache.revalidatePath("/blog");
    return ActionResult.done();
}

fn submission(title: string, body: string) -> FormData {
    return FormData(fields: Dict.empty().insert("title", title).insert("body", body));
}

// ---- what the action does -----------------------------------------------------

test "a title that is too short comes back as state, not as an HTTP error" {
    val result = await createPost(submission("hi", "a body"));
    val message = result.state.lookup("title").unwrapOr("");
    assert message == "Title must be at least 3 characters";
}

test "a rejected submission mutates nothing and revalidates nothing" {
    val before = cache.revalidatedPaths().length;
    val _result = await createPost(submission("hi", "a body"));
    assert cache.revalidatedPaths().length == before;
}

test "a valid submission clears the state and invalidates the list route" {
    val result = await createPost(submission("Rendering on BEAM", "a body"));
    assert result.state.isEmpty();
    assert cache.revalidatedPaths().contains("/blog");
}

// ---- what a form carries on the wire -------------------------------------------

test "the id a form carries names the action by its id and never by its name" {
    val id = actionIdOf("createPost");
    assert id.startsWith("a_");
    assert id.length() == 26;
    assert id != "createPost";
}

test "a scripting-disabled submission is a raw POST carrying the id" {
    val id = actionIdOf("createPost");
    val _outcome = await dispatchAction("/blog/new", "https://app.example", "app.example",
        "application/x-www-form-urlencoded", "__bp_action=" + id + "&title=Rendering+on+BEAM&body=x");
    assert cache.revalidatedPaths().contains("/blog");
}
