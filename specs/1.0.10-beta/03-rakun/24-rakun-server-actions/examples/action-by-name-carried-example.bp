// NOTE: 24 names the action by a derived id, never by its function name
// (24 § The form is not this front's, Step 2); this example names it by name. The return type is
// `@Future<void>` here and `@Future<ActionResult>` in 24 Step 1;
// `formData.get(...)` is `form.field(...)` in 24.

// --- Simple action (lib/actions.bp)
// NOTE: 12 imports `revalidatePath` from "rakun-cache" (12 § Package, module and import spellings).
import {revalidatePath} from "rakun";

#[serverAction]
#[@future]
pub fn createPost(formData: FormData) -> @Future<void> {
    val title = formData.get("title");
    val content = formData.get("content");
    await db.post.create(title: title, content: content);
    revalidatePath("/blog");
}

// --- Form using the action (app/blog/new/page.bp)
// NOTE: `input([attrs: [...]])` is the draft's spelling; 94 spells `input([], attrs: [...])`.
// NOTE: `attrs: [#("action", "createPost")]` binds by name — 24 derives an id (`actionIdOf`) and
// jhonstart 67's `formAttrs` writes it into the form, handed through onze (decision 113).
// NOTE: `"@/lib/actions"` is a path alias with no botopink counterpart.
import {Element, form, input, textarea, button, text} from "jhonstart";
import {createPost} from "@/lib/actions";

pub fn NewPostForm() -> Element {
    return form([
        input([attrs: [#("type", "text"), #("name", "title"), #("placeholder", "Title")]]),
        textarea([attrs: [#("name", "content"), #("placeholder", "Content")]]),
        button([text("Create Post", attrs: [])], attrs: [#("type", "submit")]),
    ], attrs: [#("action", "createPost")]);
}

// --- Action with redirect (lib/actions.bp)
// NOTE: 63 carries the redirect from an action as an envelope field, not an HTTP 307
// (63 § Where a signal becomes a response); 63/examples/action-redirect-example.bp is 63's form.
import {revalidatePath, redirect} from "rakun";

#[serverAction]
#[@future]
pub fn login(formData: FormData) -> @Future<void> {
    val email = formData.get("email");
    val password = formData.get("password");
    val user = await auth.verify(email, password);
    if (user == null) {
        return;
    };
    await session.create(user);
    redirect("/dashboard");
}
