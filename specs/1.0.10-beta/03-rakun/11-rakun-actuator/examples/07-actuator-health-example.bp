// ── Kubernetes Probes ───────────────────────────────────────────────────────
//// GET /actuator/health/liveness
//// { "status": "UP" }
////
//// GET /actuator/health/readiness
//// {
////     "status": "UP",
////     "components": {
////         "db": { "status": "UP" },
////         "redis": { "status": "UP" }
////     }
//// }
////
//// Kubernetes configuration:
//// livenessProbe:
////   httpGet:
////     path: /actuator/health/liveness
////     port: 8080
//// readinessProbe:
////   httpGet:
////     path: /actuator/health/readiness
////     port: 8080

fn main() {
    // Actuator endpoints:
    // - /actuator/health - health check (UP, DOWN, OUT_OF_SERVICE)
    // - /actuator/info - application info (build, git, env)
    // - /actuator/metrics - metrics (JVM, HTTP, custom)
    // - /actuator/env - environment properties (sanitized)
    // - /actuator/beans - list of beans
    // - /actuator/health/liveness - Kubernetes liveness probe
    // - /actuator/health/readiness - Kubernetes readiness probe
    //
    // Health indicators:
    // - Built-in: diskSpace, db, redis, rabbit, mail, etc.
    // - Custom: implement HealthIndicator behavior
    //
    // Metrics:
    // - Auto-instrumented: HTTP requests, JVM, DataSource
    // - Custom: Counter, Timer, Gauge
    //
    // Info:
    // - Built-in: build, git, env, java, os
    // - Custom: implement InfoContributor behavior
    Rakun.run(App(port: 8080, basePath: "/api"));
}

