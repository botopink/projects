// Front 66 — Rakun Metadata File Routes
//
// What this demonstrates: segment-scoped OG images. A root opengraph-image
// covers the whole site; one registered at blog/[slug] overrides it for post
// pages and for nothing else. The <meta> tags front 32 emits point at whichever
// one won, and the URL carries a content hash so a redeploy does not leave a
// stale card in a crawler's cache.
//
// The app tree this file populates:
//
//   app/
//     opengraph-image.png        <- the site-wide card, a static file
//     blog/
//       [slug]/
//         opengraph-image.bp     <- rendered per post (jhonstart + onze front 70)
//
// SERVER — both routes answer requests on the BEAM. rakun declares the dynamic
// route, its URL and its size (an ImageMeta record, which front 32 writes as
// <meta> tags); the card's body is an opaque renderer onze
// sets with `setImageRenderer` — jhonstart renders the element tree and onze
// front 70 turns it into SVG. With no renderer set (front 70 absent) the route
// answers 501 and its ImageMeta is still answered, so the failure is one card
// and not a missing head. This file sets a stand-in renderer that writes an SVG
// string, so the route is testable from rakun alone; the jhonstart card is onze
// front 53's.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/file-conventions/metadata/opengraph-image

import {
    ImageKind,
    registerImageFile,
    registerImageRoute,
    setImageRenderer,
    imageUrlFor,
    imagesFor,
    ImageMeta,
} from "rakun";
import {ChunkWriter, Request} from "rakun";  // provided by fronts 23 and 04

pub type Post(
    slug: string,
    title: string,
    author: string,
)

fn findPost(slug: string) -> Post {
    return Post(slug: slug, title: "Post " + slug, author: "ana");
}

// SERVER — the site-wide card: a static file beside the root. Front 50's CLI
// generates this registration from the file it finds; it is written out here so
// the shape is visible.
val _rootOg = registerImageFile(
    ImageKind.OpenGraph,
    "",
    "opengraph-image.png",
    "image/png",
    1200,
    630,
);

// SERVER — the per-post card. It overrides the root registration for
// /blog/<slug> and leaves every other route on the root one. Width, height and
// content type are written out because a declared parameter default is never
// applied at a call site.
val _blogOg = registerImageRoute(ImageKind.OpenGraph, "blog/[slug]", 1200, 630, "image/svg+xml");

// SERVER — the stand-in body. In an application onze sets this renderer.
val _blogOgBody = setImageRenderer(ImageKind.OpenGraph, "blog/[slug]", fn(req: Request, out: ChunkWriter) {
    val post = findPost(req.param("slug"));
    return out.write("<svg xmlns=\"http://www.w3.org/2000/svg\"><text>" + post.title + " by " + post.author + "</text></svg>");
});

// SERVER — the data jhonstart front 32 turns into <meta> tags, handed to it by onze. rakun answers
// records and writes no markup (decision 116); the resolution rule is nearest ancestor, implemented
// once here and cited there.
pub fn cardsFor(pathname: string, pattern: string) -> Array<ImageMeta> {
    return imagesFor(pathname, pattern);
}

pub fn cardUrlFor(pathname: string) -> string {
    return imageUrlFor(ImageKind.OpenGraph, pathname).unwrapOr("");
}
