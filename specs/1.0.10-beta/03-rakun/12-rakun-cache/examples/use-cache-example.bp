// Front 12 — rakun-cache · example 2 of 2
//
// The Next entry point, over the SAME store the decorators in example 1 write
// to: the three scopes, the lifetime profiles, tags, and the three revalidation
// verbs called from a mutation.
//
// Upstream: https://nextjs.org/docs/app/api-reference/directives/use-cache
//           https://nextjs.org/docs/app/api-reference/functions/revalidateTag
//           https://nextjs.org/docs/app/api-reference/functions/updateTag
//           (NEXTJS-DOCS.md § 11. Cache · § 12. Revalidation)
//
// Target: erlang (server). These functions run during a render, a route handler
// or a server action — never in the browser.

import {cachePolicy, cacheThrough, cacheFn, cacheLife, cacheLifeOf, CacheScope} from "rakun-cache";
import {revalidateTag, updateTag, revalidatePath} from "rakun-cache";
import {rkCacheEnabled, rkCacheLookup, rkCachePut, rkCachePhase} from "rakun-cache";
import {revalidatedPaths, revalidatedTags, clearRevalidated} from "rakun-cache";

// ── the loaders this module caches ──────────────────────────────────────────
//
// Stand-ins for a query through front 08 or a call through front 13. They are
// ordinary blocking calls: on the BEAM a render is a process, so there is no
// async colouring to preserve and the loader does not have to return a future.

fn loadProductsJson(page: string) -> string {
    return "{\"page\":\"" + page + "\",\"items\":[]}";
}

fn renderProductList(page: string) -> string {
    return "<ul data-page=\"" + page + "\"></ul>";
}

fn loadRecommendations(productId: string) -> string {
    return "{\"for\":\"" + productId + "\",\"items\":[]}";
}

fn loadPrice(productId: string, currency: string) -> string {
    return "{\"id\":\"" + productId + "\",\"currency\":\"" + currency + "\",\"cents\":0}";
}

fn writePrice(productId: string, cents: string) -> string {
    return "{\"id\":\"" + productId + "\",\"cents\":\"" + cents + "\"}";
}

// ── file level ──────────────────────────────────────────────────────────────
//
// LANGUAGE GAP: botopink has no module-level annotation, so Next's file-level
// `'use cache'` — one directive at the top of a file that covers every export —
// has no spelling. The nearest valid form is a module-level `val` holding the
// default policy, which every combinator below can fall back to.

val moduleCachePolicy = cachePolicy(CacheScope.Shared, "catalog-module", cacheLife("days"), ["catalog"]);

// ── data level · shared ─────────────────────────────────────────────────────
//
// LANGUAGE GAP: a decorator cannot replace the body of the declaration it
// annotates, so the transparent form — `#[useCache]` on this function, with
// `cacheLife("hours")` and `cacheTag("products")` as statements in its body —
// is not expressible. Below is the nearest valid form: the same policy, the
// same key protocol, the same store, written out.

pub fn productsJson(page: string) -> string {
    val policy = cachePolicy(CacheScope.Shared, "products", cacheLife("hours"), ["products", "catalog"]);
    return cacheThrough(policy, ["productsJson", page], { -> loadProductsJson(page) });
}

// ── UI level · shared ───────────────────────────────────────────────────────
//
// The same protocol one layer up: the rendered fragment, not the data behind it.
// Two rows, one tag — `revalidateTag("products")` invalidates both.

pub fn productListHtml(page: string) -> string {
    val policy = cachePolicy(CacheScope.Shared, "products-ui", cacheLife("minutes"), ["products"]);
    return cacheThrough(policy, ["productListHtml", page], { -> renderProductList(page) });
}

// ── data level · private ────────────────────────────────────────────────────
//
// `'use cache: private'`. The session id comes from the per-request context
// (front 62) and is mixed into the key before hashing, so two sessions never
// read each other's row. Nothing about this call site has to know the id.

pub fn recommendationsJson(productId: string) -> string {
    val life = cacheLifeOf(60, 60, 300);
    val policy = cachePolicy(CacheScope.Private, "recommendations", life, ["recommendations"]);
    return cacheThrough(policy, ["recommendationsJson", productId], { -> loadRecommendations(productId) });
}

// ── data level · remote ─────────────────────────────────────────────────────
//
// `'use cache: remote'`. Always Redis, whatever `rakun.cache.type` says, because
// the point of this scope is that every node in the cluster sees the same row.
// The tag is per product, so repricing one product does not flush the rest.

pub fn priceJson(productId: string, currency: string) -> string {
    val life = cacheLifeOf(60, 600, 3600);
    val policy = cachePolicy(CacheScope.Remote, "prices", life, ["price-" + productId]);
    return cacheThrough(policy, ["priceJson", productId, currency], { -> loadPrice(productId, currency) });
}

// ── the function-wrapping entry point ───────────────────────────────────────
//
// Next's `unstable_cache(fn, keys, {tags, revalidate})`. Same primitive, same
// key, same row as `productsJson` above would produce for the same namespace.

pub fn productsJsonWrapped(page: string) -> string {
    return cacheFn("products", ["productsJson", page], cacheLife("hours"), ["products", "catalog"], { ->
        loadProductsJson(page);
    });
}

// ── the mutation ────────────────────────────────────────────────────────────
//
// `updateTag` expires now, so the read on the next line of the SAME request
// sees the write. `revalidateTag` marks stale: the next read returns the old
// value and schedules a refresh. Both raise if called during a render —
// `rkCachePhase()` is checked inside them, not asserted in a comment.

pub fn repriceProduct(productId: string, cents: string) -> string {
    val written = writePrice(productId, cents);
    val _now = updateTag("price-" + productId);
    val _soon = revalidateTag("products");
    val _path = revalidatePath("/products/" + productId);
    val readBack = priceJson(productId, "BRL");
    return "{\"written\":" + written + ",\"readBack\":" + readBack + "}";
}

// ── the test seam ───────────────────────────────────────────────────────────
//
// The store lives in the host and a test cannot read it. Per the milestone
// convention that front 19 states — a front that mutates shared state exposes a
// read-only accessor for tests — these report what a mutation invalidated
// without anyone reaching into the cache. They return values, never handles, and
// they clear nothing: `clearRevalidated()` is separate, so a test that forgets
// it fails loudly instead of inheriting the previous test's list.

test "a reprice invalidates the product tag, the catalog tag and the product path" {
    val _clean = clearRevalidated();
    val _done = repriceProduct("42", "1999");

    assert revalidatedTags().join(",") == "price-42,products";
    assert revalidatedPaths().join(",") == "/products/42";
}

// The same accessors are how front 24 asserts what a server action invalidated.
// Arrays are compared with `.join(",")` because botopink lowers `==` on arrays
// to reference equality.
