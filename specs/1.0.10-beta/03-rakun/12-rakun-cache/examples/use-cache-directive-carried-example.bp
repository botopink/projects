// NOTE: use-cache-example.bp is the nearest valid form of both snippets over the same store.

// --- Cache with cacheLife (lib/data.bp)
// LANGUAGE GAP: a decorator cannot replace or wrap the body of the declaration it annotates,
// so `#[cache]` with `cacheLife(...)` / `cacheTag(...)` as body statements is not expressible
// (12 § Language gaps). 12 spells it `cacheThrough(cachePolicy(scope, name, life, tags), keys, load)`.
import {cacheLife, cacheTag} from "rakun";

#[cache]
#[@future]
pub fn getProducts() -> @Future<Product[]> {
    cacheLife("hours");
    cacheTag("products");
    return await db.product.findAll();
}

// --- Cache with on-demand revalidation (lib/actions.bp)
// NOTE: 12 imports `revalidateTag` from "rakun-cache" (12 § Package, module and import spellings);
// the action shape (`FormData.field`, `@Future<ActionResult>`) is 24's.
import {revalidateTag} from "rakun";

#[serverAction]
#[@future]
pub fn updateProduct(formData: FormData) -> @Future<void> {
    val id = formData.get("id");
    val name = formData.get("name");
    await db.product.update(id, name: name);
    revalidateTag("products");
}
