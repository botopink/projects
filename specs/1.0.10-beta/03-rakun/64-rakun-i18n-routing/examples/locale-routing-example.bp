// Front 64 — Rakun i18n Routing
//
// What this demonstrates: § 22 end to end. A closed locale set, the negotiation
// filter installed at the front of front 07's chain, and a `[locale]` page that
// reads the resolved locale. All of it runs on the BEAM; the browser sees the
// locale only as an ordinary route param in the payload. The page is an opaque
// renderer writing plain text (front 23); the `[locale]` layout that sets
// `lang` from `htmlLang()` is jhonstart's, wired by onze (onze front 53).
//
// Upstream:
//   https://nextjs.org/docs/app/guides/internationalization

import {LocaleSet, Alternate, registerLocales, localeOf, htmlLang, alternatesFor} from "rakun-i18n";
import {localeFilter} from "rakun-i18n";
import {registerFilter} from "rakun-web";                      // provided by front 07
import {matcher} from "rakun-web";                             // provided by front 65
import {page, ChunkWriter, Request} from "rakun";               // provided by fronts 23 and 04

// SERVER — the locale set is declared once and is closed. A path prefixed with
// anything not in this list is not a locale route, so /klingon/about 404s
// instead of rendering in an undefined language.
pub fn appLocales() -> LocaleSet {
    return LocaleSet(locales: ["pt-BR", "en", "es"], defaultLocale: "pt-BR");
}

val _locales = registerLocales(appLocales());

// SERVER — the negotiation filter. The exclusions are compiled once at startup,
// not per request. /sitemap.xml and /robots.txt are on the list because front 66
// serves them at fixed URLs and a locale redirect would break both.
fn installLocaleFilter() -> i32 {
    val assert Ok(excludeApi) = matcher("/api/:path*");
    val assert Ok(excludeSitemap) = matcher("/sitemap.xml");
    val assert Ok(excludeRobots) = matcher("/robots.txt");
    val exclude = [excludeApi, excludeSitemap, excludeRobots];
    return registerFilter(localeFilter(appLocales(), exclude));
}

val _filter = installLocaleFilter();

// SERVER — the page. Reading the resolved locale does not make this render
// dynamic: the locale is a route param, and the route param is part of the URL.
// `htmlLang()` answers the same locale for the `lang` attribute a layout sets.
val _home = page("[locale]", fn(req: Request, out: ChunkWriter) {
    val locale = localeOf();
    val greeting = case locale {
        "en" -> "Welcome";
        "es" -> "Bienvenido";
        _ -> "Bem-vindo";
    };
    await out.write(greeting + " (locale: " + locale + ", lang: " + htmlLang() + ")");
});

// SERVER — the hreflang set jhonstart front 32 renders, handed to it by onze:
// one entry per locale plus x-default. The incoming pathname is stripped of its
// locale first, so calling this from /pt-BR/about and from /about answers the
// same set.
pub fn homeAlternates(pathname: string) -> Alternate[] {
    return alternatesFor(appLocales(), pathname);
}
