// Front 63 — Rakun Navigation Signals
//
// What this demonstrates: the two canonical uses, on page renderers (front 23).
// A `[slug]` renderer calls `notFound()` when the record is missing, and a
// dashboard renderer calls `redirect("/login")` when there is no session. Both
// run on the BEAM before the first write; neither returns, and the dispatch
// answers the signal's status. A jhonstart page raises jhonstart's own
// not-found, which onze translates into this front's (decision 113) — that
// wiring is onze front 53's example.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/functions/not-found
//   https://nextjs.org/docs/app/api-reference/functions/redirect
//   https://nextjs.org/docs/app/guides/authentication

import {notFound, redirect} from "rakun";
import {cookies} from "rakun";                                 // provided by front 62
import {page, ChunkWriter, Request} from "rakun";               // provided by fronts 23 and 04

pub type Post(
    slug: string,
    title: string,
    body: string,
)

// SERVER — stands in for the repository read from front 08.
#[@result]
fn findPost(slug: string) -> @Result<Post, string> {
    if (slug == "hello") {
        return Post(slug: "hello", title: "Hello", body: "first post");
    };
    throw "no such post: " + slug;
}

// SERVER — § 14 "Not Found". The signal unwinds to the dispatch, which answers
// 404; the statements after `notFound()` are never reached.
val _post = page("blog/[slug]", fn(req: Request, out: ChunkWriter) {
    val found = findPost(req.param("slug"));
    if (found.isError()) {
        val _gone = notFound();
    };
    val post = found.unwrapOr(Post(slug: "", title: "", body: ""));
    return out.write(post.title + "\n" + post.body);
});

// SERVER — § 23 "Layout with authentication", as a guard on the dashboard
// renderer. `redirect` answers 307 and the destination is checked against the
// route table, so a typo fails here rather than sending a browser to a 404.
val _dashboard = page("dashboard", fn(req: Request, out: ChunkWriter) {
    val session = cookies().get("session").unwrapOr("");
    if (session == "") {
        val _gone = redirect("/login");
    };
    return out.write("signed in as " + session);
});
