// Front 63 — Rakun Navigation Signals
//
// What this demonstrates: the two canonical uses. A `[slug]` page calls
// `notFound()` when the record is missing, and a dashboard layout calls
// `redirect("/login")` when there is no session. Both functions run on the BEAM
// during the render; neither returns, and neither changes the signature of any
// function between it and the pipeline.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/functions/not-found
//   https://nextjs.org/docs/app/api-reference/functions/redirect
//   https://nextjs.org/docs/app/guides/authentication

import {notFound, redirect} from "rakun";
import {cookies} from "rakun";                                 // provided by front 62
import {layout, page, LayoutProps, PageContext} from "rakun";  // provided by front 22
import {Element, div, h1, p, text} from "jhonstart";

pub type Post(
    slug: string,
    title: string,
    body: string,
)

// SERVER — stands in for the repository read from front 08.
#[@result]
fn findPost(slug: string) -> @Result<Post, string> {
    if (slug == "hello") {
        return Post(slug: "hello", title: "Hello", body: "first post");
    };
    throw "no such post: " + slug;
}

// SERVER — § 14 "Not Found". The signal unwinds to the nearest not-found.bp
// boundary (front 31) and sets status 404. Nothing between here and the
// pipeline had to declare that it might not produce an Element, and the
// statements after `notFound()` are never reached.
#[page("blog/[slug]")]
#[@future]
pub fn blogPostPage(route: PageContext) -> @Future<Element> {
    val slug = route.params.lookup("slug").unwrapOr("");
    val found = findPost(slug);
    if (found.isError()) {
        val _gone = notFound();
    };
    val post = found.unwrapOr(Post(slug: "", title: "", body: ""));
    return div([
        h1([text(post.title, attrs: [])], attrs: []),
        p([text(post.body, attrs: [])], attrs: []),
    ], attrs: []);
}

// SERVER — § 23 "Layout with authentication". `redirect` answers 307 and the
// destination is checked against the route table, so a typo fails here rather
// than sending a browser to a 404.
#[layout("dashboard")]
pub fn dashboardLayout(props: LayoutProps) -> Element {
    val session = cookies().get("session").unwrapOr("");
    if (session == "") {
        val _gone = redirect("/login");
    };
    return div([
        p([text("signed in as " + session, attrs: [])], attrs: []),
        props.children,
    ], attrs: []);
}
