// Front 61 — Rakun Parallel and Intercepting Routes
//
// What this demonstrates: § 21's dashboard, from rakun's side. One layout
// declares two named slots beside its children; each slot matches the URL on
// its own, and the slot that does not match falls back to its own default.bp on
// a hard request. All of it runs on the BEAM.
//
// The app tree whose records this file registers:
//
//   app/
//     dashboard/
//       layout.bp          L /dashboard
//       page.bp            P /dashboard
//       @analytics/
//         page.bp          P /dashboard   slot analytics
//         default.bp       D /dashboard   slot analytics
//       @team/
//         settings/
//           page.bp        P /dashboard/settings   slot team
//         default.bp       D /dashboard   slot team
//
// rakun answers resolutions — data. The layout that places the slots, and the
// elements in them, are jhonstart's (front 30's `compose` and `LayoutProps`),
// wired by onze; the rendered dashboard is onze front 53's. Here the records are
// registered the way onze's boot registers them (front 22's
// `rkAppRegisterEntry`), and the tests read the resolutions.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/file-conventions/parallel-routes
//   https://nextjs.org/docs/app/api-reference/file-conventions/default

import {rkAppRegisterEntry, rkAppTable} from "rakun";                     // front 22
import {table.parseTable, slot_states: {SlotState, writeSlotStates}} from "routing";  // bundled (decision 115)
import {resolveSlots, slotStateLines} from "rakun";                       // this front

fn install() -> void {
    rkAppRegisterEntry("L", "dashboard", "");
    rkAppRegisterEntry("P", "dashboard", "");
    rkAppRegisterEntry("P", "dashboard/@analytics", "analytics");
    rkAppRegisterEntry("D", "dashboard/@analytics", "analytics");
    rkAppRegisterEntry("P", "dashboard/@team/settings", "team");
    rkAppRegisterEntry("D", "dashboard/@team", "team");
}

test "a hard request for /dashboard matches analytics and defaults team" {
    install();
    val rs = resolveSlots(parseTable(rkAppTable()), "/dashboard", "/dashboard", false);
    assert rs.length == 2;
    assert rs.map({ r -> r.slot }).join(",") == "analytics,team";
    var analytics = SlotState.Empty;
    var team = SlotState.Empty;
    if (rs.first()) { r -> analytics = r.state; };
    if (rs.at(1)) { r -> team = r.state; };
    assert analytics == SlotState.Matched;
    assert team == SlotState.Defaulted;
}

test "a soft navigation leaves the unmatched slot unchanged" {
    install();
    val rs = resolveSlots(parseTable(rkAppTable()), "/dashboard", "/dashboard/settings", true);
    assert writeSlotStates(slotStateLines(rs)).contains("analytics|/dashboard|U");
}
