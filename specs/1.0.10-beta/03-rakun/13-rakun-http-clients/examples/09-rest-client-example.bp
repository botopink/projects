//// F09 — REST Client
////
//// This example shows the fluent RestClient for calling HTTP APIs.
////
//// Spring Boot documentation:
//// - REST Clients: https://docs.spring.io/spring-boot/reference/io/rest-client.html
//// - RestClient: https://docs.spring.io/spring-boot/reference/io/rest-client.html#io.rest-client.restclient
//// - RestTemplate: https://docs.spring.io/spring-boot/reference/io/rest-client.html#io.rest-client.resttemplate

import {Rakun, App, Request, Response} from "rakun";
import {service, restController, route, getMapping, configuration, bean} from "rakun";
import {RestClient, RestClientBuilder} from "rakun-client";
import {io.clock} from "std";

// ── Domain Models ───────────────────────────────────────────────────────────
pub type User(
    id: i32,
    name: string,
    email: string,
)

pub type Post(
    id: i32,
    userId: i32,
    title: string,
    body: string,
)

pub type ApiResponse<T>(
    data: T,
    status: string,
    message: string,
)

// ── Configuration: REST Clients ─────────────────────────────────────────────
#[configuration]
pub type RestClientConfig {
    #[bean]
    pub fn jsonPlaceholderClient(self: Self) -> RestClient {
        return RestClient.builder()
            .baseUrl("https://jsonplaceholder.typicode.com")
            .defaultHeader("Accept", "application/json")
            .timeout(5000)  // 5 seconds
            .build();
    }

    #[bean]
    pub fn internalApiClient(self: Self) -> RestClient {
        return RestClient.builder()
            .baseUrl("http://localhost:8081")
            .defaultHeader("Authorization", "Bearer " + getInternalToken())
            .build();
    }
}

// ── Service using RestClient ────────────────────────────────────────────────
#[service]
pub type ExternalUserService(client: RestClient) {
    // GET /users/1
    pub fn getUser(self: Self, id: i32) -> @Result<User, string> {
        return self.client.get()
            .uri("/users/{id}", [id.toString()])
            .retrieve()
            .body(User);
    }

    // GET /users
    pub fn listUsers(self: Self) -> @Result<Array<User>, string> {
        return self.client.get()
            .uri("/users")
            .retrieve()
            .body(Array<User>);
    }

    // POST /users
    pub fn createUser(self: Self, name: string, email: string) -> @Result<User, string> {
        val body = "{\"name\": \"" + name + "\", \"email\": \"" + email + "\"}";
        return self.client.post()
            .uri("/users")
            .header("Content-Type", "application/json")
            .body(body)
            .retrieve()
            .body(User);
    }

    // PUT /users/1
    pub fn updateUser(self: Self, id: i32, name: string, email: string) -> @Result<User, string> {
        val body = "{\"name\": \"" + name + "\", \"email\": \"" + email + "\"}";
        return self.client.put()
            .uri("/users/{id}", [id.toString()])
            .header("Content-Type", "application/json")
            .body(body)
            .retrieve()
            .body(User);
    }

    // DELETE /users/1
    pub fn deleteUser(self: Self, id: i32) -> @Result<void, string> {
        return self.client.delete()
            .uri("/users/{id}", [id.toString()])
            .retrieve()
            .toVoid();
    }
}

#[service]
pub type ExternalPostService(client: RestClient) {
    // GET /users/1/posts
    pub fn getUserPosts(self: Self, userId: i32) -> @Result<Array<Post>, string> {
        return self.client.get()
            .uri("/users/{userId}/posts", [userId.toString()])
            .retrieve()
            .body(Array<Post>);
    }

    // GET /posts?userId=1
    pub fn getPostsByUser(self: Self, userId: i32) -> @Result<Array<Post>, string> {
        return self.client.get()
            .uri("/posts?userId={userId}", [userId.toString()])
            .retrieve()
            .body(Array<Post>);
    }
}

// ── Error Handling ──────────────────────────────────────────────────────────
#[service]
pub type ResilientService(client: RestClient) {
    pub fn getUserWithRetry(self: Self, id: i32) -> @Result<User, string> {
        var attempts = 0;
        var lastError = "";

        loop {
            attempts = attempts + 1;
            val result = self.client.get()
                .uri("/users/{id}", [id.toString()])
                .retrieve()
                .body(User);

            match result {
                @Ok(user) => return @Ok(user),
                @Err(e) => {
                    lastError = e;
                    if (attempts >= 3) {
                        return @Err("Failed after 3 attempts: " + e);
                    }
                    clock.sleep(1000 * attempts);  // Exponential backoff
                }
            }
        }
    }

    pub fn getUserWithFallback(self: Self, id: i32) -> User {
        val result = self.client.get()
            .uri("/users/{id}", [id.toString()])
            .retrieve()
            .body(User);

        return match result {
            @Ok(user) => user,
            @Err(_) => User(id: id, name: "Unknown", email: "unknown@example.com"),
        };
    }
}

// ── Controller ──────────────────────────────────────────────────────────────
#[restController]
#[route("/api")]
pub type ProxyController(userService: ExternalUserService, postService: ExternalPostService) {
    #[getMapping("/proxy/users/:id")]
    pub fn getUser(self: Self, req: Request) -> Response {
        val id = req.param("id");
        val result = self.userService.getUser(id);
        return match result {
            @Ok(user) => Response.json(serialize(user)),
            @Err(e) => Response.status(502).body("External API error: " + e),
        };
    }

    #[getMapping("/proxy/users/:id/posts")]
    pub fn getUserPosts(self: Self, req: Request) -> Response {
        val userId = req.param("id");
        val result = self.postService.getUserPosts(userId);
        return match result {
            @Ok(posts) => Response.json(serialize(posts)),
            @Err(e) => Response.status(502).body("External API error: " + e),
        };
    }
}

fn main() {
    // RestClient features:
    //
    // Fluent API:
    // - client.get().uri("/path").retrieve().body(Type)
    // - client.post().uri("/path").body(json).retrieve().body(Type)
    //
    // URI templates:
    // - .uri("/users/{id}", [id]) → /users/1
    //
    // Headers:
    // - .defaultHeader("Accept", "application/json")
    // - .header("Content-Type", "application/json")
    //
    // Serialization:
    // - Request body: Type → JSON
    // - Response body: JSON → Type
    //
    // Error handling:
    // - Non-2xx → @Err with status, body, message
    // - Custom error handlers: .onStatus(404, handler)
    //
    // Timeout:
    // - .timeout(5000) → 5 seconds
    Rakun.run(App(port: 8080, basePath: "/api"));
}

