// Front 60 — Rakun Static Generation
//
// What this demonstrates: a blog whose post pages are prerendered from an
// enumerated slug list and refreshed hourly, next to a search page that stays
// dynamic because it reads the query. Both run on the BEAM; the difference is
// decided after a trial render, not declared. The pages are opaque renderers
// writing plain text (front 23); a page rendered by jhonstart through the same
// seam is onze front 53's example.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/functions/generate-static-params
//   https://nextjs.org/docs/app/api-reference/file-conventions/route-segment-config
//   https://nextjs.org/docs/app/guides/incremental-static-regeneration

import {
    registerSegmentConfig,
    registerStaticParams,
    SegmentConfig,
    DynamicMode,
    FetchCache,
    StaticParams,
    ParamBinding,
} from "rakun";
import {page, ChunkWriter, Request} from "rakun";  // provided by fronts 23 and 04

pub type Post(
    slug: string,
    title: string,
)

// SERVER — stands in for the repository read from front 08.
fn allPosts() -> Post[] {
    return [
        Post(slug: "hello", title: "Hello"),
        Post(slug: "beam", title: "Why the BEAM"),
    ];
}

fn findPost(slug: string) -> Post {
    val hits = allPosts().filter({ post -> post.slug == slug });
    return hits.at(0).unwrapOr(Post(slug: slug, title: "untitled"));
}

// ── the prerendered route ───────────────────────────────────────────────────

// SERVER — the segment configuration. Every field is written out because a
// declared parameter default is never applied at a call site.
val _blogConfig = registerSegmentConfig("blog/[slug]", SegmentConfig(
    dynamic: DynamicMode.Auto,
    dynamicParams: true,
    revalidate: 3600,
    fetchCache: FetchCache.Auto,
));

// SERVER — called once at build time. Each row binds every dynamic segment of
// the pattern; a row that misses one fails the build.
#[@future]
pub fn blogStaticParams() -> @Future<StaticParams[]> {
    return allPosts().map({ post ->
        StaticParams(bindings: [ParamBinding(name: "slug", value: post.slug)]);
    });
}

val _blogParams = registerStaticParams("blog/[slug]", blogStaticParams);

// SERVER — the page. It touches nothing request-specific, so the trial render
// leaves `isDynamic()` false and the output is stored as a prerendered entry.
val _blogPage = page("blog/[slug]", fn(req: Request, out: ChunkWriter) {
    val post = findPost(req.param("slug"));
    return out.write(post.title + " — /blog/" + post.slug);
});

// ── the route that stays dynamic ────────────────────────────────────────────

// SERVER — reading the query marks this render dynamic (front 62), so rule 4 of
// the decision applies and nothing is prerendered. No configuration says so;
// the trial render discovers it and the build report names `searchParams`.
val _searchPage = page("search", fn(req: Request, out: ChunkWriter) {
    val term = req.query("q");
    val hits = allPosts().filter({ post -> post.title.contains(term) });
    val titles = hits.map({ post -> post.title });
    return out.write("Results for " + term + ": " + titles.join(", "));
});
