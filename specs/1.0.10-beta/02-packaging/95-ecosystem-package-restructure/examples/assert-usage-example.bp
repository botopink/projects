// examples/assert-usage-example.bp
//
// Demonstrates std/testing/asserts in practice: boolean, equality, collection, result,
// string and numeric assertions. This is the shape of a test file that imports
// only std/testing/asserts — the foundation every -test submodule builds on.
//
// LANGUAGE GAP: asserts.setup/teardown are specified but the test runner does
// not yet call registered hooks. Until that lands, each test invokes its
// setup manually.

import {testing.asserts} from "std";

// --- Boolean assertions ---

test "truthy passes for true" {
    asserts.truthy(1 == 1);
    asserts.truthy("hello".length() > 0);
}

test "falsy passes for false" {
    asserts.falsy(1 == 2);
    asserts.falsy("".length() > 0);
}

// --- Equality assertions ---

test "equal compares primitives" {
    asserts.equal(42, 42);
    asserts.equal("hello", "hello");
    asserts.equal(true, true);
}

test "notEqual rejects identical values" {
    asserts.notEqual(1, 2);
    asserts.notEqual("a", "b");
}

test "approxEqual compares floats within tolerance" {
    asserts.approxEqual(3.14159, 3.14, 0.01);
    asserts.approxEqual(1.0 / 3.0, 0.333, 0.001);
}

// LANGUAGE GAP: deepEqual needs structural equality for records.
// Until the compiler provides it, the test serializes both sides to JSON
// and compares strings — losing field-path information in the failure message.
test "deepEqual compares records structurally" {
    // asserts.deepEqual({a: 1, b: [2, 3]}, {a: 1, b: [2, 3]});
    // For now, compare field by field:
    val left = {a: 1, b: 2};
    val right = {a: 1, b: 2};
    asserts.equal(left.a, right.a);
    asserts.equal(left.b, right.b);
}

// --- String assertions ---

test "contains checks for substring" {
    asserts.contains("hello world", "world");
    asserts.contains("botopink", "top");
}

test "matches checks for regex pattern" {
    asserts.matches("^\\d{3}-\\d{4}$", "555-1234");
    asserts.matches("^[a-z]+$", "hello");
}

test "startsWith checks prefix" {
    asserts.startsWith("hello world", "hello");
    asserts.startsWith("/api/users", "/api");
}

test "endsWith checks suffix" {
    asserts.endsWith("hello world", "world");
    asserts.endsWith("page.bp", ".bp");
}

// --- Collection assertions ---

test "empty passes for empty arrays" {
    asserts.empty([]);
    asserts.empty([].filter({ x -> x > 10 }));
}

test "notEmpty passes for non-empty arrays" {
    asserts.notEmpty([1, 2, 3]);
    asserts.notEmpty(["a"]);
}

test "hasLength checks array size" {
    asserts.hasLength([1, 2, 3], 3);
    asserts.hasLength([], 0);
}

test "includes checks array membership" {
    asserts.includes([1, 2, 3], 2);
    asserts.includes(["a", "b", "c"], "b");
}

// --- Numeric assertions ---

test "between checks inclusive range" {
    asserts.between(5, 1, 10);
    asserts.between(1, 1, 10);  // inclusive low
    asserts.between(10, 1, 10); // inclusive high
}

test "positive checks > 0" {
    asserts.positive(1);
    asserts.positive(100);
}

test "negative checks < 0" {
    asserts.negative(-1);
    asserts.negative(-100);
}

// --- Result assertions ---

test "isOk passes for Ok values" {
    // LANGUAGE GAP: @Result literal construction is not yet supported.
    // These assertions are specified but cannot be tested until the compiler
    // allows constructing @Result values in test code.
    // asserts.isOk(Ok(42));
    // asserts.isOk(Ok("success"));
}

test "isErr passes for Err values" {
    // LANGUAGE GAP: same as above.
    // asserts.isErr(Err("something went wrong"));
}

// --- Exception assertions ---

test "throws asserts a function raises" {
    asserts.throws({
        asserts.fail("deliberate failure");
        return 0;
    }, "deliberate failure");
}

// --- Utility ---

test "fail always panics" {
    // This test demonstrates that fail panics with the given message.
    // It is wrapped in asserts.throws to verify the panic.
    asserts.throws({
        asserts.fail("this test should fail");
        return 0;
    }, "this test should fail");
}

// --- Test lifecycle (manual until runner supports hooks) ---

// LANGUAGE GAP: asserts.setup/teardown are specified but the runner does not
// call them. Until that lands, each test invokes setup manually.
test "manual setup pattern" {
    // setup: create a fixture
    val fixture = [1, 2, 3, 4, 5];

    // exercise
    val filtered = fixture.filter({ x -> x > 2 });

    // verify
    asserts.hasLength(filtered, 3);
    asserts.includes(filtered, 3);
    asserts.includes(filtered, 4);
    asserts.includes(filtered, 5);

    // teardown: cleanup if needed
    // (no cleanup needed for this fixture)
}
