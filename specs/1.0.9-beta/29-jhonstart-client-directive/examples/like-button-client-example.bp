// Front 29 — jhonstart-client-directive · examples/like-button-client-example.bp
//
// The `§ 7. Padrão: Server + Client` shape: a server component lists the posts,
// and each row embeds a CLIENT component that owns the like count.
//
// Three things are worth reading closely.
//   - `LikeProps` carries `#[clientProps]`. Its two fields are a `string` and an
//     `i32`, both on the serializable whitelist. A field typed `Element` would
//     be rejected at comptime, with a message located at the declaration.
//   - `LikeButton` carries `#[client]`. Its body uses `use state`, which only
//     means anything in the browser; on the server it is never called.
//   - `PostList` is a SERVER component. It does not call `LikeButton` — it emits
//     the placeholder, which is what front 23 serializes and front 68's bundle
//     starts.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/server-and-client-components
//   https://nextjs.org/docs/app/api-reference/directives/use-client

import { Element, div, ul, li, h1, span, text, renderToString } from "jhonstart";
import { client, clientProps, clientMount } from "jhonstart";
import { state } from "jhonstart";
import { button, h2 } from "jhonstart";

// `button` and `h2` come from the element-surface front of track C (number
// allocated from 54 up). `client`, `clientProps` and `clientMount` are
// front 29's; `state` is `hooks.bp`.

pub type Post(id: string, title: string, likes: i32)

// ── the client half ─────────────────────────────────────────────────────────

#[clientProps]
pub type LikeProps(
    postId: string,
    likes: i32,
)

// The interactive component. `data-jh-on-click` names a handler the client
// runtime binds after hydration; there is no JavaScript string in this file.
#[client]
pub fn LikeButton(props: LikeProps) -> Element {
    val c = use state(props.likes);
    return button([
        text(c.value.toString() + " likes", attrs: []),
    ], attrs: [
        #("data-jh-on-click", "LikeButton:like"),
        #("data-jh-post", props.postId),
    ]);
}

// ── the server half ─────────────────────────────────────────────────────────

// What the server actually emits for a client component: the placeholder, with
// the props encoded on it. No children — the button has none.
pub fn likeButtonMount(props: LikeProps) -> Element {
    return clientMount("LikeButton", [
        #("postId", props.postId),
        #("likes", props.likes.toString()),
    ], []);
}

fn postRow(p: Post) -> Element {
    return li([
        h2([text(p.title, attrs: [])], attrs: []),
        likeButtonMount(LikeProps(postId: p.id, likes: p.likes)),
    ], attrs: [#("class", "post-row")]);
}

// A server component. Everything it renders is markup; the only client code on
// the page is whatever `LikeButton` compiles to in front 68's bundle.
pub fn PostList(posts: Array<Post>) -> Element {
    return div([
        h1([text("Posts", attrs: [])], attrs: []),
        ul(posts.map({ p -> postRow(p) }), attrs: [#("class", "posts")]),
    ], attrs: [#("class", "page")]);
}

test "the placeholder carries the component name and its encoded props" {
    val el = likeButtonMount(LikeProps(postId: "7", likes: 3));
    assert renderToString(el) ==
        "<div data-jh-client=\"LikeButton\" data-jh-props=\"postId=7&likes=3\"></div>";
}

test "a post row embeds the placeholder, not the component" {
    val markup = renderToString(postRow(Post(id: "7", title: "On BEAM rendering", likes: 3)));
    assert markup.contains("<h2>On BEAM rendering</h2>");
    assert markup.contains("data-jh-client=\"LikeButton\"");
    assert markup.contains("data-jh-on-click") == false;
}

test "the list renders one placeholder per post" {
    val posts = [
        Post(id: "1", title: "First", likes: 0),
        Post(id: "2", title: "Second", likes: 9),
    ];
    val markup = renderToString(PostList(posts));
    assert markup.contains("postId=1&likes=0");
    assert markup.contains("postId=2&likes=9");
}
