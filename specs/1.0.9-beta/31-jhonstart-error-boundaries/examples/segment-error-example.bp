// Front 31 — jhonstart-error-boundaries · examples/segment-error-example.bp
//
// A dashboard whose metrics service is down. The rest of the page still
// renders; the metrics panel is replaced by its segment's `error.bp`.
//
// This is the SERVER half. The catch is a `case` over `@Result` — the only
// catching mechanism botopink has — so the failing child must be a `#[@result]`
// thunk. Nothing else could have been caught.
//
// The reader never sees the error message. `infoFor` hands the fallback a
// digest and an empty message; `serverInfoFor` hands front 17's logger the full
// text under the same digest. The reader reports `a3f19c2b`, the operator greps
// for `a3f19c2b`.
//
// The export is `ErrorPage`, not `Error`: `Error(error: E)` is the `@Result`
// variant, and a module-level `pub fn Error` would shadow it.
//
// Upstream:
//   https://nextjs.org/docs/app/getting-started/error-handling
//   https://nextjs.org/docs/app/api-reference/file-conventions/error

import { Element, div, h1, p, span, text, renderToString } from "jhonstart";
import { ErrorInfo, ErrorBoundary, catchError, renderBoundary } from "jhonstart";
import { infoFor, serverInfoFor } from "jhonstart";
import { section, h2, button } from "jhonstart";
import { escape } from "std";

// `section`, `h2` and `button` come from the element-surface front of track C
// (number allocated from 54 up). `escape` is front 01's.

// ── what the developer writes: app/dashboard/error.bp ───────────────────────

pub fn ErrorPage(info: ErrorInfo) -> Element {
    return section([
        h2([text("The metrics are unavailable", attrs: [])], attrs: []),
        p([text("Nothing else on this page is affected.", attrs: [])], attrs: []),
        p([text("Reference " + info.digest, attrs: [])], attrs: [#("class", "digest")]),
        button([text("Try again", attrs: [])], attrs: [
            #("data-jh-error-reset", "dashboard.metrics"),
        ]),
    ], attrs: [#("class", "error")]);
}

// ── what the developer writes: the panel that can fail ──────────────────────

#[@External.Erlang("metrics_service", "summary")]
declare fn metricsSummary() -> string;

#[@result]
fn MetricsPanel() -> @Result<Element, string> {
    val raw = metricsSummary();
    if (raw == "") { throw "metrics service returned no rows"; };
    return div([text(escape.html(raw), attrs: [])], attrs: [#("class", "metrics")]);
}

pub fn metricsBoundary() -> ErrorBoundary {
    return catchError("dashboard.metrics", { info ->
        ErrorPage(info);
    }, { ->
        MetricsPanel();
    });
}

// ── the page ────────────────────────────────────────────────────────────────

pub fn Dashboard() -> Element {
    return div([
        h1([text("Dashboard", attrs: [])], attrs: []),
        p([text("Everything outside the boundary renders either way.", attrs: [])], attrs: []),
        renderBoundary(metricsBoundary()),
    ], attrs: [#("class", "page")]);
}

// ── stubs, so the boundary is testable without the service ──────────────────

#[@result]
fn failingPanel() -> @Result<Element, string> {
    throw "connection refused: metrics-01:5432";
}

#[@result]
fn healthyPanel() -> @Result<Element, string> {
    return div([text("42 requests/s", attrs: [])], attrs: [#("class", "metrics")]);
}

#[@result]
fn panelWithHandler() -> @Result<Element, string> {
    return button([text("Retry now", attrs: [])], attrs: [
        #("data-jh-on-click", "Metrics:retry"),
    ]);
}

fn boundaryOver(child: fn() -> @Result<Element, string>) -> ErrorBoundary {
    return catchError("dashboard.metrics", { info ->
        ErrorPage(info);
    }, child);
}

test "a failing panel renders the fallback and leaks nothing" {
    val markup = renderToString(renderBoundary(boundaryOver(failingPanel)));
    assert markup.contains("The metrics are unavailable");
    assert markup.contains("connection refused") == false;
    assert markup.contains("metrics-01") == false;
}

test "a healthy panel renders inside the boundary wrapper" {
    val markup = renderToString(renderBoundary(boundaryOver(healthyPanel)));
    assert markup.contains("data-jh-error-boundary=\"dashboard.metrics\"");
    assert markup.contains("42 requests/s");
    assert markup.contains("The metrics are unavailable") == false;
}

test "the digest the reader sees is the one the server logged" {
    val shown = infoFor("connection refused: metrics-01:5432");
    val logged = serverInfoFor("connection refused: metrics-01:5432");
    assert shown.message == "";
    assert shown.digest == logged.digest;
    assert logged.message.contains("metrics-01");
}

test "an event handler is outside the boundary's catch channel" {
    val markup = renderToString(renderBoundary(boundaryOver(panelWithHandler)));
    assert markup.contains("data-jh-on-click=\"Metrics:retry\"");
    assert markup.contains("The metrics are unavailable") == false;
}

test "the boundary anchors itself so a transition failure can find it" {
    val markup = renderToString(renderBoundary(boundaryOver(healthyPanel)));
    assert markup.contains("data-jh-error-boundary=\"dashboard.metrics\"");
}
