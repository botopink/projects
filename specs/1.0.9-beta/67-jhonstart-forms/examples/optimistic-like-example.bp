// Front 67 — jhonstart-forms · examples/optimistic-like-example.bp
//
// A like button that shows the new count before the server has agreed to it,
// and a nested submit button that disables itself without the parent threading
// a `pending` flag down to it.
//
// This is the BROWSER half. `likePost` is front 24's action, on BEAM. During the
// server pass the optimistic value is the base value and the status is idle, so
// the first HTML is the truth as the server knows it — an optimistic count in
// server HTML is a lie the server told.
//
// Upstream:
//   https://react.dev/reference/react/useOptimistic
//   https://react.dev/reference/react-dom/hooks/useFormStatus
//   https://nextjs.org/docs/app/getting-started/updating-data
//
// Both hooks are specified from upstream React: neither appears in
// NEXTJS-DOCS.md. See the README's `Reference gaps`.

import { Element, text, span, div, renderToString } from "jhonstart";
// Landed by the track-C constructor set (fronts 26-32), not by this front.
import { form, button } from "jhonstart";
import { FormBinding, formAction, formAttrs } from "jhonstart";
import { FormStatus, useFormStatus, useOptimistic, applyOptimistic } from "jhonstart";

// How one prediction folds into the count. Pure, and the only place the
// prediction rule lives — the host cell supplies the action list, nothing else.
fn addLike(current: i32, action: i32) -> i32 {
    return current + action;
}

// The submit button, which reads its own form's status rather than a prop.
fn LikeButton() -> Element {
    val status = use useFormStatus();
    return likeButton(status);
}

// One `append` site rather than two array literals in two branches: three or
// more branchy array-literal sites mis-unify the element type.
fn buttonAttrs(pending: bool) -> Array<#(string, string)> {
    val base = [#("type", "submit")];
    if (pending == false) return base;
    return base.append([#("disabled", "disabled")]);
}

fn likeButton(status: FormStatus) -> Element {
    val caption = if (status.pending) { "…" } else { "Like" };
    return button([text(caption, attrs: [])], attrs: buttonAttrs(status.pending));
}

// The widget, written against an explicit count and status so the tests below
// can drive both without a browser.
fn likeWidget(binding: FormBinding, shown: i32, status: FormStatus) -> Element {
    return form([
        span([text(shown.toString() + " likes", attrs: [])], attrs: [#("class", "like-count")]),
        likeButton(status),
    ], attrs: formAttrs(binding));
}

// The component. `push(1)` is called by the submit interceptor, not from here:
// the prediction is recorded against the submit that is starting.
fn LikeWidget(serverCount: i32) -> Element {
    // LANGUAGE GAP: no array/tuple destructuring in a binding — upstream reads
    // `const [shown, push] = useOptimistic(...)`; positional below.
    val o = use useOptimistic(serverCount, addLike);
    val shown = o.0;
    val status = use useFormStatus();
    return likeWidget(formAction("likePost"), shown, status);
}

// ── tests ────────────────────────────────────────────────────────────────────

test "no prediction is the identity — the server pass shows the server's count" {
    assert applyOptimistic(12, [], addLike) == 12;
    val markup = renderToString(likeWidget(formAction("likePost"), 12, FormStatus(pending: false, actionId: "", method: "post")));
    assert markup.contains(">12 likes<");
    assert markup.contains("disabled") == false;
}

test "predictions fold in order and are visible before the server answers" {
    assert applyOptimistic(12, [1], addLike) == 13;
    assert applyOptimistic(12, [1, 1, 1], addLike) == 15;
}

test "a commit and a roll-back end in the same place: the server's new base" {
    val committed = applyOptimistic(13, [], addLike);
    val rolledBack = applyOptimistic(12, [], addLike);
    assert committed == 13;
    assert rolledBack == 12;
}

test "the nested button reads its own form's status" {
    val busy = FormStatus(pending: true, actionId: "likePost", method: "post");
    val markup = renderToString(likeButton(busy));
    assert markup.contains("disabled=\"disabled\"");
    assert markup.contains(">…<");
}

test "outside any form the status is idle, never an error" {
    val idle = FormStatus(pending: false, actionId: "", method: "post");
    assert idle.pending == false;
    assert idle.actionId == "";
}
