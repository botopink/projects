// Front 53 — onze13 example app · examples/lib-db-example.bp
// App file: lib/db.bp
//
// Demonstrates: the store. Posts are text files under `content/posts/<slug>.md`
// — line 1 is the title, line 2 the publication date, the rest is the body.
// There is no database on purpose: front 08 (rakun-data-sql) is not on this
// milestone's critical path, and a file is a mutation target with exactly the
// same cache-invalidation problem a row has.
//
// Upstream: https://nextjs.org/docs/app/getting-started/fetching-data
//           NEXTJS-DOCS.md § 9. Busca de Dados (Fetching) · § 11. Cache
//
// Target: erlang (server). This module must never reach the client graph —
// front 68 fails the build if it does, which is one of front 53's assertions.

import {fs, path} from "std";
// front 12 — the cache store, its tags and its named lifetimes
import {cacheTag, cacheLife, cached} from "rakun-cache";

pub type Post(
    slug: string,
    title: string,
    published: string,
    excerpt: string,
    body: string,
)

fn contentDir() -> string {
    return path.join(["content", "posts"]);
}

fn readRaw(p: string) -> string {
    return fs.readText(p).unwrapOr("");
}

fn slugOf(fileName: string) -> string {
    val n = fileName.length();
    return fileName.slice(0, n - 3);
}

// LANGUAGE GAP is NOT needed here: `.at(i)` and `.drop(n)` are used instead of
// `xs[0]` / `xs[1]` deliberately, because the index is silently dropped on the
// beam backend and this module is a server module.
fn parsePost(slug: string, raw: string) -> Post {
    val lines = raw.split("\n");
    val title = lines.at(0).unwrapOr("(untitled)");
    val published = lines.at(1).unwrapOr("");
    val body = lines.drop(2).join("\n");
    val excerpt = body.slice(0, 140);
    return Post(
        slug: slug,
        title: title,
        published: published,
        excerpt: excerpt,
        body: body,
    );
}

pub fn listPosts() -> Post[] {
    val names = fs.list(contentDir()).unwrapOr([]);
    val mds = names.filter({ n -> n.endsWith(".md") });
    val posts = mds.map({ n -> parsePost(slugOf(n), readRaw(path.join([contentDir(), n]))) });
    return posts;
}

#[@result]
pub fn readPost(slug: string) -> @Result<Post, string> {
    val p = path.join([contentDir(), slug + ".md"]);
    val missing = fs.exists(p).negate();
    if (missing) {
        throw "no post named " + slug;
    };
    return parsePost(slug, readRaw(p));
}

#[@result]
pub fn writePost(
    slug: string,
    title: string,
    published: string,
    body: string,
) -> @Result<i32, string> {
    val p = path.join([contentDir(), slug + ".md"]);
    val raw = title + "\n" + published + "\n" + body;
    val wrote = fs.writeText(p, raw);
    if (wrote.isError()) {
        throw "could not write " + p;
    };
    return 1;
}

// The one async entry point. Everything above is synchronous and effect-free,
// which is what makes it testable without a server; the cache is what makes the
// read path a `@Future` and gives `lib/actions.bp` something to invalidate.
//
// front 12 — cacheTag names what revalidateTag("posts") will expire;
//            cacheLife names the staleness profile.
#[@future]
pub fn loadPosts() -> @Future<Post[]> {
    cacheTag("posts");
    cacheLife("hours");
    return await cached("posts:all", { -> listPosts() });
}

pub fn findPost(slug: string) -> Post[] {
    return listPosts().filter({ p -> p.slug == slug });
}

// Returns zero or one post rather than `@Future<@Result<Post, string>>`: two
// effect wrappers on one value is a shape the language does not compose, and a
// zero-or-one list is the honest alternative. The caller tests `isEmpty()` and
// calls front 63's `notFound()`.
#[@future]
pub fn loadPost(slug: string) -> @Future<Post[]> {
    cacheTag("post:" + slug);
    cacheLife("hours");
    return await cached("post:" + slug, { -> findPost(slug) });
}

// A value the caller can name after `notFound()` has already diverged. It
// exists only because the language has no bottom type — see the LANGUAGE GAP in
// blog-slug-page-example.bp.
pub fn missingPost(slug: string) -> Post {
    return Post(slug: slug, title: "", published: "", excerpt: "", body: "");
}

test "a post file parses into title, date and body" {
    val raw = "Hello World\n2026-01-04\nFirst line.\nSecond line.";
    val p = parsePost("hello-world", raw);
    assert p.slug == "hello-world";
    assert p.title == "Hello World";
    assert p.published == "2026-01-04";
    assert p.body == "First line.\nSecond line.";
    assert p.excerpt.startsWith("First line.");
}

test "a truncated file still parses, with named placeholders" {
    val p = parsePost("empty", "");
    assert p.title == "(untitled)";
    assert p.published == "";
    assert p.body == "";
}

test "a slug is the file name without its extension" {
    assert slugOf("hello-world.md") == "hello-world";
}

test "reading a missing slug reds with the slug in the message" {
    val r = readPost("definitely-not-a-post");
    assert r.isError();
}
