// Front 53 — onze13 example app · examples/tags-example.bp
// App file: components/tags.bp
//
// Demonstrates: the element constructors this app needs and jhonstart does not
// have. `repository/jhonstart/src/element.bp` is FROZEN for this milestone and
// provides exactly `text, fragment, div, span, p, h1, ul, li`. Every other tag
// the blog uses is built here, on the public `Element(tag, value, children,
// attrs)` record — which is legal today and is what every onze13 app would have
// to copy. This is a library gap, not a language gap: see the README's
// *Findings* section.
//
// Upstream: https://nextjs.org/docs/app/getting-started/layouts-and-pages
//           NEXTJS-DOCS.md § 3. Estrutura do Projeto
//
// Target: erlang (server) — these produce markup during the server render. The
// same module is also reachable from the client graph, which is why it holds no
// data access and no effects.

import {Element, text, renderToString} from "jhonstart";

// The one primitive. Everything below is a name for a string.
pub fn tag(name: string, children: Element[], attrs: Array<#(string, string)>) -> Element {
    return Element(tag: name, value: "", children: children, attrs: attrs);
}

pub fn nav(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("nav", children, attrs);
}

pub fn header(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("header", children, attrs);
}

pub fn main(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("main", children, attrs);
}

pub fn article(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("article", children, attrs);
}

pub fn section(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("section", children, attrs);
}

pub fn h2(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("h2", children, attrs);
}

pub fn anchor(href: string, children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("a", children, attrs.append([#("href", href)]));
}

pub fn form(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("form", children, attrs);
}

pub fn label(forName: string, children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("label", children, attrs.append([#("for", forName)]));
}

// NOTE: `renderToString` (element.bp:55-67) has no void-element table, so this
// renders as `<input …></input>`. Browsers accept it; validators do not. The
// fix lives in the frozen file — see the README's *Findings*.
pub fn input(attrs: Array<#(string, string)>) -> Element {
    return tag("input", [], attrs);
}

pub fn button(children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("button", children, attrs);
}

pub fn timeTag(dateTime: string, children: Element[], attrs: Array<#(string, string)>) -> Element {
    return tag("time", children, attrs.append([#("datetime", dateTime)]));
}

// Call sites always write `attrs:` — not because these helpers have defaults
// (they have none; declared defaults are never applied) but so that app code
// reads the same whether the constructor came from jhonstart or from here.
test "a built tag renders like a jhonstart builder's" {
    val el = nav([], attrs: []);
    assert renderToString(el) == "<nav></nav>";
}

test "href and for are appended after the caller's own attributes" {
    val a = anchor("/blog", [text("Blog", attrs: [])], attrs: [#("class", "x")]);
    assert renderToString(a) == "<a class=\"x\" href=\"/blog\">Blog</a>";
}

test "an input is a void element the frozen renderer cannot spell" {
    val i = input(attrs: [#("name", "title"), #("type", "text")]);
    assert renderToString(i) == "<input name=\"title\" type=\"text\"></input>";
}
