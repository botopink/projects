// Front 53 — onze13 example app · examples/app-layout-example.bp
// App file: app/layout.bp
//
// Demonstrates: the root layout. It returns the BODY subtree and a head string;
// the document shell is onze13's `renderDocument` (front 49) and the moment the
// head is written is front 69's. That split is what makes emilia's sheet land
// in the head with content in it: `flush()` must run after the tree is built.
//
// Upstream: https://nextjs.org/docs/app/api-reference/file-conventions/layout
//           https://nextjs.org/docs/app/getting-started/layouts-and-pages
//           NEXTJS-DOCS.md § 5. Layouts e Páginas · § 15. Estilização (CSS)
//
// Target: erlang (server). The nav it renders contains `Link` elements whose
// click behaviour is the JS half (front 27 + front 68); the markup is not.

import {Element, div, text, renderToString} from "jhonstart";
import {emilia, flush, Token} from "emilia";
import {Params, LayoutProps, defaultConfig, renderDocument} from "onze13";
// front 52 — self-hosted fonts with a metric-adjusted fallback
import {Font, GoogleFontOptions, googleFont, fontHead} from "onze13";
// app-local
import {header, main} from "@/components.tags";
import {SiteNav} from "@/components.nav";

// front 52 — one family, two weights, latin, swap, adjusted fallback on.
#[@future]
fn bodyFont() -> @Future<Font> {
    val opts = GoogleFontOptions(
        weights: ["400", "700"],
        styles: ["normal"],
        subsets: ["latin"],
        display: "swap",
        preload: true,
        variable: "",
        fallback: ["system-ui", "sans-serif"],
        adjustFontFallback: true,
    );
    return await googleFont("Inter", opts);
}

// front 23 — the root layout. Front 50's scan sees `@Future<Element>` and emits
// `registerAsyncLayout("/", …)`.
#[@future]
pub fn RootLayout(props: LayoutProps) -> @Future<Element> {
    val font = await bodyFont();
    val pageTokens: Token[] = [.Bg.White, .Color.Gray.900, .Pad.All.4];
    val pageClass = emilia(pageTokens);
    return div([
        header([SiteNav(props.params)], attrs: []),
        main([props.children], attrs: []),
    ], attrs: [#("class", pageClass + " " + font.className)]);
}

// front 69 — the head seam. Preload links first, then the font faces, then the
// sheet emilia collected while the tree above was being built. Calling
// `flush()` before the tree exists yields `<style></style>`, which is the bug
// this ordering is written down to prevent.
#[@future]
pub fn renderPage(props: LayoutProps) -> @Future<string> {
    val tree = await RootLayout(props);
    val font = await bodyFont();
    val fonts = fontHead([font]);
    val styles = await flush();
    return await renderDocument(defaultConfig(), fonts + styles, tree);
}

test "the layout wraps the page in a header and a main" {
    val leaf = text("body", attrs: []);
    val props = LayoutProps(children: leaf, params: Params(entries: []));
    val markup = renderToString(await RootLayout(props));
    assert markup.contains("<header>");
    assert markup.contains("<main>");
    assert markup.contains("body");
}

test "the document has one non-empty style block, and the fonts precede it" {
    val leaf = text("body", attrs: []);
    val props = LayoutProps(children: leaf, params: Params(entries: []));
    val doc = await renderPage(props);
    assert doc.startsWith("<!DOCTYPE html>");
    assert doc.contains("<style></style>").negate();
    val fontAt = doc.indexOf("@font-face");
    val styleAt = doc.indexOf("<style>");
    assert fontAt >= 0;
    assert styleAt > fontAt;
}

test "a second render still has styles — the sheet is per render, not per process" {
    val leaf = text("body", attrs: []);
    val props = LayoutProps(children: leaf, params: Params(entries: []));
    val first = await renderPage(props);
    val second = await renderPage(props);
    assert first.contains("<style></style>").negate();
    assert second.contains("<style></style>").negate();
}
