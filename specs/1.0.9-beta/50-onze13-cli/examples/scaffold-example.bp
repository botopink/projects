// Front 50 — onze13 CLI · examples/scaffold-example.bp
//
// Demonstrates: what `onze13 create my-app --yes` writes. This is the whole of
// a new app's source — a root layout and one page — and it is the first thing
// `onze13 dev` serves. Both modules are shown here; in the scaffold they are
// `app/layout.bp` and `app/page.bp`.
//
// Upstream: https://nextjs.org/docs/app/api-reference/cli/create-next-app
//           https://nextjs.org/docs/app/getting-started/layouts-and-pages
//           NEXTJS-DOCS.md § 29. CLI · § 2. Instalação e Configuração
//
// Target: erlang (server) — the scaffold renders on BEAM. The CLI process that
// wrote these files is the js half; nothing in the files themselves is.

import {Element, div, h1, p, text, renderToString} from "jhonstart";
import {emilia, Token} from "emilia";
import {Params, PageProps, LayoutProps} from "onze13";

// ── app/layout.bp ────────────────────────────────────────────────────────────
//
// The root layout returns the BODY subtree, not a whole document. The
// `<!DOCTYPE html><html><head>…` shell belongs to onze13's `renderDocument`
// (front 49), because the head has to be written after the tree is built —
// that is when emilia's classes exist to flush.
pub fn RootLayout(props: LayoutProps) -> Element {
    val shellTokens: Token[] = [.Font.Sans, .Bg.White, .Color.Gray.900];
    val shellClass = emilia(shellTokens);
    return div([props.children], attrs: [#("class", shellClass)]);
}

// ── app/page.bp ──────────────────────────────────────────────────────────────
//
// A synchronous page: no data loading, so no `#[@future]`. `onze13 build`
// reads the declared return type and emits `registerPage`, not
// `registerAsyncPage`.
pub fn HomePage(props: PageProps) -> Element {
    val titleTokens: Token[] = [.Text.Size.X3xl, .Text.Bold];
    val leadTokens: Token[] = [.Pad.Y.4, .Color.Gray.700];
    val titleClass = emilia(titleTokens);
    val leadClass = emilia(leadTokens);
    return div([
        h1([text("onze13", attrs: [])], attrs: [#("class", titleClass)]),
        p([text("Edit app/page.bp and reload.", attrs: [])], attrs: [#("class", leadClass)]),
    ], attrs: []);
}

test "the scaffold renders without any data, which is why create can verify it" {
    val props = PageProps(params: Params(entries: []), search: Params(entries: []));
    val page = HomePage(props);
    val body = RootLayout(LayoutProps(children: page, params: props.params));
    val markup = renderToString(body);
    assert markup.startsWith("<div class=\"e_");
    assert markup.contains("<h1");
    assert markup.contains("Edit app/page.bp and reload.");
}
