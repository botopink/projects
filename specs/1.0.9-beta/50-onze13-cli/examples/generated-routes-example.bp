// Front 50 — onze13 CLI · examples/generated-routes-example.bp
//
// Demonstrates: the file `onze13 build` writes to `<outDir>/routes.bp`. This is
// the seam described in front 49 — the only place the `app/` directory tree
// becomes something front 22's route table can see. A developer does not write
// this file; they read it when a route does not resolve, which is why the
// generator emits it as source rather than as an opaque table.
//
// The app it was generated from:
//
//   app/layout.bp                  → staged app/layout.bp
//   app/page.bp                    → staged app/page.bp
//   app/blog/page.bp               → staged app/blog/page.bp
//   app/blog/loading.bp            → staged app/blog/loading.bp
//   app/blog/[slug]/page.bp        → staged app/blog/d_slug/page.bp
//   app/blog/[slug]/not-found.bp   → staged app/blog/d_slug/not_found.bp
//   app/(marketing)/about/page.bp  → staged app/g_marketing/about/page.bp
//   app/api/posts/route.bp         → staged app/api/posts/route.bp
//
// Upstream: https://nextjs.org/docs/app/getting-started/project-structure
//           NEXTJS-DOCS.md § 3. Estrutura do Projeto · § 29. CLI
//
// Target: both — the module compiles for erlang (the server registers and
// serves these routes) and the same pattern strings are read by the client
// route table front 68 ships for prefetching.

// GENERATED by onze13 build — do not edit.

import {
    registerPage,
    registerAsyncPage,
    registerLayout,
    registerLoading,
    registerNotFound,
    registerHandler,
} from "onze13";

import {RootLayout} from "app.layout";
import {HomePage} from "app.page";
import {BlogPage} from "app.blog.page";
import {BlogLoading} from "app.blog.loading";
import {BlogPost} from "app.blog.d_slug.page";
import {PostNotFound} from "app.blog.d_slug.not_found";
import {AboutPage} from "app.g_marketing.about.page";
import {GET} from "app.api.posts.route";

// Every registration is a lambda, never a bare fn name, and every call binds
// its result — the registry returns its new size, so the sequence reads as
// statements and the last binding is the route count.
pub fn routes() -> i32 {
    // app/layout.bp — front 23 folds this over every route below it.
    val r0 = registerLayout("/", { p -> RootLayout(p) });

    // app/page.bp — synchronous, so registerPage (front 22, front 23).
    val r1 = registerPage("/", { p -> HomePage(p) });

    // app/blog/page.bp — declared `#[@future] … -> @Future<Element>`, so the
    // async entry point (front 28 server component).
    val r2 = registerAsyncPage("/blog", { p -> BlogPage(p) });

    // app/blog/loading.bp — front 30's streaming fallback for the segment.
    val r3 = registerLoading("/blog", { -> BlogLoading() });

    // app/blog/[slug]/page.bp — the dynamic segment (front 22).
    val r4 = registerAsyncPage("/blog/:slug", { p -> BlogPost(p) });

    // app/blog/[slug]/not-found.bp — front 31's boundary, reached by front 63's
    // notFound() signal.
    val r5 = registerNotFound("/blog/:slug", { -> PostNotFound() });

    // app/(marketing)/about/page.bp — the group contributes no URL segment.
    val r6 = registerPage("/about", { p -> AboutPage(p) });

    // app/api/posts/route.bp — front 25's route handler, one registration per
    // exported method.
    val r7 = registerHandler("/api/posts", "GET", { c -> GET(c) });

    return r7;
}

test "the generated module is deterministic and its last binding is the count" {
    val n = routes();
    assert n == 8;
}
