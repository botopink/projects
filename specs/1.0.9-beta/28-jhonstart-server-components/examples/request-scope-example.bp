// Front 28 — jhonstart-server-components · examples/request-scope-example.bp
//
// A greeting bar that reads the reader's locale from a cookie and their client
// from a header.
//
// Request scope is per-request state on the BEAM: front 62 puts it in the
// process dictionary before dispatch, and `request()` reads it back. It is a
// plain function, not a hook — see the front README's *Language gaps* for why
// `use request()` cannot be written today.
//
// Nothing read here may cross to the client. The `authorization` header is the
// case that matters: it is used to decide what to render and is never handed to
// a client component as a prop. Front 68 enforces that at build time.
//
// Upstream:
//   https://nextjs.org/docs/app/api-reference/functions/cookies
//   https://nextjs.org/docs/app/api-reference/functions/headers

import { Element, div, span, p, text, renderToString } from "jhonstart";
import { RequestData, request, pairValue } from "jhonstart";
import { header } from "jhonstart";

// `header` (the HTML element) is not among the eight builders `element.bp`
// ships — it comes from the element-surface front of track C (number allocated
// from 54 up). `RequestData`, `request` and `pairValue` are front 28's; the
// underlying request context is front 62's.

fn greetingFor(locale: string) -> string {
    return case locale {
        "pt-BR" -> "Bem-vindo";
        "es" -> "Bienvenido";
        _ -> "Welcome";
    };
}

// A pure view over the request. Taking `RequestData` as a parameter rather than
// calling `request()` inside keeps the component testable with no host at all.
pub fn greetingBar(req: RequestData) -> Element {
    val locale = req.cookie("locale");
    val signedIn = req.header("authorization") != "";
    val label = if (signedIn) { greetingFor(locale) + " back" } else { greetingFor(locale) };
    return header([
        span([text(label, attrs: [])], attrs: [#("class", "greeting")]),
        span([text(req.path, attrs: [])], attrs: [#("class", "crumb")]),
    ], attrs: [#("class", "bar")]);
}

// The server component. One call to `request()`, then pure rendering.
pub fn GreetingBar() -> Element {
    return greetingBar(request());
}

// A second server component, showing that the request is read once per render
// and passed down rather than re-read in every child.
pub fn Page() -> Element {
    val req = request();
    return div([
        greetingBar(req),
        p([text("Reading " + req.path, attrs: [])], attrs: []),
    ], attrs: [#("class", "page")]);
}

fn fixture(locale: string, auth: string) -> RequestData {
    return RequestData(
        method: "GET",
        path: "/dashboard",
        params: [],
        query: [],
        headers: [#("authorization", auth)],
        cookies: [#("locale", locale)],
    );
}

test "the greeting follows the locale cookie" {
    val markup = renderToString(greetingBar(fixture("pt-BR", "")));
    assert markup.contains("Bem-vindo");
    assert markup.contains("/dashboard");
}

test "a signed-in reader gets the returning greeting" {
    val markup = renderToString(greetingBar(fixture("es", "Bearer abc")));
    assert markup.contains("Bienvenido back");
}

test "an unknown locale falls back to English" {
    assert greetingFor("") == "Welcome";
    assert greetingFor("fr") == "Welcome";
}

test "an absent cookie reads as the empty string, not a failure" {
    val req = RequestData(
        method: "GET",
        path: "/",
        params: [],
        query: [],
        headers: [],
        cookies: [],
    );
    assert req.cookie("locale") == "";
    assert req.header("authorization") == "";
    assert pairValue([], "anything") == "";
}
