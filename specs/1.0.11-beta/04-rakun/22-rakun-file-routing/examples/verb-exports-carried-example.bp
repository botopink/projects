// NOTE: the GET list, the POST create and the dynamic-segment GET have
// counterparts in route-handler-example.bp; the DELETE handler does not.
//
// LANGUAGE GAP: nothing reflects a module's export names and `@Decl` carries no
// source location, so `pub fn GET` in a `route.bp` cannot register itself — 25
// spells the verb as `#[getRoute("api/posts")]` / `#[deleteRoute("api/posts/[id]")]`.
// NOTE: `Response.json(json.stringify(posts))` — `std/json.stringify` is
// `string -> @Result<string, string>`; 25 spells the response `HandlerResponse.json(body)`.
// NOTE: `await request.json()` is `bodyJson(req)` in 25; `Response(status: 204, body: "")`
// is `HandlerResponse.noContent()`.

// --- GET handler (app/api/posts/route.bp)
import {Request, Response} from "rakun";
import {json} from "std";

pub fn GET(request: Request) -> @Task<Response> {
    val posts = await db.post.findAll();
    return Response.json(json.stringify(posts));
}

// --- POST handler (app/api/posts/route.bp)
import {Request, Response} from "rakun";
import {json} from "std";

pub fn POST(request: Request) -> @Task<Response> {
    val body = await request.json();
    val post = await db.post.create(body);
    return Response(status: 201, body: json.stringify(post));
}

// --- Dynamic route handler (app/api/posts/[id]/route.bp)
import {Request, Response} from "rakun";
import {json} from "std";

pub fn GET(request: Request) -> @Task<Response> {
    val id = request.param("id");
    val post = await db.post.findById(id);
    if (post == null) {
        return Response.notFound();
    };
    return Response.json(json.stringify(post));
}

pub fn DELETE(request: Request) -> @Task<Response> {
    val id = request.param("id");
    await db.post.delete(id);
    return Response(status: 204, body: "");
}
